<Page x:Class="TelegramVisualPart.Pages.Advanced.AdvancedPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TelegramVisualPart.Pages.Advanced"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"   
      xmlns:buts="clr-namespace:TelegramVisualPart.UserControls.SettingsControls.AdvancedControls.AdvancedButtons"
      xmlns:differButs="clr-namespace:TelegramVisualPart.UserControls.DifferButs"
      mc:Ignorable="d" 
      d:DesignHeight="750" d:DesignWidth="400"
      Height="750" Width="400"
      Title="AdvancedPage">

    <Border Name="BgBorder" CornerRadius="15"
            Background="{StaticResource DarkThemeOne}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>

                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Name="UpperThing">
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ArrowLeft" Margin="10 0 0 0" 
                                         Width="35" Height="35"
                                         VerticalAlignment="Center" HorizontalAlignment="Left"
                                         Foreground="Gray"
                                         Name="GetBackBut"
                                         MouseEnter="Buts_MouseEnter"
                                         MouseLeave="Buts_MouseLeave"
                                         PreviewMouseDown="GetBackBut_PreviewMouseDown"/>

                    <TextBlock Text="Advanced" VerticalAlignment="Center" Foreground="White"
                           Margin="10 0 0 0" FontSize="20"/>
                </StackPanel>

                <Grid Grid.Column="1">
                    <materialDesign:PackIcon Kind="Close" Margin="0 0 15 0" 
                                         Width="35" Height="35"
                                         VerticalAlignment="Center" 
                                         HorizontalAlignment="Right"
                                         Foreground="Gray"
                                         Name="CloseBut"
                                         MouseEnter="Buts_MouseEnter"
                                         MouseLeave="Buts_MouseLeave"
                                         PreviewMouseDown="CloseBut_PreviewMouseDown"/>
                </Grid>
            </Grid>

            <ScrollViewer Grid.Row="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="150"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="90"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="135"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="155"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Name="DataAndStroage">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>


                        <TextBlock Text="Data and storage" VerticalAlignment="Center" Margin="20 0 0 0"
                           Name="DataStorageText"
                           FontSize="16" Foreground="{StaticResource DarkThemeProfileButForeGround}"/>

                        <StackPanel Name="DataStorageStack" Grid.Row="1">
                            <buts:DoubleTextIconBut x:Name="DownloadPathBut" Margin="0 5 0 0"/>
                            <buts:IconTextButAdvanced x:Name="Downloads" Margin="0 5 0 0"/>
                            <buts:ToggleButAdvanced x:Name="IsAskDownloadPath" Margin="0 5 0 0"/>
                        </StackPanel>

                    </Grid>

                    <Grid Grid.Row="1" Background="{StaticResource DarkThemeDeviderField}"/>

                    <Grid Grid.Row="2" Name="MediaDownloadGrid" Margin="0 5 0 0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Automatic media download" VerticalAlignment="Center" Margin="20 0 0 0"
                           Name="MediaDownloadText"
                           FontSize="16" Foreground="{StaticResource DarkThemeProfileButForeGround}"/>

                        <StackPanel Grid.Row="1" Orientation="Vertical">
                            <buts:IconTextButAdvanced x:Name="PrivateChatsBut" Margin="0 5 0 0"/>

                        </StackPanel>

                    </Grid>

                    <Grid Grid.Row="3" Background="{StaticResource DarkThemeDeviderField}"/>

                    <Grid Grid.Row="4" Name="TitleBarGrid" Margin="0 5 0 0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Window title bar" VerticalAlignment="Center" Margin="20 0 0 0"
                           Name="TitleBarText"
                           FontSize="16" Foreground="{StaticResource DarkThemeProfileButForeGround}"/>

                        <StackPanel Grid.Row="1" Margin="20 0 0 0" Orientation="Vertical">
                            <CheckBox   Style="{StaticResource MaterialDesignCheckBox}" Foreground="White"  
                                        Content="Show chat name" Name="ShowChatNameBox" Margin="0 5 0 0"
                                        Background="{StaticResource DarkThemeProfileButForeGround}"
                                        IsChecked="False" FontSize="14"                                
                                        materialDesign:CheckBoxAssist.CheckBoxSize="22"     
                                        Checked="CheckBox_Checked" Unchecked="CheckBox_Unchecked"/>

                            <CheckBox   Style="{StaticResource MaterialDesignCheckBox}" Foreground="White"  
                                        Content="Total unread count" Name="UnreadCountBox" Margin="0 5 0 0"
                                        Background="{StaticResource DarkThemeProfileButForeGround}"
                                        IsChecked="False" FontSize="14"                                
                                        materialDesign:CheckBoxAssist.CheckBoxSize="22"     
                                        Checked="CheckBox_Checked" Unchecked="CheckBox_Unchecked"/>

                            <CheckBox   Style="{StaticResource MaterialDesignCheckBox}" Foreground="White"  
                                       Content="Use system window frame" Name="WindowFrame" Margin="0 5 0 0"
                                       Background="{StaticResource DarkThemeProfileButForeGround}"
                                       IsChecked="False" FontSize="14"                                
                                       materialDesign:CheckBoxAssist.CheckBoxSize="22"     
                                       Checked="CheckBox_Checked" Unchecked="CheckBox_Unchecked"/>


                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="5" Background="{StaticResource DarkThemeDeviderField}"/>

                    <Grid Grid.Row="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Window title bar" VerticalAlignment="Center" Margin="20 0 0 0"
                                       Name="SysIntegration"
                                       FontSize="16" Foreground="{StaticResource DarkThemeProfileButForeGround}"/>

                            <StackPanel Grid.Row="1" Margin="20 0 0 0">
                                <CheckBox  Style="{StaticResource MaterialDesignCheckBox}" Foreground="White"  
                                           Content="Show tray icon" Name="TrayIconBox" Margin="0 5 0 0"
                                           Background="{StaticResource DarkThemeProfileButForeGround}"
                                           IsChecked="False" FontSize="14"                           
                                           materialDesign:CheckBoxAssist.CheckBoxSize="22"     
                                           Checked="CheckBox_Checked" Unchecked="CheckBox_Unchecked"/>

                                <CheckBox  Style="{StaticResource MaterialDesignCheckBox}" Foreground="White"  
                                           Content="Show taskbrar icon" Name="TaskBarBox" Margin="0 5 0 0"
                                           Background="{StaticResource DarkThemeProfileButForeGround}"
                                           IsChecked="False" FontSize="14"                                
                                           materialDesign:CheckBoxAssist.CheckBoxSize="22"     
                                           Checked="CheckBox_Checked" Unchecked="CheckBox_Unchecked"/>

                                <CheckBox  Style="{StaticResource MaterialDesignCheckBox}" Foreground="White"  
                                           Content="CLose to taskbrar" Name="CloseToTaskBarBox" Margin="0 5 0 0"
                                           Background="{StaticResource DarkThemeProfileButForeGround}"
                                           IsChecked="False" FontSize="14"                                
                                           materialDesign:CheckBoxAssist.CheckBoxSize="22"     
                                           Checked="CheckBox_Checked" Unchecked="CheckBox_Unchecked"/>

                                <CheckBox  Style="{StaticResource MaterialDesignCheckBox}" Foreground="White"  
                                           Content="Launch Telegram when system starts" Name="AtStartLaunchTelegramBox" Margin="0 5 0 0"
                                           Background="{StaticResource DarkThemeProfileButForeGround}"
                                           IsChecked="False" FontSize="14"                                
                                           materialDesign:CheckBoxAssist.CheckBoxSize="22"     
                                           Checked="CheckBox_Checked" Unchecked="CheckBox_Unchecked"/>

                                <CheckBox  Style="{StaticResource MaterialDesignCheckBox}" Foreground="White"  
                                           Content="Palce Telegram in Send To menu" Name="PalceInSendTo" Margin="0 5 0 0"
                                           Background="{StaticResource DarkThemeProfileButForeGround}"
                                           IsChecked="False" FontSize="14"                                
                                           materialDesign:CheckBoxAssist.CheckBoxSize="22"     
                                           Checked="CheckBox_Checked" Unchecked="CheckBox_Unchecked"/>

                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="7" Background="{StaticResource DarkThemeDeviderField}"/>

                    <Grid Grid.Row="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Versions and updates" VerticalAlignment="Center" Margin="20 0 0 0"
                           Name="VersionsText"
                           FontSize="16" Foreground="{StaticResource DarkThemeProfileButForeGround}"/>

                        <StackPanel Grid.Row="1">
                            <buts:TwoTextsToggle x:Name="VersionBut"/>
                            <buts:ToggleButAdvanced x:Name="InstalBetaBut"/>
                            <buts:TextBut x:Name="CheckForUpdates"/>
                        </StackPanel>
                             
                    </Grid>
                    
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</Page>
