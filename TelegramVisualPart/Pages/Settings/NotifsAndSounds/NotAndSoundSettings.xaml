<Page x:Class="TelegramVisualPart.Pages.Settings.NotifsAndSounds.NotAndSoundSettings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TelegramVisualPart.Pages.Settings.NotifsAndSounds"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:butToggleIcon ="clr-namespace:TelegramVisualPart.UserControls"
      xmlns:iconBut="clr-namespace:TelegramVisualPart.UserControls.DifferButs"   
      xmlns:MonitorMessage="clr-namespace:TelegramVisualPart.UserControls.SettingsControls.NotificationPrivacy"
      mc:Ignorable="d" 
      d:DesignHeight="875" d:DesignWidth="475"
      Height="875" Width="475"
      MaxHeight="875"
      Title="NotAndSoundSettings"
      HorizontalAlignment="Center" 
      >

    <Page.Resources>
        <Style x:Key="Tabs" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="TextAlignment" Value="Center"/>

            <EventSetter Event="MouseEnter" Handler="TextBlock_MouseEnter"/>
            <EventSetter Event="MouseLeave" Handler="TextBlock_MouseLeave"/>
            <EventSetter Event="PreviewMouseDown" Handler="TextBlock_PreviewMouseDown"/>
        </Style>

        <Style x:Key="BotBorder" TargetType="Border">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Background" Value="Gray"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Margin" Value="0.5 0 0.5 0"/>

            <EventSetter Event="MouseEnter" Handler="TextBlock_MouseEnter"/>
            <EventSetter Event="MouseLeave" Handler="TextBlock_MouseLeave"/>
            <EventSetter Event="PreviewMouseDown" Handler="Border_PreviewMouseDown"/>

        </Style>

    </Page.Resources>

    <Border CornerRadius="15" 
            Background="{StaticResource DarkThemeOne}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="75"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>


                <iconBut:IconButton x:Name="BackBut" Width="25" Height="25" Margin="0"
                                    PreviewMouseDown="BackBut_PreviewMouseDown"
                                    VerticalAlignment="Center" 
                                    HorizontalAlignment="Center"/>

                <TextBlock Grid.Column="1" Text="Notifications and Sounds"
                       VerticalAlignment="Center" HorizontalAlignment="Left"
                       Foreground="{StaticResource UsualTextColor}" FontSize="21" Margin="5 0 0 0"
                           FontWeight="Normal" FontFamily="Segoe UI" />


                <iconBut:IconButton Grid.Column="2" x:Name="CloseBut"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Width="25" Height="25" Margin="0 0 20 0"
                                    PreviewMouseDown="CloseBut_PreviewMouseDown"/>
            </Grid>

            <Line StrokeThickness="5" Stroke="{StaticResource DarkThemeDeviderField}" 
              X1="0" X2="1000" VerticalAlignment="Bottom"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="170"/>
                        <RowDefinition Height="80"/>
                        <RowDefinition Height="85"/>
                        <RowDefinition Height="370"/>
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Global settings" VerticalAlignment="Bottom" Margin="25 10 10 10"
                           FontFamily="Segoe UI"
                           FontSize="18" Foreground="{StaticResource TempActiveTextColor}"/>

                        <StackPanel Grid.Row="1">
                            <butToggleIcon:ToggleIconBut x:Name="DeskTopNotifs"/>
                            <butToggleIcon:ToggleIconBut x:Name="FlashBarIcon"/>
                            <butToggleIcon:ToggleIconBut x:Name="AllowSound"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Notification for chat" VerticalAlignment="Bottom" Margin="25 10 10 10"
                           FontFamily="Segoe UI"
                           FontSize="18" Foreground="{StaticResource TempActiveTextColor}"/>

                        <StackPanel Grid.Row="1">
                            <butToggleIcon:ToggleIconBut x:Name="PrivateChat"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Events" VerticalAlignment="Bottom" Margin="25 10 10 10"
                           FontFamily="Segoe UI"
                           FontSize="18" Foreground="{StaticResource TempActiveTextColor}"/>

                        <StackPanel Grid.Row="1">
                            <butToggleIcon:ToggleIconBut x:Name="PinnedMessages"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                           Text="Location On Screen"
                           Foreground="{StaticResource TempActiveTextColor}"
                           FontFamily="Segoe UI"
                           FontSize="18"
                           Margin="25 10 10 10"/>

                        <Border Grid.Row="1" CornerRadius="15" Background="White"
                    Margin="35 15 35 15">
                            <Border  CornerRadius="0" 
                    Background="{StaticResource DarkThemeSecond}"
                    Margin="10">
                                <Grid Margin="3" Name="MonitorBordersGrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>

                                    <MonitorMessage:MessagesStack Grid.Column="0"
                                                          VerticalAlignment="Top"
                                                          HorizontalAlignment="Left"
                                                          x:Name="TopLeftStack"
                                                          PreviewMouseDown="UpdateSide_PreviewMouseDown"/>

                                    <MonitorMessage:MessagesStack Grid.Column="2"
                                                          VerticalAlignment="Top"
                                                          HorizontalAlignment="Right"
                                                          x:Name="TopRightStack"
                                                          PreviewMouseDown="UpdateSide_PreviewMouseDown"/>

                                    <MonitorMessage:MessagesStack Grid.Column="0"
                                                          VerticalAlignment="Bottom"
                                                          HorizontalAlignment="Left"
                                                          x:Name="BottomLeftStack"
                                                          PreviewMouseDown="UpdateSide_PreviewMouseDown"/>

                                    <MonitorMessage:MessagesStack Grid.Column="2" 
                                                          VerticalAlignment="Bottom"
                                                          HorizontalAlignment="Right"
                                                          x:Name="BottomRightStack"
                                                          PreviewMouseDown="UpdateSide_PreviewMouseDown"/>
                                </Grid>
                            </Border>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="4">
                        <Grid Grid.Row="0" Name="TypesToSearchGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                           Text="Location On Screen"
                           Foreground="{StaticResource TempActiveTextColor}"
                           FontFamily="Segoe UI"
                           FontSize="18"
                           Margin="25 10 10 10"/>


                            <StackPanel Grid.Row="1" Name="RectGrid" Orientation="Horizontal" Margin="25 0 25 0">
                                <Border Name="OneBorder" Style="{StaticResource BotBorder}"/>
                                <Border Name="TwoBorder" Style="{StaticResource BotBorder}"/>
                                <Border Name="ThreeBorder" Style="{StaticResource BotBorder}"/>
                                <Border Name="FourBorder" Style="{StaticResource BotBorder}"/>
                                <Border Name="FiveBorder" Style="{StaticResource BotBorder}"/>
                            </StackPanel>

                            <Grid Grid.Row="1">
                                <Border Name="ActiveRect" Background="{StaticResource TempActiveTextColor}"
                                   Width="80" Height="5" CornerRadius="2"
                               HorizontalAlignment="Left" Margin="25 0 0 0"
                               VerticalAlignment="Top">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="ActiveRectTransform" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>


                            <Grid Grid.Row="2"  Name="TabsPanel" Margin="25 5 45 0"
                          Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Style="{StaticResource Tabs}" Name="OneMes" Text="1" 
                               Foreground="{StaticResource TempActiveTextColor}"/>

                                <TextBlock Grid.Column="1" Style="{StaticResource Tabs}" Name="TwoMes" Text="2"
                                   Foreground="Gray"/>

                                <TextBlock Grid.Column="2" Style="{StaticResource Tabs}" Name="ThreeMes" Text="3"
                                   Foreground="Gray"/>

                                <TextBlock Grid.Column="3" Style="{StaticResource Tabs}" Name="FourMes" Text="4"
                                   Foreground="Gray"/>

                                <TextBlock Grid.Column="4" Style="{StaticResource Tabs}" Name="FiveMes" Text="5"
                                   Foreground="Gray"/>

                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</Page>
