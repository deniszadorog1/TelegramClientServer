<Page x:Class="TelegramVisualPart.Pages.Settings.PrivAndSecurity.PrivacyMessages"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TelegramVisualPart.Pages.Settings.PrivAndSecurity"
      mc:Ignorable="d" 
      d:DesignHeight="250" d:DesignWidth="400"
      Height="250" Width="400" 
      Title="PrivacyMessages">
    <Border Name="BgBorder"  CornerRadius="15"
            Background="{StaticResource DarkThemeOne}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="55"/>
                <RowDefinition Height="50"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Name="ActionType" Text="Messages" Margin="20 0 0 0"
                       VerticalAlignment="Center" HorizontalAlignment="Left"
                       FontSize="18" Foreground="{StaticResource UsualTextColor}"/>

            <TextBlock Grid.Row="1" Margin="20 0 0 0"
                       Text="Who can send me messages" FontSize="16" 
                       VerticalAlignment="Center" 
                       Foreground="{StaticResource TempActiveTextColor}"/>

            <StackPanel Grid.Row="2" Margin="20 0 0 0">
                <RadioButton Foreground="{StaticResource UsualTextColor}" Content="Everybody"
                             Name="EverybodyRadio" Checked="EverybodyRadio_Checked"
                             FontSize="16" IsChecked="False" 
                             Background="{StaticResource TempActiveTextColor}"                             
                             Style="{StaticResource MaterialDesignRadioButton}"/>

                <RadioButton Foreground="{StaticResource UsualTextColor}" Content="My contacts and Premium users"
                             Name="MyContactsRadio" Checked="MyContactsRadio_Checked"
                             FontSize="16" IsChecked="False" 
                             Background="{StaticResource TempActiveTextColor}"                             
                             Style="{StaticResource MaterialDesignRadioButton}"/>
            </StackPanel>

            <TextBlock Name="SetBioText" Grid.Row="3" Background="{StaticResource DarkThemeDeviderField}"
                       Text="You can restrict messages from users who are not in your contacts and dont have Premium." FontSize="14"
                       Foreground="Gray" Padding="20 5 10 5" TextWrapping="Wrap"/>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource MaterialDesignRaisedButton}" Name="CancelBut"
                        Content="Cancel" Background="Transparent" BorderThickness="0"
                        HorizontalAlignment="Right" Margin="0 0 10 0"
                        MouseEnter="But_MouseEnter" MouseLeave="But_MouseLeave"
                        Foreground="{StaticResource TempActiveTextColor}"
                        Click="CancelBut_Click"/>

                <Button Style="{StaticResource MaterialDesignRaisedButton}" Name="SaveBut"
                        Content="Save" Background="Transparent" BorderThickness="0"
                        MouseEnter="But_MouseEnter" MouseLeave="But_MouseLeave"
                        HorizontalAlignment="Left"
                        Click="SaveBut_Click"  Margin="10 0 20 0" 
                        Foreground="{StaticResource TempActiveTextColor}"/>
            </StackPanel>
        </Grid>
    </Border>
</Page>
