<Page x:Class="TelegramVisualPart.Pages.Settings.PrivAndSecurity.ButsPages.BlockedUsers"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TelegramVisualPart.Pages.Settings.PrivAndSecurity.ButsPages"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"      
      xmlns:UnbanControl="clr-namespace:TelegramVisualPart.UserControls.SettingsControls"
      xmlns:buts ="clr-namespace:TelegramVisualPart.UserControls"
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="400"
      Height="650" Width="400"
      Title="BlockedUsers">

    <Border CornerRadius="15" Background="{StaticResource DarkThemeOne}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="70"/>
                <RowDefinition Height="50"/>
                <RowDefinition />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>

                <materialDesign:PackIcon Kind="ArrowLeft" VerticalAlignment="Center"
                             Name="BackBut"
                             HorizontalAlignment="Right" Foreground="Gray"
                             Width="30" Height="30" Margin="10"
                             MouseEnter="Buts_MouseEnter"
                             MouseLeave="Buts_MouseLeave"
                             PreviewMouseDown="BackBut_PreviewMouseDown"/>

                <TextBlock Grid.Column="1" Text="Blocked users"
               VerticalAlignment="Center" HorizontalAlignment="Left"
               Foreground="White" FontSize="18"/>

                <materialDesign:PackIcon Kind="Close" Grid.Column="2"
                             Name="CloseBut"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Right" Foreground="Gray"
                             Width="30" Height="30" Margin="10"
                             MouseEnter="Buts_MouseEnter"
                             MouseLeave="Buts_MouseLeave"
                             PreviewMouseDown="CloseBut_PreviewMouseDown"/>
            </Grid>

            <Grid Grid.Row="1">
                <buts:IconTextBut x:Name="ToBlockBut"  
                                  PreviewMouseDown="ToBlockBut_PreviewMouseDown"
                                  HorizontalAlignment="Stretch"/>
            </Grid>

            <Grid Grid.Row="2" Background="{StaticResource DarkThemeDeviderField}">
                <TextBlock TextWrapping="Wrap" Margin="5" Foreground="Gray"
                           FontSize="14"
                           Text="Blocked users can`t send you messages ar add you to groups. 
                           They will not see your profile photos, stories, online and lat seen status."/>
            </Grid>

            <Grid Grid.Row="3" Background="{StaticResource DarkThemeProfileButEnter}">
                <TextBlock Margin="10 0 0 5" VerticalAlignment="Bottom" FontSize="14"
                           Foreground="{StaticResource TempActiveTextColor}"
                           Text="AMOUNT Blocked users" FontWeight="DemiBold"/>
            </Grid>

            <ListBox Grid.Row="4">
                <ListBoxItem 
                    HorizontalContentAlignment="Stretch">
                    <UnbanControl:ToUnblockUser/>
                </ListBoxItem>

            </ListBox>

        </Grid>
    </Border>
</Page>
