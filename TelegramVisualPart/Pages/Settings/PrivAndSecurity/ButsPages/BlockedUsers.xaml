<Page x:Class="TelegramVisualPart.Pages.Settings.PrivAndSecurity.ButsPages.BlockedUsers"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TelegramVisualPart.Pages.Settings.PrivAndSecurity.ButsPages"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"      
      xmlns:UnbanControl="clr-namespace:TelegramVisualPart.UserControls.SettingsControls"
      xmlns:buts ="clr-namespace:TelegramVisualPart.UserControls"
      xmlns:iconBut="clr-namespace:TelegramVisualPart.UserControls.DifferButs"   
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="400"
      Height="650" Width="400"
      MaxHeight="650"
      Title="BlockedUsers">

    <Border CornerRadius="15" Background="{StaticResource DarkThemeOne}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="90"/>
                <RowDefinition Height="50"/>
                <RowDefinition />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>

                <iconBut:IconButton x:Name="BackBut" 
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right" 
                                    Width="30" Height="30" Margin="0 0 20 0"
                                    PreviewMouseDown="BackBut_PreviewMouseDown"/>
                
                <TextBlock Grid.Column="1" Text="Blocked users"
                           VerticalAlignment="Center" HorizontalAlignment="Left"
                           Foreground="{StaticResource UsualTextColor}" FontSize="18"/>

                <iconBut:IconButton x:Name="CloseBut" Grid.Column="2" 
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Width="30" Height="30" Margin="10 0 15 0"
                                    PreviewMouseDown="CloseBut_PreviewMouseDown"/>
            </Grid>

            <Grid Grid.Row="1">
                <buts:IconTextBut x:Name="ToBlockBut" Padding="10 0 0 0"  
                                  PreviewMouseDown="ToBlockBut_PreviewMouseDown"
                                  HorizontalAlignment="Stretch"/>
            </Grid>

            <Grid Grid.Row="2" Background="{StaticResource DarkThemeDeviderField}">
                <TextBlock TextWrapping="Wrap" Margin="20 10 15 0" Foreground="Gray"
                           FontSize="16" 
                           Text="Blocked users can`t send you messages ar add you to groups.They will not see your profile photos, stories, online and lat seen status."/>
            </Grid>

            <Grid Grid.Row="3" >
                <TextBlock Margin="25 0 0 0" VerticalAlignment="Center" FontSize="16"
                           Foreground="{StaticResource TempActiveTextColor}"
                           FontWeight="DemiBold">
                    <Run Text="AMOUNT" Name="AmountNum"/>
                    <Run Text=" Blocked uses"/>
                </TextBlock>
            </Grid>

            <ListBox Grid.Row="4" Name="BlockedUsersPanel" Padding="10 0 10 0">
                <ListBoxItem 
                    HorizontalContentAlignment="Stretch">
                    <UnbanControl:ToUnblockUser/>
                </ListBoxItem>

            </ListBox>

        </Grid>
    </Border>
</Page>
