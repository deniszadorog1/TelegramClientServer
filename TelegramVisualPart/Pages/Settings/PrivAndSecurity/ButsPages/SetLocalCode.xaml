<Page x:Class="TelegramVisualPart.Pages.Settings.PrivAndSecurity.ButsPages.SetLocalCode"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TelegramVisualPart.Pages.Settings.PrivAndSecurity.ButsPages"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"      
      xmlns:iconBut="clr-namespace:TelegramVisualPart.UserControls.DifferButs"   
      mc:Ignorable="d" 
      d:DesignHeight="575" d:DesignWidth="400"
      Height="575" Width="400"
      MaxHeight="650"
      Title="SetLocalCode">

    <Border CornerRadius="15" Background="{StaticResource DarkThemeOne}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="100"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="65"/>
                <RowDefinition Height="75"/>
                <RowDefinition Height="135" Name="BoxesRow"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>

                <iconBut:IconButton x:Name="BackBut"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Width="30" Height="30" Margin="10"
                                    PreviewMouseDown="BackBut_PreviewMouseDown"/>

                <TextBlock Grid.Column="1" Text="Local Passcode"
                           VerticalAlignment="Center" HorizontalAlignment="Left"
                           Foreground="{StaticResource UsualTextColor}" FontSize="18"/>

                <iconBut:IconButton x:Name="CloseBut" Grid.Column="2"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Width="30" Height="30" Margin="10 10 30 10"
                                    PreviewMouseDown="CloseBut_PreviewMouseDown"/>
            </Grid>

            <materialDesign:PackIcon Kind="Duck" Grid.Row="1" VerticalAlignment="Center"
                                 HorizontalAlignment="Center" 
                                 Foreground="{StaticResource UsualTextColor}"
                                 Height="85" Width="85"/>

            <TextBlock Text="Create Local passcode" Grid.Row="2" VerticalAlignment="Center"
                   HorizontalAlignment="Center" 
                   Foreground="{StaticResource UsualTextColor}"
                   FontSize="18"/>

            <TextBlock Text="When a local passcode is set, a lock icon
                   appears at the top of your chat list." Grid.Row="3" 
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center" Foreground="Gray"
                   FontSize="16" TextWrapping="Wrap"/>

            <TextBlock Text="Click it to lock Telegram Desktop." Grid.Row="4" 
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center" Foreground="Gray"
                   FontSize="16" TextWrapping="Wrap"/>

            <StackPanel Orientation="Vertical" Grid.Row="5" Margin="30 0 30 0">
                <TextBox Name="FirstCodeBox"
                  Foreground="{StaticResource UsualTextColor}" Margin="15" FontSize="16"
                  materialDesign:HintAssist.Hint="Enter a passcode"
                  materialDesign:TextFieldAssist.UnderlineBrush="{StaticResource TempActiveTextColor}" 
                  materialDesign:HintAssist.Foreground="Gray"
                  CaretBrush="{StaticResource UsualTextColor}"
                  Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>

                <TextBox Name="SecondBoxCode"
                  Foreground="{StaticResource UsualTextColor}" Margin="15" FontSize="16"
                  materialDesign:HintAssist.Hint="Re-enter new passcode"
                  materialDesign:TextFieldAssist.UnderlineBrush="{StaticResource TempActiveTextColor}" 
                  materialDesign:HintAssist.Foreground="Gray"
                  CaretBrush="{StaticResource UsualTextColor}"
                  Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
            </StackPanel>

            <Button Grid.Row="6" Content="Save Passcode" FontSize="18"
                    BorderThickness="0" Name="AddPasscode" 
                    Click="AddPasscode_Click"
                    Style="{StaticResource MaterialDesignRaisedDarkButton}"
                    Width="320" Height="45" Background="{StaticResource TempActiveTextColor}"/>
        </Grid>
    </Border>
</Page>
