<Page x:Class="TelegramVisualPart.Pages.Settings.Language.LanguagePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:local="clr-namespace:TelegramVisualPart.Pages.Settings.Language"
      xmlns:langBut="clr-namespace:TelegramVisualPart.UserControls.SettingsControls.LanguageControls"
      mc:Ignorable="d" 
      d:DesignHeight="300" d:DesignWidth="400"
      Height="300" Width="400"
      VerticalAlignment="Center"
      HorizontalAlignment="Center"
      Title="LanguagePage">

    <Border CornerRadius="10" Background="{StaticResource DarkThemeOne}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Language" Name="PageName"
                       VerticalAlignment="Center" HorizontalAlignment="Left"
                       Margin="25 0 0 0" Foreground="{StaticResource UsualTextColor}"
                       FontSize="20" FontWeight="SemiBold"/>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Magnify" VerticalAlignment="Center"
                                             Margin="15 0 0 0" Foreground="Gray"
                                             Width="25" Height="25"/>

                    <TextBox Name="SarchBox" Grid.Column="0"
                              Style="{StaticResource MaterialDesignOutlinedTextBox}"

                              BorderBrush="Transparent"
                              BorderThickness="0"
                              
                              materialDesign:HintAssist.Hint="Search"
                              materialDesign:HintAssist.IsFloating="False"
                              
                              Foreground="{StaticResource UsualTextColor}" 
                              Margin="13 0 13 0" FontSize="16"

                              Padding="0"
                              materialDesign:HintAssist.Foreground="Gray"
                              CaretBrush="{StaticResource UsualTextColor}" 
                                              
                              materialDesign:TextFieldAssist.UnderlineBrush="Transparent"
                              materialDesign:TextFieldAssist.DecorationVisibility="Hidden"/>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <langBut:LangRadioBut x:Name="EngLanguage" VerticalAlignment="Center"/>
                    <langBut:LangRadioBut x:Name="RusLanguage" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <Button Grid.Row="2"
                    Style="{StaticResource MaterialDesignRaisedButton}" Name="OkBut"
                    Content="OK" Background="Transparent" BorderThickness="0"
                    HorizontalAlignment="Right" Margin="0 0 15 0" FontSize="16"
                    MouseEnter="But_MouseEnter"  MouseLeave="But_MouseLeave"
                    Foreground="{StaticResource TempActiveTextColor}"
                    Click="OkBut_Click"/>

        </Grid>
    </Border>
</Page>
