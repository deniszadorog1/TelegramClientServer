<Page x:Class="TelegramVisualPart.Pages.Settings.ChatSettings.ChatSetPages.WallpaperPreview"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TelegramVisualPart.Pages.Settings.ChatSettings.ChatSetPages"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:controls="clr-namespace:TelegramVisualPart.UserControls.SettingsControls.ChatSettingsControls.SetWallpapersControls"
      xmlns:chatControls="clr-namespace:TelegramVisualPart.UserControls.ChatControls"
      xmlns:iconButton ="clr-namespace:TelegramVisualPart.UserControls.DifferButs"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="400"
      Height="450" Width="400"
      MaxHeight="450"
      Title="WallpaperPreview">

    <Border Name="BorderBg" Background="{StaticResource DarkThemeOne}" CornerRadius="15">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition/>
                <RowDefinition Height="59"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Name="UpperRowGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Wallpaper preview" Name="PageName" 
                           VerticalAlignment="Center" HorizontalAlignment="Left"
                           Margin="20 0 0 0" Foreground="White" FontSize="18"/>

                 <iconButton:IconButton Grid.Column="1" x:Name="ChangeLightState"
                                        HorizontalAlignment="Right" Width="35" Margin="0 0 10 0"
                                        PreviewMouseDown="ChangeLightState_PreviewMouseDown"/>
            </Grid>

            <Grid Grid.Row="1" Name="MiddleRowGrid">
                <Grid x:Name="ImageGrid">
                    <Image x:Name="BgImage" Source="/Visuals/Images/UserImages/fray.jpg"
                           Stretch="Fill"/>
                </Grid>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition Height="50"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="1" Orientation="Vertical">

                        <Grid>
                            <Border HorizontalAlignment="Center" CornerRadius="10" Margin="05" 
                                Background="Black" Opacity="0.6" Width="100" Height="30"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="TestDate" Text="July 4" Foreground="White"
                                           HorizontalAlignment="Right" FontSize="14"/>
                            </StackPanel>
                        </Grid>


                        <Border  Name="FirstMessageBorder" HorizontalAlignment="Left" 
                                 CornerRadius="10" Margin="20 0 0 0"
                                 Background="{StaticResource DarkThemeOne}">
                            <TextBlock Text="Ah, you kids today with techno music!             
                                       You should enjoy the classic, licke Hasselhoff!"
                                       Name="FirstMessageTextBlock"
                                       TextWrapping="Wrap" Foreground="White"
                                       FontSize="14" Padding="10"/>
                        </Border>

                        <Border  Name="SecondMessageBorder" HorizontalAlignment="Right" 
                                 CornerRadius="10" Margin="0 10 0 0"
                                 Background="{StaticResource DarkThemeOne}">
                            <TextBlock Text="I cant even take you seriously right now."
                                       Name="SecondMessageTextBlock"
                                       TextWrapping="Wrap" Foreground="White"
                                       FontSize="14" Padding="10"/>
                        </Border>


                    </StackPanel>

                    <Grid Grid.Row="2" Width="100" Height="35" x:Name="BlurGrid"
                          MouseEnter="BlurGrid_MouseEnter"
                          MouseLeave="BlurGrid_MouseLeave"
                          PreviewMouseDown="BlurGrid_PreviewMouseDown">

                        <Border Grid.Row="2" Name="IsBlurGrid"  CornerRadius="15"
                            Background="Black" Opacity="0.5"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <CheckBox x:Name="IsBlurCheckBox" Content="Blurred"
                                      Foreground="White" FontSize="14"
                                      Background="White" />
                        </StackPanel>
                    </Grid>

                </Grid>
            </Grid>

            <Grid Grid.Row="2" Name="BottonmGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Left" 
                            VerticalAlignment="Center">
                    <controls:WallpaperBotBut Grid.Row="2" x:Name="Share" Width="75" Margin="10 0 0 0"
                                              PreviewMouseDown="Share_PreviewMouseDown"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Margin="0 0 10 0"
                            VerticalAlignment="Center" Orientation="Horizontal">
                    <controls:WallpaperBotBut Grid.Row="2" x:Name="Cancel" Width="75" Margin="10 0 0 0"
                                              PreviewMouseDown="Cancel_PreviewMouseDown"/>
                    <controls:WallpaperBotBut Grid.Row="2" x:Name="Apply" Width="75" Margin="10 0 0 0"
                                              PreviewMouseDown="Apply_PreviewMouseDown"/>
                </StackPanel>

            </Grid>
        </Grid>
    </Border>
</Page>
