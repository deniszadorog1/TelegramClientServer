<Page x:Class="TelegramVisualPart.Pages.Settings.ChatSettings.ChatSetPages.ChatSetPalette"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TelegramVisualPart.Pages.Settings.ChatSettings.ChatSetPages"
      xmlns:palControls="clr-namespace:TelegramVisualPart.UserControls.SettingsControls.ChatSettingsControls.PaletteControls"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="450"
      Width="450" Height="450"
      MaxHeight="450"
      Title="ChatSetPalette">

    <Border x:Name="BgBorder" CornerRadius="15" 
            Background="{StaticResource DarkThemeOne}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Choose accent color" VerticalAlignment="Center" Margin="15" 
                   Foreground="{StaticResource UsualTextColor}" FontSize="22"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column ="0" Name="PickersGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="75"/>
                    </Grid.RowDefinitions>

                    <palControls:PaletteRectangle x:Name="Palette" Grid.Row="0" Margin="7"/>
                    <palControls:ColorPickerLine x:Name="ColorPickerLine" Grid.Row="1"/>
                </Grid>

                <Grid Grid.Column="1" Name="BoxesGrids" Margin="10 0 10 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="100"/>
                        <RowDefinition/>
                        <RowDefinition Height="145"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <Rectangle Name="FirstColorRect" Height="50" Fill="Green"/>
                        <Rectangle Name="SecondColorRect" Height="50" Fill="Black"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Name="HSL" Orientation="Vertical" Margin="0 10 0 0">
                        <palControls:PaletteTextBox x:Name="HueBox" Height="30"/>
                        <palControls:PaletteTextBox x:Name="SaturationBox" Height="30"/>
                        <palControls:PaletteTextBox x:Name="LuminisityBox" Height="30"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Name="RGB" Orientation="Vertical" Margin="0 10 0 0">
                        <palControls:PaletteTextBox x:Name="RedBox" Height="30"/>
                        <palControls:PaletteTextBox x:Name="GreenBox" Height="30"/>
                        <palControls:PaletteTextBox x:Name="BlueBox" Height="30"/>
                        <palControls:PaletteTextBox x:Name="Hex" Height="30"/>
                    </StackPanel>
                    
                </Grid>

            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" 
                        HorizontalAlignment="Right">
                <Button Style="{StaticResource MaterialDesignRaisedButton}" Name="CancelBut"
                    Content="Cancel" Background="Transparent" BorderThickness="0"
                    HorizontalAlignment="Right" Margin="0 0 10 0"
                    MouseEnter="But_MouseEnter" MouseLeave="But_MouseLeave"
                    Foreground="{StaticResource TempActiveTextColor}"
                    Click="CancelBut_Click"/>

                <Button Style="{StaticResource MaterialDesignRaisedButton}" Name="SaveBut"
                    Content="Save" Background="Transparent" BorderThickness="0"
                    MouseEnter="But_MouseEnter" MouseLeave="But_MouseLeave"
                    HorizontalAlignment="Left"
                    Click="SaveBut_Click"  Margin="10 0 0 0" 
                    Foreground="{StaticResource TempActiveTextColor}"/>
            </StackPanel>
        </Grid>
    </Border>
</Page>
