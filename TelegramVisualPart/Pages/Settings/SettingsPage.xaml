<Page x:Class="TelegramVisualPart.Pages.Settings.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TelegramVisualPart.Pages.Settings"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:butsControls="clr-namespace:TelegramVisualPart.UserControls"
      
      mc:Ignorable="d" 
      d:DesignHeight="625" d:DesignWidth="350"
      Height="625" Width="350"
      Title="SettingsPage">

    <Border Background="{StaticResource DarkThemeOne}" CornerRadius="15">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="80"/>
                <RowDefinition Height="10"/>
                <RowDefinition />
                <RowDefinition Height="10"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="5"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center"
                           FontSize="22" Foreground="White" Text="Settings" />

                <StackPanel Orientation="Horizontal" Grid.Column="1"
                            HorizontalAlignment="Right" VerticalAlignment="Center">

                    <materialDesign:PackIcon Kind="DotsVertical" Name="MoreInfoBut"
                                             Margin="0 0 10 0"
                                             Width="30" Height="30"
                                             Foreground="Gray"
                                             MouseEnter="PackIcon_MouseEnter"
                                             MouseLeave="PackIcon_MouseLeave"
                                             PreviewMouseDown="MoreInfoBut_PreviewMouseDown"/>

                    <materialDesign:PackIcon Kind="Close" Name="CloseBut"
                                             Margin="0 0 20 0"
                                             Width="30" Height="30"
                                             Foreground="Gray"
                                             MouseEnter="PackIcon_MouseEnter"
                                             MouseLeave="PackIcon_MouseLeave"
                                             PreviewMouseDown="CloseBut_PreviewMouseDown"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0" Name ="UserIcon" 
                         Width="70" Height="70" HorizontalAlignment="Center">
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="/Visuals/Images/UserImages/Minato.jpg"/>
                    </Ellipse.Fill>
                </Ellipse>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Name="Username" Text="There gona be username"
                               VerticalAlignment="Center" Foreground="White" FontSize="14"/>

                    <TextBlock Grid.Row="1" Name="PhoneNumber" Text="There gona be phone number"
                               VerticalAlignment="Center" Foreground="White" FontSize="12"/>

                    <TextBlock Grid.Row="2" Name="UserLogin" Text="There gona be user login"
                               VerticalAlignment="Center" Foreground="Gray" FontSize="12"/>
                </Grid>
            </Grid>

            <Grid Grid.Row="2" Background="{StaticResource DarkThemeDeviderField}"/>

            <StackPanel Grid.Row="3">
                <butsControls:IconTextBut x:Name="MyAccount" PreviewMouseDown="Buts_PreviewMouseDown"/>
                <butsControls:IconTextBut x:Name="NotifsSounds" PreviewMouseDown="Buts_PreviewMouseDown"/>
                <butsControls:IconTextBut x:Name="PrivacySecurity" PreviewMouseDown="Buts_PreviewMouseDown"/>
                <butsControls:IconTextBut x:Name="ChatSettings" PreviewMouseDown="Buts_PreviewMouseDown"/>
                <butsControls:IconTextBut x:Name="Folders" PreviewMouseDown="Buts_PreviewMouseDown"/>
                <butsControls:IconTextBut x:Name="Advanced" PreviewMouseDown="Buts_PreviewMouseDown"/>
                <butsControls:IconTextBut x:Name="SpeakersAndCamera" PreviewMouseDown="Buts_PreviewMouseDown"/>
                <butsControls:IconTextBut x:Name="BatteryAnimation" PreviewMouseDown="Buts_PreviewMouseDown"/>
                <butsControls:IconTextBut x:Name="Language" PreviewMouseDown="Buts_PreviewMouseDown"/>
            </StackPanel>

            <Grid Grid.Row="4" Background="{StaticResource DarkThemeDeviderField}"/>

            <Grid Grid.Row="5">
                
            </Grid>

            <Grid Grid.Row="6" Background="{StaticResource DarkThemeDeviderField}"/>


        </Grid>
    </Border>
</Page>
