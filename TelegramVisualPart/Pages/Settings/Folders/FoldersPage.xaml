<Page x:Class="TelegramVisualPart.Pages.Settings.Folders.FoldersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TelegramVisualPart.Pages.Settings.Folders"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"     
      xmlns:folderBut="clr-namespace:TelegramVisualPart.UserControls.SettingsControls.FoldersPrivacy"
      xmlns:addFolderBut="clr-namespace:TelegramVisualPart.UserControls"
      xmlns:iconBut="clr-namespace:TelegramVisualPart.UserControls.DifferButs"   
      mc:Ignorable="d" 
      d:DesignHeight="630" d:DesignWidth="475"
      Height="630" Width="475"
      MaxHeight="900"
      Title="FoldersPage">

    <Border x:Name="BgBorder" CornerRadius="15" 
            Background="{StaticResource DarkThemeOne}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="75"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Name ="UpperPart">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="BackButColumn" Width="60"/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <iconBut:IconButton x:Name="BackBut"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Width="25" Height="25"
                                    PreviewMouseDown="BackBut_PreviewMouseDown"/>

                <TextBlock Grid.Column="1" Text="Folders" Margin="25 0 0 0"
                           Name="PageName"
                           VerticalAlignment="Center" HorizontalAlignment="Left"
                           Foreground="{StaticResource UsualTextColor}" FontSize="22"/>

                <iconBut:IconButton x:Name="CloseBut" Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    Width="25" Height="25" 
                                    VerticalAlignment="Center" 
                                    Margin="0 0 30 0 "
                                    PreviewMouseDown="CloseBut_PreviewMouseDown"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="175"/>
                        <RowDefinition x:Name="FoldersColumn" Height="150"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="105"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    
                    <Grid Grid.Row="0" Name="FolderDevider" 
                  Background="{StaticResource DarkThemeDeviderField}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="100"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <materialDesign:PackIcon 
                           Kind="FolderOutline" VerticalAlignment="Center"
                            HorizontalAlignment="Center" Foreground="Gray"
                            Width="75" Height="75" Margin="10"/>

                        <TextBlock Grid.Row="1" HorizontalAlignment="Center" TextWrapping="Wrap"
                           Text="Create folders for different groups of chats and quickly switch between them."
                           Foreground="Gray" FontSize="16" Width="280" Name="InfoText"/>
                    </Grid>

                    <Grid Grid.Row="1" Name ="MyFoldersGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="My Folder" VerticalAlignment="Center" Margin="20 0 0 0"
                                   Name="FoldersBlock"
                            FontSize="18" Foreground="{StaticResource TempActiveTextColor}"/>

                        <StackPanel Grid.Row="1" Name="Folders"
                                    Orientation="Vertical">
                            <folderBut:FolderLittleInfo x:Name="TestThing" Padding="0 5 5 5"/>

                            <folderBut:AddFolderBut x:Name="CreateNewFolderBut" Padding="0 5 5 5"
                                                PreviewMouseDown="CreateNewFolderBut_PreviewMouseDown"/>
                        </StackPanel>

                    </Grid>

                    <Grid Grid.Row="2" Background="{StaticResource DarkThemeDeviderField}"/>

                    <StackPanel Grid.Row="3" Margin="20 0 0 0">

                        <TextBlock Text="My Folder" VerticalAlignment="Center" Margin="0 0 0 10"
                                   FontSize="18" Foreground="{StaticResource TempActiveTextColor}"
                                   Name="FolderBlock"/>

                        <RadioButton Foreground="{StaticResource UsualTextColor}" 
                                     Content="Tabs on the Left"
                                     Name="LeftTabs"
                             
                                     MouseEnter="TabsRadio_MouseEnter"
                                     MouseLeave="TabsRadio_MouseLeave"
                             
                                     Checked="LeftTabs_Checked"

                                     FontSize="18" IsChecked="False" Padding="10 0 0 2"
                                     materialDesign:RadioButtonAssist.RadioButtonSize="24"
                                     Background="{StaticResource TempActiveTextColor}" 
                                     Margin="-2 5 10 0"
                                     Style="{StaticResource MaterialDesignRadioButton}"/>

                        <RadioButton Foreground="{StaticResource UsualTextColor}" 
                                     Content="Tabs at the Top"
                                     Name="ShitTabs"
                             
                                     MouseEnter="TabsRadio_MouseEnter"
                                     MouseLeave="TabsRadio_MouseLeave"
                             
                                     Checked="ShitTabs_Checked"
                             
                                     FontSize="18" IsChecked="False" Padding="10 0 0 2"
                                     materialDesign:RadioButtonAssist.RadioButtonSize="24"
                                     Background="{StaticResource TempActiveTextColor}" 
                                     Margin="-2 5 0 0"
                                     Style="{StaticResource MaterialDesignRadioButton}"/>
                    </StackPanel>


                    <Grid Grid.Row="4" Name ="AddRecomendedFolder">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="ITS Kchau" VerticalAlignment="Center" 
                                   Margin="20 0 0 0" Name="Kchau"
                                   FontSize="18" Foreground="{StaticResource TempActiveTextColor}"/>


                        <Grid Grid.Row="1" Background="{StaticResource DarkThemeDeviderField}"
                      Margin="10">

                            <Image Name="KchauImg" Stretch="Uniform"  Margin="20"
                                Source="pack://application:,,,/TelegramVisualPart;component/Visuals/Images/SystemImages/kchau.jpg"/>

                            <!-- <TextBlock Text="So this is very interesting and useful info, so read this!!!" 
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap" Foreground="{StaticResource UsualTextColor}" FontSize="14"/>
                        -->
                        </Grid>

                        <!--  <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="125"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column ="0">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Unread" VerticalAlignment="Center" Margin="20 0 0 0"
                                   Foreground="White" FontSize="14"/>

                        <TextBlock Text="New messages from all chats." VerticalAlignment="Top" 
                                   Margin="20 0 0 0" Foreground="Gray" FontSize="14" Grid.Row="1"/>
                    </Grid>


                    <Button Style="{StaticResource MaterialDesignRaisedButton}" Name="AddBut"
                            Grid.Column="1"
                            Content="Add" Background="Transparent" BorderThickness="0"
                            MouseEnter="But_MouseEnter" MouseLeave="But_MouseLeave"
                            HorizontalAlignment="Right"
                            Click="Button_Click"  Margin="10 0 20 0" 
                            Foreground="{StaticResource TempActiveTextColor}"/>

                </Grid> -->


                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</Page>
