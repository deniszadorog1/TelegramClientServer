<Page x:Class="TelegramVisualPart.Pages.Settings.Folders.FoldersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TelegramVisualPart.Pages.Settings.Folders"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"     
      xmlns:folderBut="clr-namespace:TelegramVisualPart.UserControls.SettingsControls.FoldersPrivacy"
      xmlns:addFolderBut="clr-namespace:TelegramVisualPart.UserControls"
      xmlns:iconBut="clr-namespace:TelegramVisualPart.UserControls.DifferButs"   
      mc:Ignorable="d" 
      d:DesignHeight="575" d:DesignWidth="475"
      Height="575" Width="475"
      MaxHeight="575"
      Title="FoldersPage">

    <Border x:Name="BgBorder" CornerRadius="15" 
            Background="{StaticResource DarkThemeOne}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="150"/>
                <RowDefinition Height="175"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="95"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Name ="UpperPart">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0"/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <iconBut:IconButton x:Name="BackBut"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Width="25" Height="25"
                                    PreviewMouseDown="BackBut_PreviewMouseDown"/> 

                <TextBlock Grid.Column="1" Text="Folders" Margin="25 0 0 0"
                           VerticalAlignment="Center" HorizontalAlignment="Left"
                           Foreground="White" FontSize="22"/>

                <iconBut:IconButton x:Name="CloseBut" Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    Width="25" Height="25" 
                                    VerticalAlignment="Center" 
                                    Margin="0 0 30 0 "
                                    PreviewMouseDown="CloseBut_PreviewMouseDown"/>
            </Grid>

            <Grid Grid.Row="1" Name="FolderDevider" 
                  Background="{StaticResource DarkThemeDeviderField}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="90"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <materialDesign:PackIcon 
                           Kind="FolderOutline" VerticalAlignment="Center"
                            HorizontalAlignment="Center" Foreground="Gray"
                            Width="75" Height="75" Margin="10"/>

                <TextBlock Grid.Row="1" HorizontalAlignment="Center" TextWrapping="Wrap"
                           Text="Create folders for different groups of chats and quickly switch between them."
                           Foreground="Gray" FontSize="16" Width="280"/>
            </Grid>

            <Grid Grid.Row="2" Name ="MyFoldersGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Text="My Folder" VerticalAlignment="Center" Margin="25 0 0 0"
               FontSize="18" Foreground="{StaticResource TempActiveTextColor}"/>

                <ListBox  Grid.Row="1" Name="Folders">
                    
                    <ListBoxItem  HorizontalContentAlignment="Stretch" Padding="0">
                        <folderBut:FolderLittleInfo x:Name="TestThing" Padding="0 5 5 5"/>
                    </ListBoxItem>

                    <ListBoxItem x:Name="AddFolderBoxItem" HorizontalContentAlignment="Stretch" Padding="0">
                        <folderBut:AddFolderBut x:Name="CreateNewFolderBut" Padding="0 5 5 5"
                                                PreviewMouseDown="CreateNewFolderBut_PreviewMouseDown"/>
                    </ListBoxItem>
                    
                </ListBox>

            </Grid>

            <Grid Grid.Row="3" Background="{StaticResource DarkThemeDeviderField}"/>

            <StackPanel Grid.Row="4" Margin="25 0 0 0">

                <TextBlock Text="My Folder" VerticalAlignment="Center" 
               FontSize="18" Foreground="{StaticResource TempActiveTextColor}"/>

                <RadioButton Foreground="White" Content="Tabs on the Left"
                                 Name="LeftTabs" 
                             
                             Checked="LeftTabs_Checked"

                             FontSize="18" IsChecked="False" Padding="3 0 0 2"
                                 materialDesign:RadioButtonAssist.RadioButtonSize="24"
                                 Background="{StaticResource TempActiveTextColor}" 
                                 Margin="0 5 0 0"
                                 Style="{StaticResource MaterialDesignRadioButton}"/>

                <RadioButton Foreground="White" Content="Tabs at the Top"
                                 Name="ShitTabs"
                                    
                             Checked="ShitTabs_Checked"
                             
                                 FontSize="18" IsChecked="False" Padding="3 0 0 2"
                                 materialDesign:RadioButtonAssist.RadioButtonSize="24"
                                 Background="{StaticResource TempActiveTextColor}" 
                                 Margin="0 5 0 0"
                                 Style="{StaticResource MaterialDesignRadioButton}"/>
            </StackPanel>
            
            
            <Grid Grid.Row="5" Name ="AddRecomendedFolder">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Text="My Folder" VerticalAlignment="Center" Margin="25 0 0 0"
                    FontSize="18" Foreground="{StaticResource TempActiveTextColor}"/>


                <Grid Grid.Row="1" Background="{StaticResource DarkThemeDeviderField}"
                      Margin="10">

                    <TextBlock Text="So this is very interesting and useful info, so read this!!!" 
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap" Foreground="White" FontSize="14"/>

                </Grid>
                
              <!--  <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="125"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column ="0">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Unread" VerticalAlignment="Center" Margin="20 0 0 0"
                                   Foreground="White" FontSize="14"/>

                        <TextBlock Text="New messages from all chats." VerticalAlignment="Top" 
                                   Margin="20 0 0 0" Foreground="Gray" FontSize="14" Grid.Row="1"/>
                    </Grid>


                    <Button Style="{StaticResource MaterialDesignRaisedButton}" Name="AddBut"
                            Grid.Column="1"
                            Content="Add" Background="Transparent" BorderThickness="0"
                            MouseEnter="But_MouseEnter" MouseLeave="But_MouseLeave"
                            HorizontalAlignment="Right"
                            Click="Button_Click"  Margin="10 0 20 0" 
                            Foreground="{StaticResource TempActiveTextColor}"/>

                </Grid> -->


            </Grid>


        </Grid>
    </Border>
</Page>
