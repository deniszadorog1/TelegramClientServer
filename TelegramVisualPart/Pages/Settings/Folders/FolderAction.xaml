<Page x:Class="TelegramVisualPart.Pages.Settings.Folders.FolderAction"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TelegramVisualPart.Pages.Settings.Folders"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"    
      xmlns:chooseFolderIcon="clr-namespace:TelegramVisualPart.UserControls.SettingsControls.FoldersPrivacy"
      xmlns:folderBut="clr-namespace:TelegramVisualPart.UserControls.SettingsControls.FoldersPrivacy"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="465"
      Height="600" Width="465"
      Title="FolderAction">

    <Border x:Name="BgBorder" CornerRadius="15" 
            Background="{StaticResource DarkThemeOne}">
        <ScrollViewer HorizontalContentAlignment="Stretch"
                      VerticalScrollBarVisibility="Auto">
            <Grid Width="{Binding ActualWidth, ElementName=BgBorder}" 
                      Height="{Binding ActualHeight, ElementName=BgBorder}" 
                      HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="150"/>
                        <RowDefinition Height="150"/>
                        <RowDefinition Height="150"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="PageName" Text="New Folder" 
                               VerticalAlignment="Center" Margin="20 0 0 0"
                               Foreground="White" FontSize="18"/>

                    <Grid Grid.Row="1">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="85"/>
                    </Grid.ColumnDefinitions>

                    <TextBox  Grid.Column="0" MaxLength="12"
                             Foreground="White" Margin="20 0 0 0" FontSize="16"
                             materialDesign:HintAssist.Hint="Folder name"
                             materialDesign:TextFieldAssist.UnderlineBrush="{StaticResource DarkThemeProfileButForeGround}" 
                             CaretBrush="White" Name="FolderNameBox"
                             materialDesign:HintAssist.Foreground="Gray"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" />

                    <Grid Width="50" Height="50" Grid.Column="1"
                          HorizontalAlignment ="Left" 
                              Margin="0 0 20 0" Name ="ToChooseFolderIcon" 
                              MouseEnter="ToChooseFolderIcon_MouseEnter"
                              MouseLeave="ToChooseFolderIcon_MouseLeave">
                            <materialDesign:PackIcon Kind="Folder" Width="40" Height="40"
                                                     VerticalAlignment="Center" HorizontalAlignment="Center"
                                                     Foreground="Gray"/>
                        </Grid>

                    </Grid>
                    
                    <chooseFolderIcon:FolderIcons Grid.Row="2" VerticalAlignment="Top" 
                                                  HorizontalAlignment="Right"
                                                  Panel.ZIndex="10" Margin="20 -15 40 0" 
                                                  x:Name="FolderIcon" Visibility="Hidden"
                                                  MouseLeave="FolderIcon_MouseLeave"/>

                    <Grid Grid.Row="2" HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Name ="WhoCanUseBlock" Text="Included chats" TextWrapping="Wrap"
                           Foreground="{StaticResource DarkThemeProfileButForeGround}"
                           VerticalAlignment="Center" FontSize="16" Margin="20 0 0 0"/>

                        <folderBut:AddFolderBut x:Name="CreateNewFolderBut" Grid.Row="1" Margin="20 0 0 0"/>

                        <TextBlock Margin="0 5 0 0"
                                   Grid.Row="2"  Background="{StaticResource DarkThemeDeviderField}" 
                                   HorizontalAlignment="Stretch" TextWrapping="Wrap"
                                   Text="Choose chats or types of chats that will appear in this folder."
                                   Foreground="Gray" FontSize="14" Padding="20 10 0 0"/>
                    </Grid>


                    <Grid Grid.Row="3" HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Name ="ExcludedChatsBlock" Text="Excluded chats" TextWrapping="Wrap"
                           Foreground="{StaticResource DarkThemeProfileButForeGround}"
                           VerticalAlignment="Center" FontSize="16" Margin="20 0 0 0"/>

                        <folderBut:AddFolderBut x:Name="ChatToExcludeBut" Grid.Row="1" Margin="20 0 0 0"
                                                PreviewMouseDown="ChatToExcludeBut_PreviewMouseDown"/>

                        <TextBlock Margin="0 5 0 0" 
                                   Grid.Row="2"  Background="{StaticResource DarkThemeDeviderField}" 
                                   HorizontalAlignment="Stretch" TextWrapping="Wrap"
                                   Text="Choose chats or types of chats that will NOT appear in this folder."
                                   Foreground="Gray" FontSize="14" Padding="20 10 20 0"/>
                    </Grid>


                    <Grid Grid.Row="4" HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Name ="ShareFolderBlock" Text="Share folder" TextWrapping="Wrap"
                           Foreground="{StaticResource DarkThemeProfileButForeGround}"
                           VerticalAlignment="Center" FontSize="16" Margin="20 0 0 0"/>

                        <folderBut:AddFolderBut x:Name="CreateInviteLinkBut" Grid.Row="1" Margin="20 0 0 0"
                                                PreviewMouseDown="ChatToExcludeBut_PreviewMouseDown"/>

                        <TextBlock Margin="0 5 0 0"
                                   Grid.Row="2"  Background="{StaticResource DarkThemeDeviderField}" 
                                   HorizontalAlignment="Stretch" TextWrapping="Wrap" 
                                   Text="Share Accessto some of this folders groups and channels with others."
                                   Foreground="Gray" FontSize="14" Padding="20 10 20 0"/>
                    </Grid>

                    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource MaterialDesignRaisedButton}" Name="CancelBut"
                            Content="Cancel" Background="Transparent" BorderThickness="0"
                            HorizontalAlignment="Right" Margin="0 0 10 0"
                            MouseEnter="But_MouseEnter" MouseLeave="But_MouseLeave"
                            Foreground="{StaticResource DarkThemeProfileButForeGround}"
                            Click="CancelBut_Click"/>

                        <Button Style="{StaticResource MaterialDesignRaisedButton}" Name="CreateBut"
                            Content="Create" Background="Transparent" BorderThickness="0"
                            MouseEnter="But_MouseEnter" MouseLeave="But_MouseLeave"
                            HorizontalAlignment="Left" 
                            Click="CreateBut_Click"  Margin="10 0 20 0" 
                            Foreground="{StaticResource DarkThemeProfileButForeGround}"/>
                    </StackPanel>

                </Grid>
        </ScrollViewer>
    </Border>
</Page>
