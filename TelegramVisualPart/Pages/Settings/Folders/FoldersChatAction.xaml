<Page x:Class="TelegramVisualPart.Pages.Settings.Folders.FoldersChatAction"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TelegramVisualPart.Pages.Settings.Folders"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"    
      xmlns:items ="clr-namespace:TelegramVisualPart.UserControls.SettingsControls.FoldersPrivacy"
      mc:Ignorable="d" 
      d:DesignHeight="550" d:DesignWidth="400"
      Height="550" Width="400"
      Title="FoldersChatAction">

    <Border Name="bgBorder" CornerRadius="15" 
            Background="{StaticResource DarkThemeOne}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50" Name="SerchRow"/>
                <RowDefinition/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <TextBlock Name="PageNameText" Text="There gona be page name"
                           VerticalAlignment="Center" Margin="20 0 0 0" Foreground="White"
                           FontSize="18"/>
                <StackPanel Orientation="Horizontal" Margin="10 5 0 0">
                    <TextBlock Name="AmountOfAddedChats" Text="0" VerticalAlignment="Center" FontSize="16" Foreground="Gray"/>
                    <TextBlock Name="AmountOfChatsDevider" Text="/" VerticalAlignment="Center" FontSize="16" Foreground="Gray"/>
                    <TextBlock Name="MAxAmountOfChats" Text="100" VerticalAlignment="Center" FontSize="16" Foreground="Gray"/>
                </StackPanel>
            </StackPanel>


            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <materialDesign:PackIcon Kind="Magnify" Width="35" Height="35" Foreground="Gray"
                                         VerticalAlignment="Center" HorizontalAlignment="Center"
                                         Margin="15 0 0 0" Grid.Column="0"/>

                <TextBox MaxLength="12" Grid.Column="1"
                         Foreground="White" Margin="20 0 0 0" FontSize="16"
                         materialDesign:HintAssist.Hint="Search"
                         materialDesign:TextFieldAssist.UnderlineBrush="{StaticResource TempActiveTextColor}" 
                         CaretBrush="White" Name="ChatSearchBox"
                         materialDesign:HintAssist.Foreground="Gray"
                         materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>

                <Grid Grid.Column="2" Margin="0 0 15 0" Name ="ClearSearchBoxGrid"
                      MouseEnter="ClearSearchBoxGrid_MouseEnter"
                      MouseLeave="ClearSearchBoxGrid_MouseLeave"
                      PreviewMouseDown="ClearSearchBoxGrid_PreviewMouseDown">
                    <materialDesign:PackIcon Kind="Close" Width="35" Height="35" Foreground="Gray"
                                             VerticalAlignment="Center" HorizontalAlignment="Center"
                                             x:Name="ClearSearchBoxBut"/>
                </Grid>
            </Grid>

            <ListBox Grid.Row="2" Name="ListContacts">

                <ListBoxItem HorizontalAlignment="Stretch"
                             Background="{StaticResource DarkThemeDeviderField}">
                    <TextBlock Text="Chat types" Padding="20 0 0 0"  Foreground="Gray" FontSize="16"/>
                </ListBoxItem>

                <ListBoxItem Padding="0" HorizontalAlignment="Stretch" PreviewMouseDown="ChatTypes_PreviewMouseDown">
                    <items:FolderChatType x:Name="ContactsChats"/>
                </ListBoxItem>

                <ListBoxItem Padding="0" HorizontalAlignment="Stretch" PreviewMouseDown="ChatTypes_PreviewMouseDown">
                    <items:FolderChatType x:Name="NoneContactsChats"/>
                </ListBoxItem>

                <ListBoxItem Padding="0" HorizontalAlignment="Stretch" PreviewMouseDown="ChatTypes_PreviewMouseDown">
                    <items:FolderChatType x:Name="GroupsChats"/>
                </ListBoxItem>

                <ListBoxItem Padding="0" HorizontalAlignment="Stretch" PreviewMouseDown="ChatTypes_PreviewMouseDown">
                    <items:FolderChatType x:Name="ChannelsChats"/>
                </ListBoxItem>

                <ListBoxItem Padding="0" HorizontalAlignment="Stretch" PreviewMouseDown="ChatTypes_PreviewMouseDown">
                    <items:FolderChatType x:Name="BotsChats"/>
                </ListBoxItem>

                <ListBoxItem  HorizontalAlignment="Stretch" Background="{StaticResource DarkThemeDeviderField}">
                    <TextBlock Text="Chats" VerticalAlignment="Center" Padding="20 0 0 0" 
                               Foreground="Gray" FontSize="16"/>
                </ListBoxItem>


                <ListBoxItem Padding="0" HorizontalAlignment="Stretch" PreviewMouseDown="ChatTypes_PreviewMouseDown">
                    <items:FolderChatType x:Name="BotasdsChats"/>
                </ListBoxItem>

                <ListBoxItem Padding="0" HorizontalAlignment="Stretch" PreviewMouseDown="ChatTypes_PreviewMouseDown">
                    <items:FolderChatType x:Name="BotsaChats"/>
                </ListBoxItem>

                <ListBoxItem Padding="0" HorizontalAlignment="Stretch" PreviewMouseDown="ChatTypes_PreviewMouseDown">
                    <items:FolderChatType x:Name="BotsqweChats"/>
                </ListBoxItem>


            </ListBox>

         <!--   <ScrollViewer Grid.Row="2" Name="asd" Visibility="Hidden">
