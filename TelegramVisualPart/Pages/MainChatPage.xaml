<Page x:Class="TelegramVisualPart.Pages.MainChatPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TelegramVisualPart.Pages"
      xmlns:leftButs="clr-namespace:TelegramVisualPart.UserControls.MainPage"
      xmlns:userControls="clr-namespace:TelegramVisualPart.UserControls"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:controls="clr-namespace:TelegramVisualPart.UserControls"
      xmlns:searchControl ="clr-namespace:TelegramVisualPart.UserControls.ChatsSearch"
      xmlns:menuIconTextBut="clr-namespace:TelegramVisualPart.UserControls.DifferButs"
      xmlns:SliderMenu="clr-namespace:TelegramVisualPart.UserControls.ChatControls"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainChatPage" PreviewMouseDown="Page_MouseDown"
      PreviewKeyDown="Page_PreviewKeyDown"
      Loaded="Page_Loaded">


    <materialDesign:DrawerHost x:Name="MainDrawerHost">
        <materialDesign:DrawerHost.LeftDrawerContent>
            <StackPanel Background="{StaticResource DarkThemeOne}" Width="320"
                        Name="SlideMenuPanel">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="75"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Ellipse Name ="LoggedUserImage" Width="50" Height="50"
                             HorizontalAlignment="Left" Margin="10"
                             Grid.Column="0">
                        <Ellipse.Fill>
                            <ImageBrush x:Name="UserImage"  ImageSource="pack://application:,,,/Visuals/Images/UserImages/Minato.jpg"/>
                        </Ellipse.Fill>
                    </Ellipse>

                    <TextBlock Grid.Column="1" Name="SliderLogin" Text="TestLogin"
                               FontSize="16" Foreground="{StaticResource UsualTextColor}" 
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"/>

                </Grid>
                <Line Stroke="{StaticResource DarkThemeSecond}" 
                      StrokeThickness="1" X1="0" X2="275"/>

                <menuIconTextBut:MenuIconTextBut x:Name="MyProfileDrawBut" PreviewMouseDown="LeftBut_PreviewMouseDown"/>
                <menuIconTextBut:MenuIconTextBut x:Name="WalletDrawBut" PreviewMouseDown="LeftBut_PreviewMouseDown"/>

                <Line Stroke="{StaticResource DarkThemeSecond}" 
                      StrokeThickness="1" X1="0" X2="275"/>

                <menuIconTextBut:MenuIconTextBut x:Name="NewGroupDrawBut" PreviewMouseDown="LeftBut_PreviewMouseDown"/>
                <menuIconTextBut:MenuIconTextBut x:Name="NewChannelDrawBut" PreviewMouseDown="LeftBut_PreviewMouseDown"/>
                <menuIconTextBut:MenuIconTextBut x:Name="ContactsDrawBut" PreviewMouseDown="LeftBut_PreviewMouseDown"/>
                <menuIconTextBut:MenuIconTextBut x:Name="CallsDrawBut" PreviewMouseDown="LeftBut_PreviewMouseDown"/>
                <!-- <menuIconTextBut:MenuIconTextBut x:Name="SavedMessagesDrawBut" PreviewMouseDown="SavedMessagesDrawBut_PreviewMouseDown"/>
               -->
                <menuIconTextBut:MenuIconTextBut x:Name="SettingsDrawBut" PreviewMouseDown="LeftBut_PreviewMouseDown"/>
            </StackPanel>
        </materialDesign:DrawerHost.LeftDrawerContent >

        <Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Name="LeftButtonsColumn" Width="100"/>
                    <ColumnDefinition MinWidth="0" x:Name="ChatsColumn" Width="*" />
                    <ColumnDefinition Width="3" x:Name="GridSplitterColumn"/>
                    <ColumnDefinition x:Name="ChatColumn" MinWidth="250" Width="*"/>
                </Grid.ColumnDefinitions>

                <leftButs:LeftButtons x:Name="LeftButtons" 
                                  OnMenuClick="LeftButtons_OnMenuClick"  
                                  Background="{StaticResource DarkThemeSecond}"/>

                <Grid Grid.Column="1" Background="{StaticResource DarkThemeOne}" 
                  Name ="ChatsGrid" 
                  SizeChanged="ChatsGrid_SizeChanged">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="45"/>
                        <RowDefinition Name="FolderSliderRow" Height="0"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Name="AddHamburgMenuCol" Width="0"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Grid Name="HamburgerAddGrid"  Grid.Column="0"
                          Margin="5 0 0 0" 
                          Background="Transparent" 
                          MouseEnter="HamburgerAddGrid_MouseEnter"
                          MouseLeave="HamburgerAddGrid_MouseLeave"
                          PreviewMouseDown="LeftButtons_OnMenuClick">
                            <materialDesign:PackIcon Kind="HamburgerMenu" Name="HamburgIcon" 
                                              Width="30" Height="30" Foreground="Gray" 
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              Visibility="Visible"/>
                        </Grid>

                        <Border  Margin="10 5 10 0" Grid.Column="1"
                             CornerRadius="20" Name="SearchBorder"
                             Background="{StaticResource DarkThemeDeviderField}">
                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition x:Name="CrossSearchColumn" Width="0"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Name="SarchBox" Grid.Column="0"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"

                                     BorderBrush="Transparent"
                                     BorderThickness="0"
                                     
                                     
                                     materialDesign:HintAssist.IsFloating="False"
                                     
                                     Foreground="{StaticResource UsualTextColor}" 
                                     Margin="13 0 13 0" FontSize="16"

                                     Padding="0"
                                     materialDesign:HintAssist.Foreground="Gray"
                                     CaretBrush="{StaticResource UsualTextColor}" 
                                     
                                     GotFocus="SarchBox_GotFocus"
                                     LostFocus="SarchBox_LostFocus"
                                     TextChanged="SarchBox_TextChanged"
                                     
                                     materialDesign:TextFieldAssist.UnderlineBrush="Transparent"
                                     materialDesign:TextFieldAssist.DecorationVisibility="Hidden"/>

                                <menuIconTextBut:IconButton x:Name="ClearTextBut"
                                                        Grid.Column="1"
                                                 HorizontalAlignment="Right"
                                                 VerticalAlignment="Center"
                                                 Width="25" Height="25"
                                                 Foreground="Gray"
                                                 Margin="0 0 10 0"
                                                 PreviewMouseDown="ClearTextBut_PreviewMouseDown"/>
                            </Grid>
                        </Border>

                        <Grid 
                      Name="MagnifierGrid"  Grid.Column="1"
                        Background="Transparent" Visibility="Hidden"
                      MouseEnter="MagnifierGrid_MouseEnter"
                      MouseLeave="MagnifierGrid_MouseLeave"
                      PreviewMouseDown="MagnifierGrid_PreviewMouseDown">

                            <materialDesign:PackIcon Kind="Magnify" Name="SearchChatBut" Margin="10 10 0 0"
                                                 Width="35" Height="35" Foreground="Gray" 
                                                 Visibility="Hidden"/>
                        </Grid>
                    </Grid>


                    <Grid Grid.Row="1" Name="FolderSliderGrid" Margin="0 5 0 0">
                        <SliderMenu:ItemsSlider x:Name="FolderSliderMenu"/>
                    </Grid>

                    <ListBox Grid.Row="2" x:Name="ChatsBox" Visibility="Hidden">
                        <!-- <controls:UserTalkMessage Margin="-10 0 0 0"   
                                              Width="{Binding ActualWidth, ElementName=ChatsGrid}"/> -->
                    </ListBox>

                    <StackPanel Grid.Row="2" Name="SearchBoxGrid" Visibility="Hidden" 
                      HorizontalAlignment="Stretch" VerticalAlignment="Top"
                            Orientation="Vertical">
                        <searchControl:SearchControl x:Name="SearchControl"
                                                 HorizontalAlignment="Stretch"/>
                        
                        <WrapPanel Name ="AllMediasElements"
                               Background="Transparent" 
                               VerticalAlignment="Top"
                               HorizontalAlignment="Left">

                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Name="SearchMessageGrid" Visibility="Hidden"
                      HorizontalAlignment="Stretch" VerticalAlignment="Top"
                      Margin="0 10 0 0" Background="Transparent" Orientation="Vertical">
                        <searchControl:SearchMessage x:Name="SearchMessage" HorizontalAlignment="Stretch"/>
                        <ListBox Name="SearchedMessageslistBox"/>
                    </StackPanel>

                    <StackPanel Name="NothingFoundSearch" Grid.Row="1" Visibility="Hidden" 
                            Background="Transparent"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Center"
                            Orientation="Vertical" Margin="0 100 0 0">
                        <materialDesign:PackIcon Kind="Magnify" Margin="0 10 0 0"
                                             HorizontalAlignment="Center"
                                                 Width="100" Height="100" Foreground="White"/>
                        <TextBlock Text="Search for messages" FontSize="18"
                               Foreground="Gray" Margin="0 15 0 0"/>
                    </StackPanel>
                </Grid>

                <GridSplitter Grid.Column="2"
                  Width="3" Name="MySplitter"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Background="Transparent"
                  ShowsPreview="False"
                  Focusable="False"
                  ResizeBehavior="PreviousAndNext"
                  ResizeDirection="Columns"
                  Cursor="SizeWE"
                  DragDelta="GridSplitter_DragDelta"/>
                <Border Name="ChatBg" Grid.Column="3" Background="{StaticResource DarkThemeSecond}">
                    <Grid>
                        <Grid Name="NotFoundBg" Background="Transparent"/>
                        <Border Name="ChosoeChatBorder" Visibility="Visible"
                            Background="Gray" CornerRadius="10" 
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" Margin="0 0 0 100">
                            <TextBlock Text="asd" Foreground="White"
                                   FontSize="18" Padding="7" Name="SetChatBlock"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <userControls:UserChat x:Name="UserChat" Visibility="Hidden"/>
                    </Grid>
                </Border>
            </Grid>

            <Canvas Name="MenusCan"/>
        </Grid>
    </materialDesign:DrawerHost>

</Page>
