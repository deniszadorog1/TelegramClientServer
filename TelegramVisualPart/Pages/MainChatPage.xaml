<Page x:Class="TelegramVisualPart.Pages.MainChatPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TelegramVisualPart.Pages"
      xmlns:leftButs="clr-namespace:TelegramVisualPart.UserControls.MainPage"
      xmlns:userControls="clr-namespace:TelegramVisualPart.UserControls"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:controls="clr-namespace:TelegramVisualPart.UserControls"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainChatPage" >

    <materialDesign:DrawerHost x:Name="MainDrawerHost">
        <materialDesign:DrawerHost.LeftDrawerContent>
            <StackPanel Background="{StaticResource DarkThemeOne}" Width="275">
                
                <Ellipse Name ="LoggedUserImage" Width="50" Height="50"
                         HorizontalAlignment="Left" Margin="10">
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="pack://application:,,,/Visuals/Images/UserImages/Minato.jpg"/>
                    </Ellipse.Fill>
                </Ellipse>
                
                <Line Stroke="{StaticResource DarkThemeSecond}" 
                      StrokeThickness="1" X1="0" X2="275"/>

                <userControls:IconTextBut x:Name="MyProfileDrawBut" PreviewMouseDown="LeftBut_PreviewMouseDown"/>
                <userControls:IconTextBut x:Name="WalletDrawBut" PreviewMouseDown="LeftBut_PreviewMouseDown"/>
                
                <Line Stroke="{StaticResource DarkThemeSecond}" 
                      StrokeThickness="1" X1="0" X2="275"/>

                <userControls:IconTextBut x:Name="NewGroupDrawBut" PreviewMouseDown="LeftBut_PreviewMouseDown"/>
                <userControls:IconTextBut x:Name="NewChannelDrawBut" PreviewMouseDown="LeftBut_PreviewMouseDown"/>
                <userControls:IconTextBut x:Name="ContactsDrawBut" PreviewMouseDown="LeftBut_PreviewMouseDown"/>
                <userControls:IconTextBut x:Name="CallsDrawBut" PreviewMouseDown="LeftBut_PreviewMouseDown"/>
                <userControls:IconTextBut x:Name="SavedMessagesDrawBut" PreviewMouseDown="SavedMessagesDrawBut_PreviewMouseDown"/>
                <userControls:IconTextBut x:Name="SettingsDrawBut" PreviewMouseDown="LeftBut_PreviewMouseDown"/>
            </StackPanel>
        </materialDesign:DrawerHost.LeftDrawerContent >

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="65"/>
                <ColumnDefinition MinWidth="200" x:Name="ChatsColumn"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition MinWidth="250"/>
            </Grid.ColumnDefinitions>

            <leftButs:LeftButtons x:Name="LeftButtons" OnMenuClick="LeftButtons_OnMenuClick"  Background="{StaticResource DarkThemeSecond}"/>

            <Grid Grid.Column="1" Background="{StaticResource DarkThemeOne}" Name ="ChatsGrid" 
                  SizeChanged="ChatsGrid_SizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="45"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Margin="10 5 10 0" CornerRadius="20"
                        Background="{StaticResource DarkThemeDeviderField}">
                    <TextBox Grid.Row="0"
                          Foreground="White" Margin="10 0 10 0" FontSize="14"
                          materialDesign:HintAssist.Hint="Serch"
                          materialDesign:TextFieldAssist.UnderlineBrush="{StaticResource DarkThemeMouseEnterBut}" 
                          materialDesign:HintAssist.Foreground="Gray"
                           CaretBrush="White"/>
                </Border>

                <ListBox Grid.Row="1" x:Name="ChatsBox">
                    <controls:UserTalkMessage Margin="-10 0 0 0" Width="{Binding ActualWidth, ElementName=ChatsGrid}"/>
                </ListBox>
                
            </Grid>


            <GridSplitter Grid.Column="2"
                  Width="5"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Background="Gray"
                  ShowsPreview="False"
                  ResizeBehavior="PreviousAndNext"
                  ResizeDirection="Columns"
                  Cursor="SizeWE"/>

            <userControls:UserChat Grid.Column="3">

            </userControls:UserChat>


        </Grid>
    </materialDesign:DrawerHost>

</Page>
