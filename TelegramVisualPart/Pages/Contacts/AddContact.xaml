<Page x:Class="TelegramVisualPart.Pages.Contacts.AddContact"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TelegramVisualPart.Pages.Contacts"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"

      mc:Ignorable="d" 
      d:DesignHeight="400" d:DesignWidth="500"
      Height="400" Width="500"
      VerticalAlignment="Center"
      HorizontalAlignment="Center"
      Title="AddContact">

    <Border Background="{StaticResource DarkThemeOne}"
            CornerRadius="15">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="80"/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="New Contact" FontSize="20" Foreground="White" 
                   VerticalAlignment="Center" HorizontalAlignment="Left"
                   Margin="15 0 0 0"/>


            <Grid Grid.Row="1" Margin="10 0 40 5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <materialDesign:PackIcon Kind="AccountOutline" Width="35" Height="35" Foreground="Gray"
                                         VerticalAlignment="Center" HorizontalAlignment="Center"
                                         Margin="15 0 0 0" Grid.Column="0"/>

                <TextBox Grid.Row="2" Grid.Column="1"
                  Foreground="White" Margin="10 0 10 10" FontSize="16"
                  materialDesign:HintAssist.Hint="First name"
                  materialDesign:TextFieldAssist.UnderlineBrush="{StaticResource DarkThemeMouseEnterBut}" 
                  CaretBrush="White" Name="NameBox"
                  materialDesign:HintAssist.Foreground="Gray"
                  Style="{StaticResource MaterialDesignFloatingHintTextBox}" />
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Row="2" Grid.Column="1"
                  Foreground="White" Margin="10" FontSize="16"
                  materialDesign:HintAssist.Hint="Last name"
                  materialDesign:TextFieldAssist.UnderlineBrush="{StaticResource DarkThemeMouseEnterBut}" 
                  CaretBrush="White" Name="LastnameBox"
                  materialDesign:HintAssist.Foreground="Gray"
                  Style="{StaticResource MaterialDesignFloatingHintTextBox}" />
            </Grid>


            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <materialDesign:PackIcon Kind="SettingsPhone" Width="35" Height="35" Foreground="Gray"
                                         VerticalAlignment="Center" HorizontalAlignment="Center"
                                         Margin="15 0 0 0" Grid.Column="0"/>

                <TextBox Grid.Row="2" Grid.Column="1" MaxLength="15"
                         PreviewTextInput="PhoneBox_PreviewTextInput"
                         TextChanged="PhoneBox_TextChanged"
                  Foreground="White" Margin="10" FontSize="16"
                  materialDesign:HintAssist.Hint="Phone number"
                  materialDesign:TextFieldAssist.UnderlineBrush="{StaticResource DarkThemeMouseEnterBut}" 
                  CaretBrush="White" Name="PhoneBox"
                  materialDesign:HintAssist.Foreground="Gray"
                  Style="{StaticResource MaterialDesignFloatingHintTextBox}" />
            </Grid>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                               
                <Button Style="{StaticResource MaterialDesignRaisedButton}" Name="CancelBut"
                    Content="Cancel" Background="Transparent" BorderThickness="0"
                    HorizontalAlignment="Right" Margin="0 0 10 0"
                    MouseEnter="But_MouseEnter" MouseLeave="But_MouseLeave"
                    Foreground="{StaticResource DarkThemeProfileButForeGround}"
                    Click="CancelBut_Click"/>
                
                <Button Style="{StaticResource MaterialDesignRaisedButton}" Name="CreateBut"
                    Content="Create" Background="Transparent" BorderThickness="0"
                    MouseEnter="But_MouseEnter" MouseLeave="But_MouseLeave"
                    HorizontalAlignment="Left"
                    Click="CreateBut_Click"  Margin="10 0 20 0" 
                    Foreground="{StaticResource DarkThemeProfileButForeGround}"/>


            </StackPanel>


        </Grid>

    </Border>
</Page>
