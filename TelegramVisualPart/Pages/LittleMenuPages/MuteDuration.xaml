<Page x:Class="TelegramVisualPart.Pages.LittleMenuPages.MuteDuration"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TelegramVisualPart.Pages.LittleMenuPages"
      xmlns:specListBox="clr-namespace:TelegramVisualPart.UserControls.ContactsControls.AutoDeleteControls"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="350" d:DesignWidth="400"
      Height="350" Width="400"
      Title="MuteDuration">

    <Border Background="{StaticResource DarkThemeOne}"
            CornerRadius="15">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="55"/>
                <RowDefinition/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock Name="PageNameBlock" 
                       Foreground="White" Text="Mute notifications for.."
                       VerticalAlignment="Center" Margin="35 0 0 0" 
                       FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Left"/>

                <Grid HorizontalAlignment="Right" Width="35" Height="35" Margin="0 0 15 0"
                      Name="DotsGrid"
                      Background="Transparent"
                      MouseEnter="DotsGrid_MouseEnter"
                      MouseLeave="DotsGrid_MouseLeave"
                      PreviewMouseDown="DotsGrid_PreviewMouseDown">
                    <materialDesign:PackIcon Name="Dots" Kind="DotsVertical"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Center"
                                             Width="25" Height="25"
                                             Foreground="Gray"/>
                </Grid>
            </Grid>

            <specListBox:SpecialListBox Grid.Row="1" Margin="15 0 15 0"
                                        x:Name="ChooseDate"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0 0 10 10">
                <Button Style="{StaticResource MaterialDesignRaisedButton}" Name="CancelBut"
                            Content="Cancel" Background="Transparent" BorderThickness="0"
                            HorizontalAlignment="Right" Margin="0 0 5 0" FontSize="16"
                            MouseEnter="But_MouseEnter"  MouseLeave="But_MouseLeave"
                            Foreground="{StaticResource TempActiveTextColor}"
                            Click="CancelBut_Click"/>

                <Button Style="{StaticResource MaterialDesignRaisedButton}" Name="MuteBut"
                            Content="Mute" Background="Transparent" BorderThickness="0"
                            MouseEnter="But_MouseEnter"  MouseLeave="But_MouseLeave"
                            HorizontalAlignment="Left" FontSize="16"
                            Click="MuteBut_Click"  Margin="5 0 5 0" 
                            Foreground="{StaticResource TempActiveTextColor}"/>
            </StackPanel>

        </Grid>
    </Border>
</Page>
