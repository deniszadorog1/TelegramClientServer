<Page x:Class="TelegramVisualPart.Pages.LittleMenuPages.CustomMute"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TelegramVisualPart.Pages.LittleMenuPages"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:controls="clr-namespace:TelegramVisualPart.UserControls.ChatControls.LittleMenusContols"
      mc:Ignorable="d" 
      d:DesignHeight="200" d:DesignWidth="350"
      Height="200" Width="400"
      Title="CustomMute">
    <Border Background="{StaticResource DarkThemeOne}"
            CornerRadius="15">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="55"/>
                <RowDefinition/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <TextBlock Name="PageNameBlock" Grid.Row="0"
                       Foreground="White" Text="Mute notifications for.."
                       VerticalAlignment="Center" Margin="35 0 0 0" 
                       FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Left"/>


            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <controls:MuteDurationBox Grid.Column="0" x:Name="DaysBox" Height="50"
                                          HorizontalAlignment="Right"/>
                
                <controls:MuteDurationBox Grid.Column="1" x:Name="HoursBox" Height="50"/>
                
                <controls:MuteDurationBox Grid.Column="2" x:Name="MinutesBox" Height="50"
                                          HorizontalAlignment="Left"/>

            </Grid>
            

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0 0 10 10">
                <Button Style="{StaticResource MaterialDesignRaisedButton}" Name="CancelBut"
                            Content="Cancel" Background="Transparent" BorderThickness="0"
                            HorizontalAlignment="Right" Margin="0 0 5 0" FontSize="16"
                            MouseEnter="But_MouseEnter"  MouseLeave="But_MouseLeave"
                            Foreground="{StaticResource TempActiveTextColor}"
                            Click="CancelBut_Click"/>

                <Button Style="{StaticResource MaterialDesignRaisedButton}" Name="MuteBut"
                            Content="Mute" Background="Transparent" BorderThickness="0"
                            MouseEnter="But_MouseEnter"  MouseLeave="But_MouseLeave"
                            HorizontalAlignment="Left" FontSize="16"
                            Click="MuteBut_Click"  Margin="5 0 5 0" 
                            Foreground="{StaticResource TempActiveTextColor}"/>
            </StackPanel>

        </Grid>
    </Border>
</Page>
