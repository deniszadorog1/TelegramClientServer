<Page x:Class="TelegramVisualPart.Pages.Other.InfoMessage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TelegramVisualPart.Pages.Other"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="400"
      Height="450" Width="400"
      Title="InfoMessage">

    <Border CornerRadius="15" Background="{StaticResource DarkThemeOne}">
        <TextBlock Name="InfoText" Text="Text example Text example Text example Text example Text example Text example Text example"
                   Margin="50 0 50 0"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   TextWrapping="Wrap" FontSize="18"
                   Foreground="White"
                   Padding="0 0 0 100"/>
    </Border>
</Page>
