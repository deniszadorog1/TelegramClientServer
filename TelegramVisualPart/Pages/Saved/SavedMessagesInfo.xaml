<Page x:Class="TelegramVisualPart.Pages.Saved.SavedMessagesInfo"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TelegramVisualPart.Pages.Saved"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:butsControls="clr-namespace:TelegramVisualPart.UserControls"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="300"
      Title="SavedMessagesInfo"
      
      Background="{StaticResource DarkThemeOne}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="250"/>
            <RowDefinition Height="10"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Saved Messages" VerticalAlignment="Center" HorizontalAlignment="Left"
                           Margin="10 0 0 0" Foreground="White"/>

                <Grid Grid.Row ="1">
                    <TextBlock  Margin="10 0 0 0" Text="chat amount" Foreground="White" FontSize="10"/>
                </Grid>
            </Grid>

            <materialDesign:PackIcon Kind="Close" Grid.Column ="1" HorizontalAlignment="Right" 
                                     VerticalAlignment="Center" Margin="10" Foreground="Gray"
                                     MouseEnter="PackIcon_MouseEnter" MouseLeave="PackIcon_MouseLeave"
                                     Width="20" Height="20" />
        </Grid>

        <StackPanel Grid.Row="1">
            <butsControls:IconTextBut x:Name="Images" Margin="0" PreviewMouseDown="Buts_PreviewMouseDown"/>
            <butsControls:IconTextBut x:Name="Videos" Margin="0" PreviewMouseDown="Buts_PreviewMouseDown"/>
            <butsControls:IconTextBut x:Name="Files" Margin="0" PreviewMouseDown="Buts_PreviewMouseDown"/>
            <butsControls:IconTextBut x:Name="AudioFiles" Margin="0" PreviewMouseDown="Buts_PreviewMouseDown"/>
            <butsControls:IconTextBut x:Name="SharedLinks" Margin="0" PreviewMouseDown="Buts_PreviewMouseDown"/>
            <butsControls:IconTextBut x:Name="VoiceMessages" Margin="0" PreviewMouseDown="Buts_PreviewMouseDown" />
            <butsControls:IconTextBut x:Name="Gifs" Margin="0" PreviewMouseDown="Buts_PreviewMouseDown"/>
        </StackPanel>

        <Grid Grid.Row="2" Background="{StaticResource DarkThemeDeviderField}"/>

    </Grid>
</Page>
