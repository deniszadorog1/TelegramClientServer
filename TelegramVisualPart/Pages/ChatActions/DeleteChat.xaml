<Page x:Class="TelegramVisualPart.Pages.ChatActions.DeleteChat"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TelegramVisualPart.Pages.ChatActions"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="270" d:DesignWidth="350"
      Height="270" Width="350"
      Title="DeleteChat">

    <Border Name="BorderBg" Background="{StaticResource DarkThemeOne}" CornerRadius="10">
        <Grid Margin="25 10 5 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="55"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Grid.Column="0" VerticalAlignment="Bottom"
                Name="UserEllipseImage" Width="50" Height="50">
                    <Ellipse.Fill>
                        <ImageBrush x:Name="BgBrush" ImageSource="/Visuals/Images/UserImages/Minato.jpg"/>
                    </Ellipse.Fill>
                </Ellipse>

                <TextBlock Margin="10 0 0 0" VerticalAlignment="Center"
                       Foreground="White" FontSize="20" FontWeight="SemiBold"
                           Name="PageName"/>
            </StackPanel>

            <TextBlock Grid.Row="1" Foreground="White" TextWrapping="Wrap" 
                       FontSize="17" Margin="0 10 20 0 ">
                <Run Name="FirstInfoText" Text="Are you sure you want to delete all message history with "/>
                <Run Name="FirstUsername" Text="Username"/>
                <Run Name ="QuestText" Text="?"/>
            </TextBlock>

            <TextBlock Grid.Row="2" Foreground="White" TextWrapping="Wrap"
                       VerticalAlignment="Bottom" FontSize="17"
                       Text="This action cannot be undone."
                       Name="SecInfoText"/>

            <StackPanel Name="BothCheckPanel"
                        Grid.Row="3" Orientation="Horizontal" 
                        Height="30" Margin="-3 0 0 0"
                        Visibility="Visible" Background="Transparent"
                        PreviewMouseDown="BothCheckPanel_PreviewMouseDown"
                        MouseEnter="BothCheckPanel_MouseEnter"
                        MouseLeave="BothCheckPanel_MouseLeave">
                <CheckBox Style="{StaticResource MaterialDesignCheckBox}"  
                          Name="ShowChatNameBox" Margin="0 0 5 0"
                          Background="{StaticResource TempActiveTextColor}"
                          IsChecked="False" IsHitTestVisible="False"                    
                          materialDesign:CheckBoxAssist.CheckBoxSize="28"/>

                <TextBlock Foreground="White" FontSize="17" VerticalAlignment="Center">
                    <Run Name="CheckBoxText" Text="Also delete for"/>
                    <Run Name="UsernameRunBlock" Text="USERNAME"/>
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Row="4" Orientation="Horizontal" 
                        HorizontalAlignment="Right" Margin="0 15 10 5">
                <Button Style="{StaticResource MaterialDesignRaisedButton}" Name="CancelBut"
                            Content="Cancel" Background="Transparent" BorderThickness="0"
                            HorizontalAlignment="Right" Margin="0 0 5 0" FontSize="14"
                            MouseEnter="CancelBut_MouseEnter"  MouseLeave="CancelBut_MouseLeave"
                            Foreground="{StaticResource TempActiveTextColor}"
                            Click="CancelBut_Click"/>

                <Button Style="{StaticResource MaterialDesignRaisedButton}" Name="DeleteBut"
                            Content="Delete" Background="Transparent" BorderThickness="0"
                            MouseEnter="DeleteBut_MouseEnter"  MouseLeave="DeleteBut_MouseLeave"
                            HorizontalAlignment="Left" FontSize="14"
                            Click="DeleteBut_Click"  Margin="5 0 5 0" 
                            Foreground="{StaticResource CloseWindowColor}"/>
            </StackPanel>

        </Grid>
    </Border>
</Page>
