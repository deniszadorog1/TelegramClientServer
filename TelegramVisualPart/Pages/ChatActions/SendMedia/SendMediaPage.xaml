<Page x:Class="TelegramVisualPart.Pages.ChatActions.SendMedia.SendMediaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TelegramVisualPart.Pages.ChatActions.SendMedia"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:Emoji="clr-namespace:TelegramVisualPart.UserControls.ChatControls.Emojis"
      xmlns:MediaEls="clr-namespace:TelegramVisualPart.UserControls.ChatsControls.ToSendMedias"
      mc:Ignorable="d" 
      d:DesignHeight="470" d:DesignWidth="400"
      Height="470" Width="400"
      Title="SendMediaPage">

    <Border CornerRadius="10"
            Background="{StaticResource DarkThemeOne}">

        <Grid>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="220"/>
                    <RowDefinition/>
                    <RowDefinition Height="50 "/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Name="UpperRowGrid">
                    <TextBlock Grid.Column="1" Margin="30 0 0 0"
                           Name="PageNameBlock" Text="To Send Media"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource UsualTextColor}"
                           FontSize="20"/>

                    <Grid Name="CloseButGrid"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Right"
                          Margin="0 0 25 0"
                          Width="30" Height="30"
                          Background="Transparent"
                          MouseEnter="CloseButGrid_MouseEnter"
                          MouseLeave="CloseButGrid_MouseLeave"
                          PreviewMouseDown="CloseButGrid_PreviewMouseDown">
                        <materialDesign:PackIcon Name="CloseBut"
                                                 Kind="Close"
                                                 Foreground="Gray"
                                                 Height="30" Width="30"/>
                    </Grid>
                </Grid>

                <Grid Grid.Row="1" Name="MeidaRowGrid" Margin="0 5 0 5">
                    <Grid Margin="30 0 30 0" Background="{StaticResource DarkThemeSecond}">
                        <ListBox Name="MediasBox" Width="300" Height="170"
                                 Margin="10 10 10 10">

                            
                        </ListBox>

                        <Grid Name="GroupImgGrid"
                              Visibility="Hidden">
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="OneMedRow"/>
                                <RowDefinition x:Name="TwoMedRow"/>
                                <RowDefinition x:Name="ThreeMedRow"/>
                                <RowDefinition x:Name="FourMedRow"/>
                                <RowDefinition x:Name="FiveMedRow"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="OneMedCol"/>
                                <ColumnDefinition x:Name="TwoMedCol"/>
                            </Grid.ColumnDefinitions>

                            <MediaEls:MediaElBoxItem x:Name="OneMedia" Grid.Row="0" Grid.Column="0"/>
                            <MediaEls:MediaElBoxItem x:Name="TwoMedia" Grid.Row="0" Grid.Column="1"/>

                            <MediaEls:MediaElBoxItem x:Name="ThreeMedia" Grid.Row="1" Grid.Column="0"/>
                            <MediaEls:MediaElBoxItem x:Name="FourMedia" Grid.Row="1" Grid.Column="1"/>

                            <MediaEls:MediaElBoxItem x:Name="FiveMedia" Grid.Row="2" Grid.Column="0"/>
                            <MediaEls:MediaElBoxItem x:Name="SixMedia" Grid.Row="2" Grid.Column="1"/>

                            <MediaEls:MediaElBoxItem x:Name="SevenMedia" Grid.Row="3" Grid.Column="0"/>
                            <MediaEls:MediaElBoxItem x:Name="EightMedia" Grid.Row="3" Grid.Column="1"/>

                            <MediaEls:MediaElBoxItem x:Name="NineMedia" Grid.Row="4" Grid.Column="0"/>
                            <MediaEls:MediaElBoxItem x:Name="TenMedia" Grid.Row="4" Grid.Column="1"/>
                        </Grid>

                    </Grid>
                </Grid>


                <Grid Grid.Row="2" Name="CheckBoxes" Margin="25 0 0 0">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <CheckBox Grid.Row="0" Name="CompressImage"
                              Content="Compress the image" 
                              Background="{StaticResource TempActiveTextColor}"
                              Foreground="{StaticResource UsualTextColor}"
                              FontSize="16"
                              materialDesign:CheckBoxAssist.CheckBoxSize="25"
                              Checked="CompressImage_Checked"/>

                    <CheckBox Grid.Row="1" Name="GroupItems"
                              Content="Group items"
                              Foreground="{StaticResource UsualTextColor}"
                              Background="{StaticResource TempActiveTextColor}"
                              FontSize="16"
                              materialDesign:CheckBoxAssist.CheckBoxSize="25"
                              Checked="GroupItems_Checked"
                              Unchecked="GroupItems_Unchecked"/>

                    <CheckBox Grid.Row="2" Name="RememberChoice"
                              Content="Remember this choise"
                              Foreground="{StaticResource UsualTextColor}"
                              Background="{StaticResource TempActiveTextColor}"
                              FontSize="16"
                              materialDesign:CheckBoxAssist.CheckBoxSize="25"
                              Checked="RememberChoice_Checked"/>
                </Grid>

                <Grid Grid.Row="3" Name ="TextBoxGrid" Margin="25 5 20 5">
                    <TextBox Name="CaptureBox" 
                             
                        BorderThickness="0"
                        BorderBrush="Transparent"      
                             
                        Foreground="{StaticResource UsualTextColor}" 
                         FontSize="16"

                        Padding="0"
                        materialDesign:HintAssist.Hint="Capture"
                         
                        materialDesign:HintAssist.Foreground="Gray"
                        CaretBrush="{StaticResource UsualTextColor}" 
                                                                       
                        materialDesign:TextFieldAssist.UnderlineBrush="{StaticResource TempActiveTextColor}"/>


                    <Grid Name="SmileGrid"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Right"
                      Width="35" Height="35"
                      Background="Transparent"
                      MouseEnter="SmileGrid_MouseEnter"
                      MouseLeave="SmileGrid_MouseLeave"
                      PreviewMouseDown="SmileGrid_PreviewMouseDown">
                        <materialDesign:PackIcon Name="SmileIcon"
                                             Kind="SmileyOutline" 
                                             Width="32" Height="32"
                                             Foreground="Gray"/>
                    </Grid>

                </Grid>


                <Grid Grid.Row="4" Name="BotButsGrid">

                    <Button Height="30" Content="Add" Background="Transparent"
                            BorderThickness="0" Margin="25 0 0 0"
                            HorizontalAlignment="Left"
                            Name="AddBut" FontSize="16"
                            Foreground="{StaticResource TempActiveTextColor}"
                            MouseEnter="BottomBut_MouseEnter"
                            MouseLeave="BottomBut_MouseLeave"
                            PreviewMouseDown="AddBut_PreviewMouseDown"/>

                    <StackPanel HorizontalAlignment="Right" 
                            VerticalAlignment="Center"
                            Margin="0 0 20 0"
                            Orientation="Horizontal">
                        <Button Height="30" Content="Cancel" Background="Transparent"
                                BorderThickness="0" FontSize="16"
                                HorizontalAlignment="Right"
                                Name="CancelBut" Margin="0 0 10 0"
                                Foreground="{StaticResource TempActiveTextColor}"
                                MouseEnter="BottomBut_MouseEnter"
                                MouseLeave="BottomBut_MouseLeave"
                                PreviewMouseDown="CancelBut_PreviewMouseDown"/>

                        <Button Height="30" Content="Send" Background="Transparent"
                                BorderThickness="0"
                                HorizontalAlignment="Right"
                                Name="SendBut" FontSize="16"
                                Foreground="{StaticResource TempActiveTextColor}"
                                MouseEnter="BottomBut_MouseEnter"
                                MouseLeave="BottomBut_MouseLeave"
                                PreviewMouseDown="SendBut_PreviewMouseDown"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <Emoji:EmojisBlock x:Name="SmileBlock"
                               Visibility="Hidden"
                               VerticalAlignment="Top" Height="300"
                               HorizontalAlignment="Right"
                               Margin="20 30 20 0" 
                               MouseLeave="SmileBlock_MouseLeave"/>

        </Grid>
    </Border>
</Page>
