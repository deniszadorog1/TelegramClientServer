<Page x:Class="TelegramVisualPart.Pages.ChatActions.ClearChatHistory"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TelegramVisualPart.Pages.ChatActions"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="270" d:DesignWidth="350"
      Height="270" Width="350"
      Title="ClearChatHistory">

    <Border Name="BorderBg" Background="{StaticResource DarkThemeOne}" CornerRadius="10">
        <Grid Margin="25 20 25 10">
            <Grid.RowDefinitions>
                <RowDefinition Height="55"/>
                <RowDefinition Height="40"/>
                <RowDefinition Name="BothPanelRow" Height="60"/>
                <RowDefinition Name="EnAutoDeleteRow"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Margin="0 0 0 0" VerticalAlignment="Center" TextWrapping="Wrap" 
                       Foreground="White" FontSize="17">
                <Run Name="FirstInfoText" />
                <Run Name="UsernameBlock" Text="USERNAME"/>
            </TextBlock>

            <TextBlock Grid.Row="1" Foreground="White" TextWrapping="Wrap"
                       VerticalAlignment="Bottom" FontSize="17"
                       Name="SecondInfoText"/>

            <StackPanel Name="BothPanel"
                        Grid.Row="2" Margin="0 5 0 0" 
                        Height="20" Orientation="Horizontal"
                        Background="Transparent"
                        PreviewMouseDown="BothPanel_PreviewMouseDown"
                        MouseEnter="BothPanel_MouseEnter"
                        MouseLeave="BothPanel_MouseLeave">
                <CheckBox   Style="{StaticResource MaterialDesignCheckBox}"  
                            Name="ShowChatNameBox" Padding="5 0 0 0" 
                            Background="{StaticResource TempActiveTextColor}"
                            IsChecked="False" FontSize="17" IsHitTestVisible="False"                              
                            materialDesign:CheckBoxAssist.CheckBoxSize="22"/>

                <TextBlock FontSize="17" Foreground="White" >
                    <Run Name ="CheckBoxText"/>
                    <Run Name="UsernameCheckBoxBlock" Text="USERNAME"/>
                </TextBlock>
            </StackPanel>


            <TextBlock Grid.Row="3" VerticalAlignment="Center"
                       Foreground="{StaticResource TempActiveTextColor}" FontSize="17"
                       Name="EnAutoDelete" PreviewMouseDown="EnAutoDelete_PreviewMouseDown"
                       MouseEnter="EnAutoDelete_MouseEnter" MouseLeave="EnAutoDelete_MouseLeave"/>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource MaterialDesignRaisedButton}" Name="CancelBut"
                            Content="Cancel" Background="Transparent" BorderThickness="0"
                            HorizontalAlignment="Right" Margin="0 0 5 0" FontSize="16"
                            MouseEnter="CancelBut_MouseEnter"  MouseLeave="CancelBut_MouseLeave"
                            Foreground="{StaticResource TempActiveTextColor}"
                            Click="CancelBut_Click"/>

                <Button Style="{StaticResource MaterialDesignRaisedButton}" 
                        Name="DeleteBut"
                        Content="Delete" Background="Transparent" 
                        BorderThickness="0"
                        MouseEnter="DeleteBut_MouseEnter"  
                        MouseLeave="DeleteBut_MouseLeave"
                        HorizontalAlignment="Left" FontSize="16"
                        Click="DeleteBut_Click"  Margin="5 0 5 0" 
                        Foreground="{StaticResource CloseWindowColor}"/>
            </StackPanel>

        </Grid>
    </Border>
</Page>
