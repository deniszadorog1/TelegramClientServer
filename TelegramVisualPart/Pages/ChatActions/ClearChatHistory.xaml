<Page x:Class="TelegramVisualPart.Pages.ChatActions.ClearChatHistory"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TelegramVisualPart.Pages.ChatActions"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="270" d:DesignWidth="350"
      Height="270" Width="350"
      Title="ClearChatHistory">

    <Border Name="BorderBg" Background="{StaticResource DarkThemeOne}" CornerRadius="10">
        <Grid Margin="15 10 15 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="55"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="60"/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Margin="0 0 0 0" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="Are you sure you want to delete all message history with USERNAME" 
                       Foreground="White" FontSize="14"/>

            <TextBlock Grid.Row="1" Foreground="White" TextWrapping="Wrap"
                       VerticalAlignment="Bottom" FontSize="14"
                       Text="This action cannot be undone."/>

            <CheckBox   Style="{StaticResource MaterialDesignCheckBox}" Foreground="White"  
                            Content="Also delete for USERNAME" Grid.Row="2"
                            Name="ShowChatNameBox" Margin="0 5 0 0"
                            Background="{StaticResource DarkThemeProfileButForeGround}"
                            IsChecked="False" FontSize="14"                               
                            materialDesign:CheckBoxAssist.CheckBoxSize="22"/>

            <TextBlock Grid.Row="3" Text="Enable Auto-Delete" VerticalAlignment="Center"
                       Foreground="{StaticResource TempActiveTextColor}" FontSize="14"
                       Name="EnAutoDelete" PreviewMouseDown="EnAutoDelete_PreviewMouseDown"
                       MouseEnter="EnAutoDelete_MouseEnter" MouseLeave="EnAutoDelete_MouseLeave"/>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource MaterialDesignRaisedButton}" Name="CancelBut"
                            Content="Cancel" Background="Transparent" BorderThickness="0"
                            HorizontalAlignment="Right" Margin="0 0 5 0" FontSize="14"
                            MouseEnter="CancelBut_MouseEnter"  MouseLeave="CancelBut_MouseLeave"
                            Foreground="{StaticResource DarkThemeProfileButForeGround}"
                            Click="CancelBut_Click"/>

                <Button Style="{StaticResource MaterialDesignRaisedButton}" Name="DeleteBut"
                            Content="Delete" Background="Transparent" BorderThickness="0"
                            MouseEnter="DeleteBut_MouseEnter"  MouseLeave="DeleteBut_MouseLeave"
                            HorizontalAlignment="Left" FontSize="14"
                            Click="DeleteBut_Click"  Margin="5 0 5 0" 
                            Foreground="{StaticResource CloseWindowColor}"/>
            </StackPanel>

        </Grid>
    </Border>
</Page>
