<Page x:Class="TelegramVisualPart.Pages.ChatActions.MessageMenuPages.ForRepMenu"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TelegramVisualPart.Pages.ChatActions.MessageMenuPages"
      xmlns:But="clr-namespace:TelegramVisualPart.UserControls.ChatControls.ChatMessages.MessageMenu"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="400"
        Height="500" Width="400"
      
      Title="ForRepMenu">

    <Border Background="{StaticResource DarkThemeSecond}" 
            CornerRadius="10">
        <Grid Margin="0 10 0 10">

            <Grid.RowDefinitions>
                <RowDefinition Name="PageNameRow" Height="50"/>
                <RowDefinition Name="MessagesRow"/>
                <RowDefinition Name="ActionButtonsRow" Height="150"/>
                <RowDefinition Name="NotificationRow" Height="75"/>
                <RowDefinition Name="ExitButtonsRow" Height="50"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Name="PageNameGrid">
                <TextBlock Name="PageNameBlock" 
                           Text="Resend Page message"
                           Margin="20 10 0 0"
                           FontFamily ="{DynamicResource AppFont}"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="SemiBold"/>
            </Grid>

            <ScrollViewer Grid.Row="1"
              VerticalScrollBarVisibility="Auto">
                    <StackPanel Name="MessagesStack"
                    Orientation="Vertical"/>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Name="ActionButtonsStack"
                        Orientation="Vertical">
                <But:MesMenuBut x:Name="HideSenderNameBut" 
                                PreviewMouseLeftButtonDown="HideSenderNameBut_PreviewMouseLeftButtonDown"/>
                
                <But:MesMenuBut x:Name="ChangeRecipient" 
                                PreviewMouseLeftButtonDown="ChangeRecipient_PreviewMouseLeftButtonDown"/>

                <But:MesMenuBut x:Name="ShowMessage" 
                                PreviewMouseLeftButtonDown="ShowMessage_PreviewMouseLeftButtonDown"/>

                <But:MesMenuBut x:Name="DoNotSend" 
                                PreviewMouseLeftButtonDown="DoNotSend_PreviewMouseLeftButtonDown"/>
            </StackPanel>
            
            
            <Grid Grid.Row="3" Name="NotificationPageGrid" 
                  Background="{StaticResource DarkThemeOne}">

                <TextBlock Name="NotificationBlock" 
                           Text="You can remove the senders name so that this will look like it was sent by you"
                           TextWrapping="Wrap"
                           FontSize="17"
                           Foreground="Gray"
                           Margin="15 5 15 0"
                           FontFamily="{DynamicResource AppFont}"/>
            </Grid>
            
            
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0 5 10 5">
                <Button Style="{StaticResource MaterialDesignRaisedButton}" 
                        Name="CancelBut"
                        Content="Cancel" 
                        Background="Transparent" 
                        BorderThickness="0"
                        HorizontalAlignment="Right" 
                        Margin="0 0 5 0" 
                        FontSize="16"
                        Foreground="{StaticResource TempActiveTextColor}"
                        PreviewMouseLeftButtonDown="CancelBut_PreviewMouseLeftButtonDown"/>

                <Button Style="{StaticResource MaterialDesignRaisedButton}" 
                        Name="SaveBut"
                        Content="Save" 
                        Background="Transparent" 
                        BorderThickness="0"
                        HorizontalAlignment="Left" 
                        FontSize="16"
                        Margin="5 0 5 0" 
                        Foreground="{StaticResource TempActiveTextColor}"
                        PreviewMouseLeftButtonDown="SaveBut_PreviewMouseLeftButtonDown"/>
            </StackPanel>

        </Grid>
    </Border>
</Page>
