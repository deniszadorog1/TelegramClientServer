<Page x:Class="TelegramVisualPart.Pages.ChatActions.MessageMenuPages.IsMakeActionOnBothSides"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TelegramVisualPart.Pages.ChatActions.MessageMenuPages"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="175" d:DesignWidth="425"
      Height="175" Width="425"
      Title="IsMakeActionOnBothSides">

    <Border CornerRadius="10"
            Background="{StaticResource DarkThemeSecond}">
        <Grid Margin="25 0 0 0">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Name="ActionNameBlock"
                       Foreground="{StaticResource UsualTextColor}"
                       Margin="0 15 0 0" FontSize="18">
                <Run Name="FirstPartAction" Text="Do you want to"/>
                <Run Name="ActionName" Text="ACTION NAME"/>
                <Run Name="SecondPartAction" Text="this message?"/>
            </TextBlock>

            <StackPanel Name="CheckBoxStack"
                        Grid.Row="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        MouseEnter="CheckBoxStack_MouseEnter"
                        MouseLeave="CheckBoxStack_MouseLeave"
                        PreviewMouseDown="CheckBoxStack_PreviewMouseDown">

                <CheckBox Name="IsInBoth" Margin="0 0 5 0"
                          Background="{StaticResource TempActiveTextColor}"
                          materialDesign:CheckBoxAssist.CheckBoxSize="24"
                          IsHitTestVisible="False"/>

                <TextBlock Name="CheckTextBlock"
                           Foreground="{StaticResource UsualTextColor}"
                           FontSize="18" TextWrapping="Wrap">
                    
                    <Run Name="FirstPartCheckText" Text="Also"/>
                    <Run Name="ActionCheckText" Text="ACTION NAME"/>
                    <Run Name="SecondPartCheckText" Text="for"/>
                    <Run Name="LoginPartCheckText" Text="LOGIN"/>
                </TextBlock>

            </StackPanel>
            

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0 5 10 5">
                <Button Style="{StaticResource MaterialDesignRaisedButton}" Name="CancelBut"
                            Content="Cancel" Background="Transparent" BorderThickness="0"
                            HorizontalAlignment="Right" Margin="0 0 5 0" FontSize="16"
                            MouseEnter="CancelBut_MouseEnter"  MouseLeave="CancelBut_MouseLeave"
                            Foreground="{StaticResource TempActiveTextColor}"
                            Click="CancelBut_Click"/>

                <Button Style="{StaticResource MaterialDesignRaisedButton}" Name="DeleteBut"
                            Content="ActionName" Background="Transparent" BorderThickness="0"
                            MouseEnter="DeleteBut_MouseEnter"  
                            MouseLeave="DeleteBut_MouseLeave"
                            HorizontalAlignment="Left" FontSize="16"
                            Click="DeleteBut_Click"  Margin="5 0 5 0" 
                            Foreground="{StaticResource TempActiveTextColor}"/>
            </StackPanel>

        </Grid>
    </Border>
</Page>
