<Page x:Class="TelegramVisualPart.Pages.ChatActions.MessageAutoDeletion.SetCustomTime"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TelegramVisualPart.Pages.ChatActions.MessageAutoDeletion"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:pageControls="clr-namespace:TelegramVisualPart.UserControls.ContactsControls.AutoDeleteControls"      mc:Ignorable="d" 
      xmlns:autoDelControls="clr-namespace:TelegramVisualPart.UserControls.ContactsControls.AutoDeleteControls"
      d:DesignHeight="300" d:DesignWidth="400"
      Height="300" Width="400"
      Title="SetCustomTime">

    <Border Name="BorderBg" CornerRadius="15" Background="{StaticResource DarkThemeOne}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center"
                           Foreground="White" Name="PageNameBlock"
                           FontSize="18" FontWeight="SemiBold" Margin="30 5 0 0"/>
            </Grid>

            <Grid Grid.Row="1">
                <autoDelControls:SpecialListBox x:Name="TimesToChoose"/>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 0 10 10">
                <Button Style="{StaticResource MaterialDesignRaisedButton}" Name="CancelBut"
                            Background="Transparent" BorderThickness="0"
                            HorizontalAlignment="Right" Margin="0 0 5 0" FontSize="16"
                            MouseEnter="But_MouseEnter"  MouseLeave="But_MouseLeave"
                            Foreground="{StaticResource TempActiveTextColor}"
                            Click="CancelBut_Click"/>

                <Button Style="{StaticResource MaterialDesignRaisedButton}" Name="SaveBut"
                            Background="Transparent" BorderThickness="0"
                            MouseEnter="But_MouseEnter"  MouseLeave="But_MouseLeave"
                            HorizontalAlignment="Left" FontSize="16"
                            Click="SaveBut_Click"  Margin="5 0 5 0" 
                            Foreground="{StaticResource TempActiveTextColor}"/>
            </StackPanel>

        </Grid>
    </Border>
</Page>
