<Page x:Class="TelegramVisualPart.Pages.ChatActions.MessageAutoDeletion.SelfDestructTimer"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TelegramVisualPart.Pages.ChatActions.MessageAutoDeletion"
      xmlns:closeBut="clr-namespace:TelegramVisualPart.UserControls.DifferButs"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:pageControls="clr-namespace:TelegramVisualPart.UserControls.ContactsControls.AutoDeleteControls"
      mc:Ignorable="d" 
      d:DesignHeight="465" d:DesignWidth="400"
      Height="465" Width="400"
      Title="SelfDestructTimer">

    <Border Name="BorderBg" CornerRadius="15" Background="{StaticResource DarkThemeOne}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center"
                           Text="Auto-Delete Messages" Foreground="White"
                           FontSize="18" FontWeight="SemiBold" Margin="20 0 0 0"/>

                <closeBut:IconButton x:Name="CloseBut" Width="40" Margin="0 0 10 0"
                                     HorizontalAlignment="Right"
                                     PreviewMouseDown="CloseBut_PreviewMouseDown"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="125"/>
                        <RowDefinition Height="205"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Background="{StaticResource DarkThemeDeviderField}">
                        <materialDesign:PackIcon Kind="Duck" HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Height="100" Width="100"
                                                 Foreground="White"/>
                    </Grid>

                    <StackPanel Grid.Row="1" Name="RadiosGrid"
                                Orientation="Vertical" Margin="20 10 10 0">
                        <TextBlock Text="Self-destruct timer" FontSize="16" 
                                   Foreground="{StaticResource TempActiveTextColor}"/>

                        <pageControls:RadioBut x:Name="OffRadioBut" Margin="0 5 0 0" PreviewMouseDown="DateButton_PreviewMouseDown"/>
                        <pageControls:RadioBut x:Name="OneDayBut" Margin="0 5 0 0" PreviewMouseDown="DateButton_PreviewMouseDown"/>
                        <pageControls:RadioBut x:Name="OneWeekBut" Margin="0 5 0 0" PreviewMouseDown="DateButton_PreviewMouseDown"/>
                        <pageControls:RadioBut x:Name="OneMonthBut" Margin="0 5 0 0" PreviewMouseDown="DateButton_PreviewMouseDown"/>
                        <pageControls:RadioBut x:Name="CustomTimeBut" Margin="0 5 0 0" PreviewMouseDown="CustomTimeBut_PreviewMouseDown"/>
                    </StackPanel>

                    <Grid Grid.Row="2" Background="{StaticResource DarkThemeDeviderField}">
                        <TextBlock FontSize="14" TextWrapping="Wrap" Foreground="Gray" Margin="20 5 10 0">
                            <Run Text="If enabled, all new messages in chats you start will be automaticlly deleted for everyone at some point after they sent. you can also" />
                            <Run Name="SetAutoDeleteToContact" 
                                 Text="apply this settings for your existing chats." 
                                 Foreground="{StaticResource TempActiveTextColor}"
                                 MouseEnter="SetAutoDeleteToContact_MouseEnter"
                                 MouseLeave="SetAutoDeleteToContact_MouseLeave"
                                 PreviewMouseDown="SetAutoDeleteToContact_PreviewMouseDown"/>
                        </TextBlock>

                    </Grid>

                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</Page>
