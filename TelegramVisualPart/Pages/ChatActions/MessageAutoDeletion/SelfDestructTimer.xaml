<Page x:Class="TelegramVisualPart.Pages.ChatActions.MessageAutoDeletion.SelfDestructTimer"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TelegramVisualPart.Pages.ChatActions.MessageAutoDeletion"
      xmlns:closeBut="clr-namespace:TelegramVisualPart.UserControls.DifferButs"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:pageControls="clr-namespace:TelegramVisualPart.UserControls.ContactsControls.AutoDeleteControls"
      mc:Ignorable="d" 
      d:DesignHeight="570" d:DesignWidth="400"
      Height="570" Width="400"
      Title="SelfDestructTimer">

    <Page.Resources>
        <Style TargetType="pageControls:RadioBut">
            <Setter Property="Padding" Value="20 0 30 0"/>
        </Style>
    </Page.Resources>

    <Border Name="BorderBg" CornerRadius="15" Background="{StaticResource DarkThemeOne}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="65"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center"
                           Foreground="White"
                           Name="PageNameBlock"
                           FontSize="20" FontWeight="SemiBold" Margin="20 0 0 0"/>

                <closeBut:IconButton x:Name="CloseBut" Height="25" Width="25" Margin="0 0 25 0"
                                     HorizontalAlignment="Right"
                                     PreviewMouseDown="CloseBut_PreviewMouseDown"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="125"/>
                        <RowDefinition Height="255"/>
                        <RowDefinition/>
                        <RowDefinition Height="15"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Background="{StaticResource DarkThemeDeviderField}">
                        <materialDesign:PackIcon Kind="Duck" HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Height="100" Width="100"
                                                 Foreground="White"/>
                    </Grid>

                    <StackPanel Grid.Row="1" Name="RadiosGrid"
                                Orientation="Vertical" Margin="0 10 10 0">
                        <TextBlock Text="Self-destruct timer" FontSize="18" Margin="20 5 0 5"
                                   Foreground="{StaticResource TempActiveTextColor}"/>

                        <pageControls:RadioBut x:Name="OffRadioBut" PreviewMouseDown="DateButton_PreviewMouseDown"/>
                        <pageControls:RadioBut x:Name="OneDayBut" PreviewMouseDown="DateButton_PreviewMouseDown"/>
                        <pageControls:RadioBut x:Name="OneWeekBut" PreviewMouseDown="DateButton_PreviewMouseDown"/>
                        <pageControls:RadioBut x:Name="OneMonthBut" PreviewMouseDown="DateButton_PreviewMouseDown"/>
                        <pageControls:RadioBut x:Name="CustomTimeBut" PreviewMouseDown="CustomTimeBut_PreviewMouseDown"/>
                    </StackPanel>

                    <Grid Grid.Row="2" Background="{StaticResource DarkThemeDeviderField}">
                        <TextBlock FontSize="16" TextWrapping="Wrap" Foreground="Gray" Margin="20 5 15 0">
                            <Run Name="InActiveInfoText"/>
                            <Run Name="SetAutoDeleteToContact" 
                                 Foreground="{StaticResource TempActiveTextColor}"
                                 MouseEnter="SetAutoDeleteToContact_MouseEnter"
                                 MouseLeave="SetAutoDeleteToContact_MouseLeave"
                                 PreviewMouseDown="SetAutoDeleteToContact_PreviewMouseDown"/>
                        </TextBlock>

                    </Grid>

                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</Page>
