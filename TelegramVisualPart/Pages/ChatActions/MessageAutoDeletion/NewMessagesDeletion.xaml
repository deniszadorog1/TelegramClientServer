<Page x:Class="TelegramVisualPart.Pages.ChatActions.MessageAutoDeletion.NewMessagesDeletion"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TelegramVisualPart.Pages.ChatActions.MessageAutoDeletion"
      xmlns:autoDelControls="clr-namespace:TelegramVisualPart.UserControls.ContactsControls.AutoDeleteControls"
      mc:Ignorable="d" 
      d:DesignHeight="410" d:DesignWidth="350"
      Height="410" Width="350"
      Title="NewMessagesDeletion"
      Loaded="Page_Loaded">

    <Page.Resources>
        <Style x:Key="UpperTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Page.Resources>

    <Border x:Name="BorderBg" Background="{StaticResource DarkThemeOne}"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="200"/>
                <RowDefinition/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="25 15 25 0">
                <TextBlock Name="PageNameBlock" Style="{StaticResource UpperTextStyle}" 
                           FontSize="20" FontWeight="SemiBold"/>

                <TextBlock Style="{StaticResource UpperTextStyle}" FontSize="17"
                           Margin="0 10 0 0" Name="InfoText"/>

                <TextBlock Style="{StaticResource UpperTextStyle}" 
                   FontSize="17" 
                   Margin="0 20 0 0"
                   TextWrapping="Wrap">
                        <Run Name="InActiveFirstPart"/>
                        <Run Name="SetDestructBut"
                             Foreground="{StaticResource TempActiveTextColor}"
                             MouseEnter="SetDestructBut_MouseEnter" 
                             MouseLeave="SetDestructBut_MouseLeave" 
                             PreviewMouseDown="SetDestructBut_PreviewMouseDown"/>
                        <Run  Name="InActiveEndPart"/>
                </TextBlock>

            </StackPanel>

            <Grid Grid.Row="1">
                <autoDelControls:SpecialListBox x:Name="SpecialList"/>
            </Grid>


            <Grid Grid.Row="4">

                <Button Style="{StaticResource MaterialDesignRaisedButton}" Name="RemoveBut"
                            Background="Transparent" BorderThickness="0" Content="Remove"
                            HorizontalAlignment="Left" Margin="15 0 5 0" FontSize="16"
                            MouseEnter="But_MouseEnter"  MouseLeave="But_MouseLeave"
                            Foreground="{StaticResource TempActiveTextColor}"
                            Click="RemoveBut_Click"/>


                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 0 10 10">
                    <Button Style="{StaticResource MaterialDesignRaisedButton}" Name="CancelBut"
                            Background="Transparent" BorderThickness="0" Content="Cancel"
                            HorizontalAlignment="Right" Margin="0 0 5 0" FontSize="16"
                            MouseEnter="But_MouseEnter"  MouseLeave="But_MouseLeave"
                            Foreground="{StaticResource TempActiveTextColor}"
                            Click="CancelBut_Click"/>

                    <Button Style="{StaticResource MaterialDesignRaisedButton}" Name="SaveBut"
                            Background="Transparent" BorderThickness="0" Content="Save"
                            MouseEnter="But_MouseEnter"  MouseLeave="But_MouseLeave"
                            HorizontalAlignment="Left" FontSize="16"
                            Click="SaveBut_Click"  Margin="5 0 5 0" 
                            Foreground="{StaticResource TempActiveTextColor}"/>
                </StackPanel>
            </Grid>
            
        </Grid>
    </Border>
</Page>
