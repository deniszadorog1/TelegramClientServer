<Page x:Class="TelegramVisualPart.Pages.ChatActions.MessageAutoDeletion.NewMessagesDeletion"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TelegramVisualPart.Pages.ChatActions.MessageAutoDeletion"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="400"
      Height="450" Width="400"
      Title="NewMessagesDeletion"
      Loaded="Page_Loaded">

    <Border x:Name="BorderBg" Background="{StaticResource DarkThemeOne}"
            CornerRadius="10">
        <Grid>

            <!-- Затемнение сверху -->
            <Rectangle VerticalAlignment="Top" Height="80"
                   Fill="Black" Opacity="0.3" />

            <!-- Затемнение снизу -->
            <Rectangle VerticalAlignment="Bottom" Height="80"
                   Fill="Black" Opacity="0.3" />

            <!-- Список -->
            <ListBox Name="DaysListBox"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Center"
                 Width="150"
                 Height="200"
                 Background="Transparent"
                 BorderThickness="0"
                 Foreground="LightGray"
                 FontSize="18"
                 ScrollViewer.VerticalScrollBarVisibility="Hidden"
                 SelectionMode="Single"
                 Loaded="DaysListBox_Loaded"
                 SelectionChanged="DaysListBox_SelectionChanged">
            </ListBox>

            <!-- Синие линии вокруг выделенного -->
            <Grid VerticalAlignment="Center" Height="40" IsHitTestVisible="False">
                <Rectangle Fill="LightSkyBlue" Height="2" VerticalAlignment="Top" Margin="10,0"/>
                <Rectangle Fill="LightSkyBlue" Height="2" VerticalAlignment="Bottom" Margin="10,0"/>
            </Grid>
        </Grid>
    </Border>
</Page>
