<Page x:Class="TelegramVisualPart.Pages.ChatActions.PinMessagePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TelegramVisualPart.Pages.ChatActions"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="150" d:DesignWidth="300"
      Title="PinMessagePage">

    <Border CornerRadius="5"
            Background="{StaticResource DarkThemeSecond}">
        <Grid Margin="15 0 0 0">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Name="PinInfo"
                       Text="Would you like to pin this message?"
                       Foreground="{StaticResource UsualTextColor}"
                       VerticalAlignment="Center" FontSize="14"/>

            <StackPanel Grid.Row="1" VerticalAlignment="Center"
                        Orientation="Horizontal">
                <CheckBox/>
                <TextBlock Name="CheckBoxText" Margin="5 0 0 0" FontSize="14"
                           Foreground="{StaticResource UsualTextColor}">
                    <Run Text="Pin for" Name="PinForInfo"/>
                    <Run Text="USERLOGIN" Name="PinForUserLogin"/>
                </TextBlock>
            </StackPanel>


            <StackPanel Grid.Row="4" Orientation="Horizontal" 
                        HorizontalAlignment="Right" Margin="0 15 10 5">
                <Button Style="{StaticResource MaterialDesignRaisedButton}" Name="CancelBut"
                            Content="Cancel" Background="Transparent" BorderThickness="0"
                            HorizontalAlignment="Right" Margin="0 0 5 0" FontSize="14"
                            MouseEnter="But_MouseEnter"  MouseLeave="But_MouseLeave"
                            Foreground="{StaticResource TempActiveTextColor}"
                            Click="CancelBut_Click"/>

                <Button Style="{StaticResource MaterialDesignRaisedButton}" Name="ActionBut"
                            Content="Pin" Background="Transparent" BorderThickness="0"
                            MouseEnter="But_MouseEnter"  MouseLeave="But_MouseLeave"
                            HorizontalAlignment="Left" FontSize="14"
                            Click="ActionBut_Click"  Margin="5 0 5 0" 
                            Foreground="{StaticResource TempActiveTextColor}"/>
            </StackPanel>



        </Grid>
    </Border>
</Page>
