<Page x:Class="TelegramVisualPart.Pages.ToChooseChats"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TelegramVisualPart.Pages"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:controls="clr-namespace:TelegramVisualPart.UserControls.SettingsControls.AutoDeleteMessages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="400"
      Height="450" Width="400"
      Title="AutoDeleteForUsers">

    <Border Name="BorderBg" Background="{StaticResource DarkThemeOne}" CornerRadius="15">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="65"/>
                <RowDefinition/>
                <RowDefinition Height="65"/>
            </Grid.RowDefinitions>

            <TextBlock Name="PageName" Grid.Row="0"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Margin="20 0 0 0"
                       Foreground="{StaticResource UsualTextColor}"
                       FontSize="20"
                       Text="Auto-Delete Messages"/>
            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Hidden">
                <Grid>
                    <materialDesign:PackIcon Name="MagnIcon" Kind="Magnify"
                                             Height="25" Width="25"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Left"
                                             Margin="20 0 0 0"
                                             Foreground="Gray"/>

                    <StackPanel Margin="10 5 10 5" Name="ChatsPanel"
                                Orientation="Horizontal">
                        <TextBox Margin="0" Height="40"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Grid Grid.Row="2" Background="{StaticResource DarkThemeSecond}">
                <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Name="ChatsPanelToChoose">
                        <!--<controls:ChatToApply x:Name="FirstTest" PreviewMouseDown="TestParam_PreviewMouseDown"/>
                        <controls:ChatToApply x:Name="SecondTest" PreviewMouseDown="TestParam_PreviewMouseDown"/>
                        <controls:ChatToApply x:Name="ThirdTest" PreviewMouseDown="TestParam_PreviewMouseDown"/>
                        <controls:ChatToApply x:Name="FourthTest" PreviewMouseDown="TestParam_PreviewMouseDown"/>-->
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0 0 10 10">
                <Button Style="{StaticResource MaterialDesignRaisedButton}" Name="CancelBut"
                            Content="Cancel" Background="Transparent" BorderThickness="0"
                            HorizontalAlignment="Right" Margin="0 0 5 0" FontSize="16"
                            MouseEnter="But_MouseEnter"  MouseLeave="But_MouseLeave"
                            Foreground="{StaticResource TempActiveTextColor}"
                            Click="CancelBut_Click"/>

                <Button Style="{StaticResource MaterialDesignRaisedButton}" Name="ApplyBut"
                            Content="Apply" Background="Transparent" BorderThickness="0"
                            MouseEnter="But_MouseEnter"  MouseLeave="But_MouseLeave"
                            HorizontalAlignment="Left" FontSize="16"
                            Click="ApplyBut_Click"  Margin="5 0 5 0" 
                            Foreground="{StaticResource TempActiveTextColor}"/>
            </StackPanel>
        </Grid>
    </Border>
</Page>
