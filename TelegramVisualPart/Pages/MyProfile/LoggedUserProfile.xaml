<Page x:Class="TelegramVisualPart.Pages.LoggedUserProfile"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TelegramVisualPart.Pages"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:iconBut="clr-namespace:TelegramVisualPart.UserControls.DifferButs"
      mc:Ignorable="d" 
      d:DesignHeight="550" d:DesignWidth="475"
      Height="550" Width="475"
      VerticalAlignment="Top" HorizontalAlignment="Center"
      Margin="0 50 0 0"
      Title="LoggedUserProfile">

    <Border Background="{StaticResource DarkThemeOne}" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="75"/>
                <RowDefinition Height="100"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="140"/>
                <RowDefinition Height="10"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="My Profile"
                           FontSize="20" VerticalAlignment="Center"
                           HorizontalAlignment="Left" Margin="25 0 0 0"
                           Foreground="White" FontFamily="Segoe UI"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center" 
                            Margin="0 0 10 0 ">

                    <iconBut:IconButton Width="25" Height="25" x:Name="SettingsBut"
                                        PreviewMouseDown="SettingsBut_PreviewMouseDown"/>
                    
                    <iconBut:IconButton Width="25" Height="25" x:Name="CloseBut" Margin="20 0 0 0"
                                        PreviewMouseDown="CloseBut_PreviewMouseDown"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0" Width="80" Height="80" Margin="10 0 0 0"
                         MouseEnter="Ellipse_MouseEnter"
                         MouseLeave="Ellipse_MouseLeave"
                         PreviewMouseDown="Ellipse_PreviewMouseDown">
                    <Ellipse.Fill>
                        <ImageBrush x:Name="UserImage"  ImageSource="/Visuals/Images/UserImages/Minato.jpg"/>
                    </Ellipse.Fill>
                </Ellipse>

                <Grid Grid.Column="1" Margin="10 0 0 0">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Name="UserLoginBlock" Text="User login" Margin="5 0 0 5"
                               VerticalAlignment="Bottom" HorizontalAlignment="Left"
                               FontSize="20" Foreground="White"/>

                    <TextBlock Grid.Row="1" Name="LastSeenOnline" Text="Last seen online"
                               Margin="5 0 0 0" Foreground="Gray" FontSize="16" />
                </Grid>
            </Grid>

            <Grid Grid.Row="2" Background="{StaticResource DarkThemeDeviderField}"/>

            <Grid Grid.Row="3" Margin="0 10 0 10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <materialDesign:PackIcon Kind="InfoOutline" VerticalAlignment="Center"
                                                 HorizontalAlignment="Center" 
                                                 Width="30" Height="30"
                                                 Foreground="White"/>
                    </Grid>
                </Grid>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="65"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Vertical" VerticalAlignment="Center">
                        <TextBlock Name="PhoneNumberBlock"
                                   Text="Threre is gona be phone number"
                                   Foreground="White" FontSize="16"/>
                        <TextBlock Name="phNumberText"
                                   Text="Mobile" FontSize="16"
                                   Foreground="Gray"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Vertical">
                        <TextBlock Name="UserNameBlock"          
                                   Text="Threre is gonna be user login"
                                   FontSize="16"
                                   Foreground="{StaticResource TempActiveTextColor}"
                                   MouseEnter="UserNameBlock_MouseEnter"
                                   MouseLeave="UserNameBlock_MouseLeave"
                                   PreviewMouseDown="UserNameBlock_PreviewMouseDown"/>
                        
                        <TextBlock Name="LoginText" 
                                   FontSize="16"
                                   Text="Username" VerticalAlignment="Center"
                                   Foreground="Gray"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid Grid.Row="4" Background="{StaticResource DarkThemeDeviderField}"/>
            <Grid Grid.Row="5">
                <materialDesign:PackIcon Kind="SmileyDead" 
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Height="100" Width="100"
                                         Foreground="White"/>
            </Grid>
        </Grid>
    </Border>
</Page>
