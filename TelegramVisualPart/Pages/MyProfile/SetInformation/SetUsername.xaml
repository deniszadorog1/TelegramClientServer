<Page x:Class="TelegramVisualPart.Pages.MyProfile.SetInformation.SetUsername"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TelegramVisualPart.Pages.MyProfile.SetInformation"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="350" d:DesignWidth="500"
      Height="350" Width="500"
      VerticalAlignment="Center" HorizontalAlignment="Center"
      Title="SetUsername">

    <Border CornerRadius="15" Background="{StaticResource DarkThemeOne}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="80"/>
                <RowDefinition Height="150" />
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" VerticalAlignment="Center"
                       Name="PageName"
                       FontSize="20" Foreground="{StaticResource UsualTextColor}" 
                       Margin="25 0 0 0"/>

            <TextBox Grid.Row="1" Name="UserNameBox"
                     PreviewTextInput="UserNameBox_PreviewTextInput"
                     Foreground="{StaticResource UsualTextColor}" Margin="25 15 15 15" FontSize="16"
                     materialDesign:HintAssist.Hint="@username"
                     materialDesign:HintAssist.FloatingScale="0.8"
                     materialDesign:TextFieldAssist.UnderlineBrush="{StaticResource TempActiveTextColor}" 
                     CaretBrush="{StaticResource UsualTextColor}"
                     materialDesign:HintAssist.Foreground="{StaticResource TempActiveTextColor}"
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     PreviewKeyDown="UserNameBox_PreviewKeyDown"/>

            <StackPanel Grid.Row="2" Background="{StaticResource DarkThemeDeviderField}">

                <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="16"
                           Margin="25 10 20 0" Name="FirstTextInfo"
                           Text="You can choose a username on Telegram. If you do, other people will be able to find you by this username and contact you without knowing your phone number."/>

                <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="16" 
                           Margin="25 10 20 0" Name ="SecTextInfo"
                           Text="You can use a-z, 0-9 ad underscores. Minimum length is in 5 characters."/>
                
            </StackPanel>

            <StackPanel Grid.Row="3" HorizontalAlignment="Right" 
                    VerticalAlignment="Bottom" Margin="15" Orientation="Horizontal">

                <Button Style="{StaticResource MaterialDesignRaisedButton}" Name="CancelBut"
                    Content="Cancel" Background="Transparent" BorderThickness="0"
                    MouseEnter="Button_MouseEnter" MouseLeave="Button_MouseLeave"
                    Click="CancelBut_Click"  Margin="0 0 10 0" FontSize="16"
                    Foreground="{StaticResource TempActiveTextColor}"/>

                <Button Style="{StaticResource MaterialDesignRaisedButton}" Name="SaveBut"
                    Content="Save" Background="Transparent" BorderThickness="0"
                    MouseEnter="Button_MouseEnter" MouseLeave="Button_MouseLeave"
                    Foreground="{StaticResource TempActiveTextColor}"
                    Click="SaveBut_Click" FontSize="16"/>
            </StackPanel>

        </Grid>
    </Border>
</Page>
