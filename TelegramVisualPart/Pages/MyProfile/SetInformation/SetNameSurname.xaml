<Page x:Class="TelegramVisualPart.Pages.MyProfile.SetInformation.SetNameSurname"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TelegramVisualPart.Pages.MyProfile.SetInformation"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="310" d:DesignWidth="450"
      Height="310" Width="450"
      VerticalAlignment="Center"
      HorizontalAlignment="Center"
      Title="SetNameSurname"  
      >

    <Border CornerRadius="15" Background="{StaticResource DarkThemeOne}">
        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="90"/>
                <RowDefinition Height="90"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Text="Edit your name" FontSize="22" Margin="25 0 0 0"
                   HorizontalAlignment="Left" VerticalAlignment="Center"
                   Foreground="{StaticResource UsualTextColor}"/>

            <TextBox Grid.Row="1" Name="FirstNameBox" Margin="25 15 15 15"
                  Foreground="{StaticResource UsualTextColor}" FontSize="20"
                  materialDesign:HintAssist.Hint="First name"
                  materialDesign:TextFieldAssist.UnderlineBrush="{StaticResource TempActiveTextColor}" 
                  materialDesign:HintAssist.Foreground="{StaticResource TempActiveTextColor}"
                  CaretBrush="{StaticResource UsualTextColor}"
                  Style="{StaticResource MaterialDesignFloatingHintTextBox}" />

            <TextBox Grid.Row="2" Name="LastNameBox"
                  Foreground="{StaticResource UsualTextColor}" Margin="25 15 15 15" FontSize="20"
                  materialDesign:HintAssist.Hint="Last name"
                  materialDesign:TextFieldAssist.UnderlineBrush="{StaticResource TempActiveTextColor}" 
                  CaretBrush="{StaticResource UsualTextColor}"
                  materialDesign:HintAssist.Foreground="{StaticResource TempActiveTextColor}"                              
                  Style="{StaticResource MaterialDesignFloatingHintTextBox}" />

            <StackPanel Grid.Row="3" HorizontalAlignment="Right"  
                    VerticalAlignment="Bottom" Margin="10 10 15 15" Orientation="Horizontal">
                <Button Style="{StaticResource MaterialDesignRaisedButton}" Name="CancelBut"
                    Content="Cancel" Background="Transparent" BorderThickness="0"
                    MouseEnter="Button_MouseEnter" MouseLeave="Button_MouseLeave"
                    Click="CancelBut_Click"  Margin="0 0 7 0" FontSize="17"
                    Foreground="{StaticResource TempActiveTextColor}"/>

                <Button Style="{StaticResource MaterialDesignRaisedButton}" Name="SaveBut"
                    Content="Save" Background="Transparent" BorderThickness="0"
                    MouseEnter="Button_MouseEnter" MouseLeave="Button_MouseLeave"
                    Foreground="{StaticResource TempActiveTextColor}"
                    FontSize="17"
                    Click="SaveBut_Click"/>
            </StackPanel>

        </Grid>
    </Border>
</Page>
