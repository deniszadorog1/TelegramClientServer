<Page x:Class="TelegramVisualPart.Pages.MyProfile.SetInformation.SetNameSurname"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TelegramVisualPart.Pages.MyProfile.SetInformation"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="310" d:DesignWidth="450"
      Height="310" Width="450"
      VerticalAlignment="Center"
      HorizontalAlignment="Center"
      Title="SetNameSurname"  
      Background="{StaticResource DarkThemeOne}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="90"/>
            <RowDefinition Height="90"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <TextBlock Text="Edit your name" FontSize="24" Margin="30 0 0 0"
                   HorizontalAlignment="Left" VerticalAlignment="Center"
                   Foreground="White"/>
        
        <TextBox Grid.Row="1" Name="FirstNameBox"
                  Foreground="White" Margin="15" FontSize="16"
                  materialDesign:HintAssist.Hint="First name"
                  materialDesign:TextFieldAssist.UnderlineBrush="{StaticResource DarkThemeMouseEnterBut}" 
                  materialDesign:HintAssist.Foreground="Gray"
                   CaretBrush="White"
                  Style="{StaticResource MaterialDesignFloatingHintTextBox}" />

        <TextBox Grid.Row="2" Name="LastNameBox"
                  Foreground="White" Margin="15" FontSize="16"
                  materialDesign:HintAssist.Hint="Last name"
                  materialDesign:TextFieldAssist.UnderlineBrush="{StaticResource DarkThemeMouseEnterBut}" 
                  CaretBrush="White"
                  materialDesign:HintAssist.Foreground="Gray"
                  Style="{StaticResource MaterialDesignFloatingHintTextBox}" />

        <StackPanel Grid.Row="3" HorizontalAlignment="Right" 
                    VerticalAlignment="Bottom" Margin="10" Orientation="Horizontal">
            <Button Style="{StaticResource MaterialDesignRaisedButton}" Name="CancelBut"
                    Content="Cancel" Background="Transparent" BorderThickness="0"
                    MouseEnter="Button_MouseEnter" MouseLeave="Button_MouseLeave"
                    Click="CancelBut_Click"  Margin="0 0 10 0" 
                    Foreground="{StaticResource TempActiveTextColor}"/>

            <Button Style="{StaticResource MaterialDesignRaisedButton}" Name="SaveBut"
                    Content="Save" Background="Transparent" BorderThickness="0"
                    MouseEnter="Button_MouseEnter" MouseLeave="Button_MouseLeave"
                    Foreground="{StaticResource TempActiveTextColor}"
                    Click="SaveBut_Click"/>
        </StackPanel>

    </Grid>
</Page>
