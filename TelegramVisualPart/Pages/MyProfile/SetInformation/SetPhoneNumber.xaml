<Page x:Class="TelegramVisualPart.Pages.MyProfile.SetInformation.SetPhoneNumber"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TelegramVisualPart.Pages.MyProfile.SetInformation"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="230" d:DesignWidth="350"
      Height="230" Width="350"
      HorizontalAlignment="Center" VerticalAlignment="Center"
      Title="SetPhoneNumber">
    <Grid Background="{StaticResource DarkThemeOne}">
        <Grid.RowDefinitions>
            <RowDefinition Height="180"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock Margin="15" FontSize="22" Foreground="White" TextWrapping="Wrap"
                   Text="You can only change your phone number using mobile Telegram apps. Please use an official Telegram app on your phone to update your numer."/>

        <StackPanel Grid.Row="1" HorizontalAlignment="Right" 
                    VerticalAlignment="Bottom" Margin="10" Orientation="Horizontal">
            <Button Style="{StaticResource MaterialDesignRaisedButton}" Name="Ok"
                    Content="ok" Background="Transparent" BorderThickness="0"
                    MouseEnter="Button_MouseEnter" MouseLeave="Button_MouseLeave"
                    Foreground="{StaticResource TempActiveTextColor}"
                    Click ="Ok_Click"/>
        </StackPanel>
    </Grid>
</Page>
