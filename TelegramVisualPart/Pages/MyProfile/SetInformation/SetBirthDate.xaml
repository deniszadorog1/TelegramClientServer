<Page x:Class="TelegramVisualPart.Pages.MyProfile.SetInformation.SetBirthDate"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TelegramVisualPart.Pages.MyProfile.SetInformation"
      mc:Ignorable="d" 
      d:DesignHeight="250" d:DesignWidth="400"
      Height="250" Width="400"
      Title="SetBirthDate">

    <Border Name ="BorderBg" CornerRadius="15" 
            Background="{StaticResource DarkThemeOne}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Grid VerticalAlignment="Center" Height="40" IsHitTestVisible="False" Grid.ColumnSpan="3">
                    <Rectangle Fill="{StaticResource TempActiveTextColor}" Height="2" VerticalAlignment="Top" Margin="10,0"/>
                    <Rectangle Fill="{StaticResource TempActiveTextColor}" Height="2" VerticalAlignment="Bottom" Margin="10,0"/>
                </Grid>

                <ScrollViewer Grid.Column="0" Name="DaysScroll"
                      PreviewMouseWheel="DaysScroll_PreviewMouseWheel"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center"
                      Width="125"
                      Height="200"
                      VerticalScrollBarVisibility="Hidden">
                    <StackPanel x:Name="DaysPanel">

                    </StackPanel>
                </ScrollViewer>
                
                <ScrollViewer Grid.Column="1" Name="MonthScroll"
                      PreviewMouseWheel="MonthScroll_PreviewMouseWheel"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center"
                      Width="125"
                      Height="200"
                      VerticalScrollBarVisibility="Hidden">
                    <StackPanel x:Name="MonthPanel">

                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Grid.Column="2" Name="YearScroll"
                      PreviewMouseWheel="YearScroll_PreviewMouseWheel"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center"
                      Width="125"
                      Height="200"
                      VerticalScrollBarVisibility="Hidden">
                    <StackPanel x:Name="YearPanel">

                    </StackPanel>
                </ScrollViewer>
            </Grid>


            <Button Grid.Row="1" Style="{StaticResource MaterialDesignRaisedButton}" Name="RemoveBut"
                    Content="Remove" Background="Transparent" BorderThickness="0"
                    MouseEnter="Button_MouseEnter" MouseLeave="Button_MouseLeave"
                    Foreground="{StaticResource DarkThemeProfileButForeGround}"
                    Click="RemoveBut_Click"  HorizontalAlignment="Left" Margin="10 0 0 0"/>

            <StackPanel Grid.Row="1" HorizontalAlignment="Right" 
                    VerticalAlignment="Bottom" Margin="10" Orientation="Horizontal">
                <Button Style="{StaticResource MaterialDesignRaisedButton}" Name="CancelBut"
                    Content="Cancel" Background="Transparent" BorderThickness="0"
                    MouseEnter="Button_MouseEnter" MouseLeave="Button_MouseLeave"
                    Click="CancelBut_Click"  Margin="0 0 10 0" 
                    Foreground="{StaticResource DarkThemeProfileButForeGround}"/>

                <Button Style="{StaticResource MaterialDesignRaisedButton}" Name="SaveBut"
                    Content="Save" Background="Transparent" BorderThickness="0"
                    MouseEnter="Button_MouseEnter" MouseLeave="Button_MouseLeave"
                    Foreground="{StaticResource DarkThemeProfileButForeGround}"
                    Click="SaveBut_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Page>
