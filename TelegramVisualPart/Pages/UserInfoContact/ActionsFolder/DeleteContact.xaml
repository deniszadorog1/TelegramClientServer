<Page x:Class="TelegramVisualPart.Pages.UserInfoContact.ActionsFolder.DeleteContact"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TelegramVisualPart.Pages.UserInfoContact.ActionsFolder"
      mc:Ignorable="d" 
      d:DesignHeight="200" d:DesignWidth="400"
      Height="200" Width="400"
      Title="DeleteContact">

    <Border Name="BgBorder" CornerRadius="15" Background="{StaticResource DarkThemeOne}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="75"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="75"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0" VerticalAlignment="Center"
                        Name="UserEllipseImage" Width="40" Height="40">
                    <Ellipse.Fill>
                        <ImageBrush x:Name="BgBrush" ImageSource="/Visuals/Images/UserImages/Minato.jpg"/>
                    </Ellipse.Fill>
                </Ellipse>

                <TextBlock Grid.Column="1" Foreground="White" FontSize="16" 
                           VerticalAlignment="Center" Text="Delete Contact" />
            </Grid>

            <TextBlock Grid.Row="1" Name="ToBlockText" TextWrapping="Wrap"
                       Text="Are you sure you want to delete USERNAME from your contact list?" 
                       Foreground="White" FontSize="16" Margin="15"/>

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource MaterialDesignRaisedButton}" Name="CancelBut"
                            Content="Cancel" Background="Transparent" BorderThickness="0"
                            HorizontalAlignment="Right" Margin="0 0 10 0"
                            MouseEnter="CancelBut_MouseEnter"  MouseLeave="CancelBut_MouseLeave"
                            Foreground="{StaticResource DarkThemeProfileButForeGround}"
                            Click="CancelBut_Click"/>

                <Button Style="{StaticResource MaterialDesignRaisedButton}" Name="DeleteBut"
                            Content="Delete" Background="Transparent" BorderThickness="0"
                            MouseEnter="DeleteBut_MouseEnter"  MouseLeave="DeleteBut_MouseLeave"
                            HorizontalAlignment="Left" 
                            Click="DeleteBut_Click"  Margin="10 0 20 0" 
                            Foreground="{StaticResource CloseWindowColor}"/>
            </StackPanel>
        </Grid>
    </Border>
</Page>
