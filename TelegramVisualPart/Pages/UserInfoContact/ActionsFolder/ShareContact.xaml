<Page x:Class="TelegramVisualPart.Pages.UserInfoContact.ActionsFolder.ShareContact"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TelegramVisualPart.Pages.UserInfoContact.ActionsFolder"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:controls ="clr-namespace:TelegramVisualPart.UserControls.ContactsControls"
      xmlns:Icon="clr-namespace:TelegramVisualPart.UserControls.DifferButs"      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="400"
      Height="450" Width="400"
      Title="ShareContact">

    <Border Name ="BgBorder" CornerRadius="15" 
            Background="{StaticResource DarkThemeOne}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="60"/>
                <RowDefinition/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Name ="ControlName" Text="Forward to..."
                       VerticalAlignment="Center" Margin="20 0 0 0" Foreground="White"
                       FontSize="16"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>

                <materialDesign:PackIcon Kind="Magnify" VerticalAlignment="Center"
                                         HorizontalAlignment="Center" Foreground="Gray"
                                         Width="30" Height="30" />

                <TextBox Grid.Column="1"
                  Foreground="White" Margin="10 0 10 0" FontSize="16"
                  materialDesign:HintAssist.Hint="Search"
                  materialDesign:TextFieldAssist.UnderlineBrush="{StaticResource DarkThemeMouseEnterBut}" 
                  CaretBrush="White" Name="SearchTextBox"
                  materialDesign:HintAssist.Foreground="Gray"
                  Style="{StaticResource MaterialDesignFloatingHintTextBox}" />

                <materialDesign:PackIcon Kind="Close" VerticalAlignment="Center"
                                         HorizontalAlignment="Center" Foreground="Gray"
                                         Width="30" Height="30" Grid.Column="2"/>
            </Grid>

            <ScrollViewer Grid.Row="2">
                <StackPanel>
                    <controls:UserContact PreviewMouseDown="UserContact_PreviewMouseDown"/>
                </StackPanel>
            </ScrollViewer>


            <Grid Grid.Row="3">
                <Button Style="{StaticResource MaterialDesignRaisedButton}" Name="CancelBut"
                          Content="Cancel" Background="Transparent" BorderThickness="0"
                          HorizontalAlignment="Right" Margin="0 0 10 0"
                          MouseEnter="CancelBut_MouseEnter"  MouseLeave="CancelBut_MouseLeave"
                          Foreground="{StaticResource DarkThemeProfileButForeGround}"
                          Click="CancelBut_Click"/>
            </Grid>
        </Grid>
    </Border>
</Page>
