<Page x:Class="TelegramVisualPart.Pages.BlockPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TelegramVisualPart.Pages"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="BlockPage">

    <Grid Background="{StaticResource DarkThemeOne}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="0.5*"/>
            <RowDefinition Height="250"/>
            <RowDefinition Height="0.5*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Enter local passcode"
                       VerticalAlignment="Center" Foreground="{StaticResource UsualTextColor}"
                       FontSize="20"/>

            <TextBox Grid.Row="1" 
                     Name="PasswordBox" 
                     materialDesign:HintAssist.Hint="Passcode"
                     Foreground="White"
                     FontSize="18"
                     materialDesign:TextFieldAssist.UnderlineBrush="{StaticResource TempActiveTextColor}" 
                     materialDesign:HintAssist.Foreground="{StaticResource TempActiveTextColor}"
                     CaretBrush="{StaticResource TempActiveTextColor}"
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                     MouseEnter="PasswordBox_MouseEnter"
                     MouseLeave="PasswordBox_MouseLeave"
                     PreviewMouseDown="PasswordBox_PreviewMouseDown"/>

            <Border Grid.Row="2" Margin="20 7 20 7"
                    Name="SubmitBlock"
                    MouseEnter="SubmitBlock_MouseEnter"
                    MouseLeave="SubmitBlock_MouseLeave"
                    PreviewMouseDown="SubmitBlock_PreviewMouseDown"
                    CornerRadius="10" Background="{StaticResource DarkThemeSecond}">

                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center"
                           Text="Submit" Foreground="{StaticResource UsualTextColor}"
                           FontSize="16"/>
            </Border>

            <Grid Grid.Row="3">

                <TextBlock Text="Log out" 
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TempActiveTextColor}"
                           FontSize="16"
                           Name="LogOutBut"
                           MouseEnter="LogOutBut_MouseEnter"
                           MouseLeave="LogOutBut_MouseLeave"
                           PreviewMouseDown="LogOutBut_PreviewMouseDown"/>
            </Grid>

        </Grid>
        
    </Grid>
</Page>
