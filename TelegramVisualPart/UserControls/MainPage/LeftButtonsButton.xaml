<UserControl x:Class="TelegramVisualPart.UserControls.MainPage.LeftButtonsButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls.MainPage"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="100"
             
             Background="Transparent"
             MouseEnter="UserControl_MouseEnter"
             MouseLeave="UserControl_MouseLeave">
    
    <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
        <materialDesign:PackIcon Kind="PlaylistEdit" Foreground="Gray" 
                                 HorizontalAlignment="Center"
                                 Width="40" Height="40" Name="ButIcon"/>
        <TextBlock x:Name="ButText" Text="Edit" HorizontalAlignment="Center" 
                   Foreground="Gray" FontSize="14"/>
    </StackPanel>
</UserControl>
