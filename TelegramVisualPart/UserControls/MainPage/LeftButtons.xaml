<UserControl x:Class="TelegramVisualPart.UserControls.MainPage.LeftButtons"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls.MainPage"
             mc:Ignorable="d"              
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             d:DesignHeight="400" d:DesignWidth="100">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
            <materialDesign:PackIcon Kind="HamburgerMenu" Foreground="Gray"                                  
                                 Width="30" Height="30" PreviewMouseDown="ShowMenu_PreviewMouseDown"/>
        </StackPanel>
        
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <materialDesign:PackIcon Kind="Wechat"  Foreground="Gray"
                                     HorizontalAlignment="Center"
                                     Width="30" Height="30"/>
            <TextBlock Text="All chats" HorizontalAlignment="Center" Foreground="Gray" FontSize="12"/>
        </StackPanel>

        <StackPanel Orientation="Vertical" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center">
            <materialDesign:PackIcon Kind="AccountCircle" Foreground="Gray" 
                                 HorizontalAlignment="Center"
                                 Width="30" Height="30"/>
            <TextBlock Text="Personal" HorizontalAlignment="Center" Foreground="Gray" FontSize="12"/>
        </StackPanel>

        <StackPanel Orientation="Vertical" Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center">
            <materialDesign:PackIcon Kind="PlaylistEdit" Foreground="Gray" 
                                 HorizontalAlignment="Center"
                                 Width="30" Height="30"/>
            <TextBlock Text="Edit" HorizontalAlignment="Center" Foreground="Gray" FontSize="12"/>
        </StackPanel>

    </Grid>
</UserControl>
