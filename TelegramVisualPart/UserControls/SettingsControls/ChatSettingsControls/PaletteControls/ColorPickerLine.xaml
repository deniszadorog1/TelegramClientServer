<UserControl x:Class="TelegramVisualPart.UserControls.SettingsControls.ChatSettingsControls.PaletteControls.ColorPickerLine"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls.SettingsControls.ChatSettingsControls.PaletteControls"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="200"
             MouseMove="UserControl_MouseMove"
             MouseDown="UserControl_MouseDown"
             MouseUp="UserControl_MouseUp">

    <UserControl.Resources>
        <DrawingBrush x:Key="SpectrumWithVerticalFade">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing>
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0, 0, 1, 1" />
                        </GeometryDrawing.Geometry>
                        <GeometryDrawing.Brush>
                            <LinearGradientBrush x:Name="gradientBrusha" StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="Red" Offset="0.1" x:Name="FirstColor"/>
                                <GradientStop  Color="AliceBlue" Offset="1" x:Name="WhiteColor"/>
                            </LinearGradientBrush>
                        </GeometryDrawing.Brush>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="15"/>
            <RowDefinition/>
            <RowDefinition Height="15"/>
        </Grid.RowDefinitions>


        <materialDesign:PackIcon Kind="Triangle" Foreground="White" Name="UpperTriangle" 
                                 Grid.Row="0" RenderTransformOrigin="0.5, 0.5" Width="14">
            <materialDesign:PackIcon.RenderTransform>
                <RotateTransform Angle="180"/>
            </materialDesign:PackIcon.RenderTransform>
        </materialDesign:PackIcon>

        <Rectangle Grid.Row="1" Name="ColorSpecter" Margin="7 0 7 0"
                   Fill="{StaticResource SpectrumWithVerticalFade}"
                   Stretch="Fill"/>

        <materialDesign:PackIcon Kind="Triangle" Foreground="White" Width="14"
                                 Name="BottomTriangle" Grid.Row="2"/>

    </Grid>
</UserControl>
