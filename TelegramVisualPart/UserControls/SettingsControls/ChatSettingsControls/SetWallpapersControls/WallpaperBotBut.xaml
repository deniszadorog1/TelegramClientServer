<UserControl x:Class="TelegramVisualPart.UserControls.SettingsControls.ChatSettingsControls.SetWallpapersControls.WallpaperBotBut"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls.SettingsControls.ChatSettingsControls.SetWallpapersControls"
             mc:Ignorable="d" 
             d:DesignHeight="25" d:DesignWidth="45"
             Height="25" Width="45">
    <Grid>
        <Border Name="BorderBg" CornerRadius="10" Background="Transparent"
            MouseEnter="BorderBg_MouseEnter"
            MouseLeave="BorderBg_MouseLeave"
            PreviewMouseDown="BorderBg_PreviewMouseDown">
            <TextBlock Text="Close" Background="Transparent" Name="TextBlock" 
                   VerticalAlignment="Center" HorizontalAlignment="Center" 
                       Foreground="{StaticResource TempActiveTextColor}"/>
        </Border>
    </Grid>
</UserControl>
