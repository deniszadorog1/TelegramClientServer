<UserControl x:Class="TelegramVisualPart.UserControls.SettingsControls.ChatSettingsControls.SetWallpapersControls.Wallpaper"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls.SettingsControls.ChatSettingsControls.SetWallpapersControls"
             mc:Ignorable="d" 
             d:DesignHeight="230" d:DesignWidth="130"
             Height="230" Width="130" Margin="5" 
             >
    <Grid Name="WallpaperGrid" Background="Green">
        <Image Name="WallpaperImage" Stretch="Fill"
               MouseEnter="WallpaperImage_MouseEnter"
               MouseLeave="WallpaperImage_MouseLeave"/>
    </Grid>
</UserControl>
