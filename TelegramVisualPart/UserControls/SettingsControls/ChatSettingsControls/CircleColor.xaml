<UserControl x:Class="TelegramVisualPart.UserControls.SettingsControls.ChatSettingsControls.CircleColor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls.SettingsControls.ChatSettingsControls"
             mc:Ignorable="d" 
             d:DesignHeight="25" d:DesignWidth="25"
             Height="30" Width="30"
             MouseEnter="UserControl_MouseEnter"
             MouseLeave="UserControl_MouseLeave">
    <Grid>
        <Border Name="BgBorder" Background="Red" CornerRadius="100"/>
        
        <Border Name="WhiteCircle" BorderBrush="White" Visibility="Hidden"
                CornerRadius="100" BorderThickness="3" Margin="2"/>
        
    </Grid>
</UserControl>
