<UserControl x:Class="TelegramVisualPart.UserControls.SettingsControls.ChatSettingsControls.ThemeSetBut"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls.SettingsControls.ChatSettingsControls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="400"
             Height="40"
             MouseEnter="UserControl_MouseEnter"
             MouseLeave="UserControl_MouseLeave"
             PreviewMouseDown="UserControl_PreviewMouseDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="95"/>
        </Grid.ColumnDefinitions>

        <materialDesign:PackIcon Name="IconTest" Height="30" Width="30" VerticalAlignment="Center" HorizontalAlignment="Right"
                                 Foreground="White" Margin="10"/>

        <TextBlock Name="ButName" Grid.Column ="1" Text="But name here" VerticalAlignment="Center"
                   Foreground="White" />

        <TextBlock Name="ChosenType" Grid.Column="2" Text="Chosen" VerticalAlignment="Center" HorizontalAlignment="Right"
                   Margin="0 0 25 0" Foreground="{StaticResource DarkThemeProfileButForeGround}"/>

    </Grid>
</UserControl>
