<UserControl x:Class="TelegramVisualPart.UserControls.SettingsControls.NotificationPrivacy.WindowMessage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls.SettingsControls.NotificationPrivacy"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="85" d:DesignWidth="350"
             Height="85"
             Margin="0 4 0 4"
             Background="{StaticResource DarkThemeOne}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="30"/>
        </Grid.ColumnDefinitions>

        <Ellipse Grid.Column="0" VerticalAlignment="Center"
                Name="UserEllipseImage" Width="70" Height="70">
            <Ellipse.Fill>
                <ImageBrush x:Name="BgBrush" ImageSource="/Visuals/Images/UserImages/Minato.jpg"/>
            </Ellipse.Fill>
        </Ellipse>

        <Grid Grid.Column="1" Margin="10 0 0 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="25"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Foreground="White"
                       Text="This is from the app"
                       VerticalAlignment="Center"
                       FontSize="18"/>

            <TextBlock Grid.Row="1" 
                       Foreground="{StaticResource TempActiveTextColor}"
                       Text="Text from sample!"
                       VerticalAlignment="Center"
                       FontSize="16"/>
        </Grid>

        <materialDesign:PackIcon Grid.Column="2" 
                                 VerticalAlignment="Top"
                                 HorizontalAlignment="Right"
                                 Margin="7" Kind="Close"
                                 Width="20" Height="20"
                                 Foreground="Gray"/>

    </Grid>
</UserControl>
