<UserControl x:Class="TelegramVisualPart.UserControls.SettingsControls.LogOutMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls.SettingsControls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="115" d:DesignWidth="150"
             Height="100" Width="200" 
             MaxHeight="100" MaxWidth="200">
                
    <Border Background="{StaticResource DarkThemeOne}"
            CornerRadius="10" BorderBrush="{StaticResource DarkThemeSecond}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Row="0"
                        Name="EdiProfBut"
                        PreviewMouseDown="EdiProfBut_PreviewMouseDown"
                        MouseEnter="StackPanel_MouseEnter"
                        MouseLeave="StackPanel_MouseLeave">
                <materialDesign:PackIcon Kind="PencilOutline"
                                         Width="25" Height="25"
                                         VerticalAlignment="Center"
                                         Margin="15 0 15 0"
                                         Foreground="{StaticResource UsualTextColor}"/>
                <TextBlock Text="Edit profile" VerticalAlignment="Center"
                           Foreground="{StaticResource UsualTextColor}" FontSize="16"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Grid.Row="1"
                        Name ="LogOutBut"
                        PreviewMouseDown="LogOutBut_PreviewMouseDown"
                        MouseEnter="StackPanel_MouseEnter"
                        MouseLeave="StackPanel_MouseLeave">
                <materialDesign:PackIcon Kind="Logout"
                                         Width="25" Height="25"
                                         VerticalAlignment="Center"
                                         Margin="15 0 15 0"
                                         Foreground="{StaticResource ToBlockContact}"/>
                <TextBlock Text="Edit profile" VerticalAlignment="Center"
                           Foreground="{StaticResource ToBlockContact}" FontSize="16"/>
            </StackPanel>


        </Grid>
    </Border>
</UserControl>
