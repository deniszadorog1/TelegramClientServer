<UserControl x:Class="TelegramVisualPart.UserControls.SettingsControls.FoldersPrivacy.FoldersChat"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls.SettingsControls.FoldersPrivacy"
             mc:Ignorable="d" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             d:DesignHeight="100" d:DesignWidth="800">
    <Grid HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="50"/>
        </Grid.ColumnDefinitions>

        <Ellipse Width="30" Height="30" Name="ChatEllipse"
                             Fill="{StaticResource TempActiveTextColor}"/>

        <TextBlock Grid.Column="1" Text="Create new Folder" Name="NewFoldersChatText"
                       VerticalAlignment="Center" Margin="10 0 0 0"
                       Foreground="{StaticResource TempActiveTextColor}" FontSize="12"/>

        <Grid Grid.Column="2" MouseEnter="Grid_MouseEnter" 
              MouseLeave="Grid_MouseLeave"
              PreviewMouseDown="Grid_PreviewMouseDown"
              Background="Transparent">
            <materialDesign:PackIcon Kind="Close" Name="Icon" Margin="5" Width="20" Height="20" Foreground="Gray"
                                     VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
