<UserControl x:Class="TelegramVisualPart.UserControls.SettingsControls.FoldersPrivacy.AddFolderBut"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls.SettingsControls.FoldersPrivacy"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"     
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="400">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <materialDesign:PackIcon Kind="CirclesAdd"  Name="IconType"
                                 Grid.Column="0" VerticalAlignment="Center"
                                 HorizontalAlignment="Left"
                                 Foreground="{StaticResource DarkThemeProfileButForeGround}"
                                 Width="30" Height="30"/>

        <TextBlock Grid.Column="1" Text="Create new Folder" Name="NewFolderText"
                       VerticalAlignment="Center" Margin="10 0 0 0"
                       Foreground="{StaticResource DarkThemeProfileButForeGround}" FontSize="12"/>
    </Grid>
</UserControl>
