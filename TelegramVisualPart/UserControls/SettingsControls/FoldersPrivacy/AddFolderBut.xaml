<UserControl x:Class="TelegramVisualPart.UserControls.SettingsControls.FoldersPrivacy.AddFolderBut"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls.SettingsControls.FoldersPrivacy"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"     
             mc:Ignorable="d" 
             d:DesignHeight="45" d:DesignWidth="400"
             Height="45"
             MouseEnter="UserControl_MouseEnter"
             MouseLeave="UserControl_MouseLeave"
             HorizontalAlignment="Stretch">
    <Grid HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="65"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <materialDesign:PackIcon Kind="CirclesAdd"  Name="IconType"
                                 Grid.Column="0" VerticalAlignment="Center"
                                 HorizontalAlignment="Center" 
                                 Foreground="{StaticResource TempActiveTextColor}"
                                 Width="27" Height="27"/>

        <TextBlock Grid.Column="1" Text="Create new Folder" Name="NewFolderText"
                       VerticalAlignment="Center" 
                       Foreground="{StaticResource TempActiveTextColor}" FontSize="17"/>
    </Grid>
</UserControl>
