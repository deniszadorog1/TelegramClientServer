<UserControl x:Class="TelegramVisualPart.UserControls.SettingsControls.FoldersPrivacy.FolderLittleInfo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls.SettingsControls.FoldersPrivacy"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"      
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="400"
             Height="50"
             MouseEnter="UserControl_MouseEnter"
             MouseLeave="UserControl_MouseLeave">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="65"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="100"/>
        </Grid.ColumnDefinitions>

        <materialDesign:PackIcon x:Name="IconType" 
                                 Kind="AlertCircleOutline" 
                                 Grid.Column="0" VerticalAlignment="Center"
                                 HorizontalAlignment="Center"
                                 Foreground="{StaticResource TempActiveTextColor}"
                                 Width="25" Height="25"/>

        <Grid Grid.Column ="1">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Folder name" Name="FolderName"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource UsualTextColor}" FontSize="16"/>

            <TextBlock Grid.Row="1" Text="Amount of items" Name="AmountOfChats"
                       VerticalAlignment="Center" 
                       Foreground="Gray" FontSize="14"/>
        </Grid>

        <Grid Grid.Column="2" Name="BucketGrid"
              HorizontalAlignment="Right"
              Background="Transparent"
              MouseEnter="Grid_MouseEnter"
              MouseLeave="Grid_MouseLeave"
              PreviewMouseDown="BucketGrid_PreviewMouseDown">
            <materialDesign:PackIcon x:Name="BucketIcon" 
                                 Kind="TrashCanOutline" 
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Right"
                                 Foreground="Gray" Margin="0 0 35 0"
                                 Width="25" Height="25"/>
        </Grid>

    </Grid>
</UserControl>
