<UserControl x:Class="TelegramVisualPart.UserControls.SettingsControls.FoldersPrivacy.FolderChatType"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls.SettingsControls.FoldersPrivacy"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"    
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="400"
             Height="40"
             Background="{StaticResource DarkThemeProfileButEnter}"
             MouseEnter="UserControl_MouseEnter" 
             MouseLeave="UserControl_MouseLeave"
             PreviewMouseDown="UserControl_PreviewMouseDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="65"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Border CornerRadius="100" Width="35" Height="35" Name="ChosenChatIconBorder"
                Background="Transparent">
            <Border CornerRadius="100" Width="33" Height="33" 
                Background="{StaticResource DarkThemeProfileButEnter}">
                <Grid>
                    <Ellipse Width="30" Height="30" Name="ChatEllipse"
                             Fill="{StaticResource FolderContactColor}"/>
                    <materialDesign:PackIcon Name="IconType"
                                             Kind="Duck" Foreground="White"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Center"
                                             Width="20" Height="20"/>
                </Grid>
            </Border>
        </Border>

        <TextBlock Name="TypeName" Grid.Column="1"
                   Text="There gona be chat type name"
                   VerticalAlignment="Center" Foreground="White"
                   FontSize="14" Margin="15  0 0 0" 
                   />

    </Grid>
</UserControl>
