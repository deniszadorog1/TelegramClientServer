<UserControl x:Class="TelegramVisualPart.UserControls.SettingsControls.AutoDeleteMessages.ChatToApply"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls.SettingsControls.AutoDeleteMessages"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"    
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="400"
             Height="50"
             MouseEnter="UserControl_MouseEnter"
             MouseLeave="UserControl_MouseLeave"
             PreviewMouseDown="UserControl_PreviewMouseDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="65"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Border CornerRadius="100" Width="35" Height="35" 
                Name="ChosenChatIconBorder"
                
                Background="Transparent">
            <Ellipse Height="33" 
                     Width="33">
                <Ellipse.Fill>
                    <ImageBrush x:Name="UserImageBrush" ImageSource="/Visuals/Images/UserImages/Minato.jpg"/>
                </Ellipse.Fill>
            </Ellipse>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            
            <TextBlock Name="TypeName" Grid.Row="0"
                       Text="There gona be chat name"
                       VerticalAlignment="Center" Foreground="White"
                       FontSize="14" Margin="5 0 0 0"/>

            <TextBlock Name="AutoDeletionType" Grid.Row="1"
                       Text="There gona be deleteion type"
                       VerticalAlignment="Center" Foreground="White"
                       FontSize="14" Margin="5 0 0 0"/>
        </Grid>
    </Grid>
</UserControl>
