<UserControl x:Class="TelegramVisualPart.UserControls.SettingsControls.AdvancedControls.AdvancedButtons.TextBut"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls.SettingsControls.AdvancedControls.AdvancedButtons"
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="400"
             Height="40"
             MouseEnter="UserControl_MouseEnter" 
             MouseLeave="UserControl_MouseLeave" >
    <Grid>
        <TextBlock Name="TextBlock" Text="Text is gona be here"
                   VerticalAlignment="Center" Margin="20 0 0 0"
                   HorizontalAlignment="Left" 
                   Foreground="{StaticResource UsualTextColor}"
                   FontSize="14"/>
    </Grid>
</UserControl>
