<UserControl x:Class="TelegramVisualPart.UserControls.SettingsControls.AdvancedControls.AdvancedButtons.DoubleTextIconBut"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls.SettingsControls.AdvancedControls.AdvancedButtons"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"    
             mc:Ignorable="d" 
             d:DesignHeight="45" d:DesignWidth="400"
             Height="45"
             MouseEnter="UserControl_MouseEnter"
             MouseLeave="UserControl_MouseLeave">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="65"/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <materialDesign:PackIcon Kind="CirclesAdd"  Name="IconType"
                         Grid.Column="0" VerticalAlignment="Center"
                         HorizontalAlignment="Center" 
                         Foreground="{StaticResource UsualTextColor}"
                         Width="25" Height="25"/>

        <TextBlock Grid.Column="1" Text="Create new Folder" Name="ButName"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource UsualTextColor}" FontSize="17"
                   HorizontalAlignment="Left"/>

        <TextBlock Grid.Column="2" Text="Create new Folder" Name="TempStatusBut"
                   VerticalAlignment="Center" Margin="0 0 20 0" 
                   HorizontalAlignment="Right"
                   Foreground="{StaticResource TempActiveTextColor}" 
                   FontSize="17"/>

    </Grid>
</UserControl>
