<UserControl x:Class="TelegramVisualPart.UserControls.SettingsControls.AdvancedControls.AdvancedButtons.TwoTextsToggle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls.SettingsControls.AdvancedControls.AdvancedButtons"
             mc:Ignorable="d" 
             d:DesignHeight="45" d:DesignWidth="400"
             Height="45"
             MouseEnter="UserControl_MouseEnter"
             MouseLeave="UserControl_MouseLeave"
             PreviewMouseDown="UserControl_PreviewMouseDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" Margin="20 0 0 0">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Name ="FirstTextBlock" Grid.Column="0" 
                   Text="There gonna be a text" 
                   VerticalAlignment="Center" Foreground="{StaticResource UsualTextColor}" 
                   FontSize="16"/>

            <TextBlock Name ="SecondTextBlock" 
                       Grid.Column="0" Grid.Row="1"
                       Text="There gonna be a text" 
                       VerticalAlignment="Center" 
                       Foreground="Gray" 
                       FontSize="16" />
            
        </Grid>

        <ToggleButton Name ="Toggle" Grid.Column="1" Width="35"
                      HorizontalAlignment="Right" Margin="0 0 20 0"
                      Style="{StaticResource MaterialDesignSwitchDarkToggleButton}"
                      ToolTip="MaterialDesignSwitchDarkToggleButton"                      
                      IsChecked="True" Background="{StaticResource TempActiveTextColor}"
                      PreviewMouseDown="Toggle_PreviewMouseDown"/>

    </Grid>
</UserControl>
