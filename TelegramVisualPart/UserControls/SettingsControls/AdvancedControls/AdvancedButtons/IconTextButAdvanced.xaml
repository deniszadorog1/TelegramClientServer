<UserControl x:Class="TelegramVisualPart.UserControls.SettingsControls.AdvancedControls.AdvancedButtons.IconTextButAdvanced"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls.SettingsControls.AdvancedControls.AdvancedButtons"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"                
             mc:Ignorable="d" 
             d:DesignHeight="30" d:DesignWidth="400"
             Height="30" 
             MouseEnter="UserControl_MouseEnter"
             MouseLeave="UserControl_MouseLeave">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="55"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <materialDesign:PackIcon Kind="ProgressDownload" 
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Left"
                                 Margin="20 0 0 0"
                                 Foreground="Gray"
                                 Width="30" Height="30"
                                 Name="IconType"/>
        
        <TextBlock Grid.Column="1" Name="ButName" 
                   Text="There would be a but name"
                   VerticalAlignment="Center" 
                   HorizontalAlignment="Left" FontSize="14"
                   Foreground="White" Margin="10 0 0 0"/>
    </Grid>
</UserControl>
