<UserControl x:Class="TelegramVisualPart.UserControls.SettingsControls.AdvancedControls.AdvancedButtons.IconTextButAdvanced"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls.SettingsControls.AdvancedControls.AdvancedButtons"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"                
             mc:Ignorable="d" 
             d:DesignHeight="45" d:DesignWidth="400"
             Height="45" 
             MouseEnter="UserControl_MouseEnter"
             MouseLeave="UserControl_MouseLeave">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="65"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <materialDesign:PackIcon Kind="ProgressDownload" 
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Center"
                                 Foreground="{StaticResource UsualTextColor}"
                                 Width="25" Height="25"
                                 Name="IconType"/>
        
        <TextBlock Grid.Column="1" Name="ButName" 
                   Text="There would be a but name"
                   VerticalAlignment="Center" 
                   HorizontalAlignment="Left" FontSize="17"
                   Foreground="{StaticResource UsualTextColor}"/>
    </Grid>
</UserControl>
