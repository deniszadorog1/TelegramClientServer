<UserControl x:Class="TelegramVisualPart.UserControls.SettingsControls.AdvancedControls.AdvancedButtons.ToggleButAdvanced"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls.SettingsControls.AdvancedControls.AdvancedButtons"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"   
             mc:Ignorable="d" 
             d:DesignHeight="45" d:DesignWidth="400"
             Height="45" 
             MouseEnter="UserControl_MouseEnter" 
             MouseLeave="UserControl_MouseLeave"
             PreviewMouseDown="UserControl_PreviewMouseDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="100"/>
        </Grid.ColumnDefinitions>

        <TextBlock Name ="TextBlock" Grid.Column="0" 
                   Text="There gonna be a text" 
                   VerticalAlignment="Center" 
                   Foreground="{StaticResource UsualTextColor}" 
                   FontSize="17" Margin="20 0 0 0"  />

        <ToggleButton Name ="Toggle" Grid.Column="1" Width="35"
                      HorizontalAlignment="Right" Margin="0 0 20 0"
                      Style="{StaticResource MaterialDesignSwitchDarkToggleButton}"
                      ToolTip="MaterialDesignSwitchDarkToggleButton"                      
                      IsChecked="False" Background="{StaticResource TempActiveTextColor}"
                      
                      PreviewMouseDown="Toggle_PreviewMouseDown"/>

    </Grid>
</UserControl>
