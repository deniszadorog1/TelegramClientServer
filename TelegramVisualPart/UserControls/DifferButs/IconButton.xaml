<UserControl x:Class="TelegramVisualPart.UserControls.DifferButs.IconButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls.DifferButs"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             
             Background="Transparent"
             MouseEnter="UserControl_MouseEnter" 
             MouseLeave="UserControl_MouseLeave">
    <Grid x:Name="MainGrid">
        <materialDesign:PackIcon Kind="GuyFawkesMask" Foreground="Gray"
                                 x:Name="IconType"
                                 Width="{Binding ActualWidth, ElementName=MainGrid}" 
                                 Height="{Binding ActualHeight, ElementName=MainGrid}" 
                                 VerticalAlignment="Center" HorizontalAlignment="Center"/>
    </Grid>
</UserControl>
