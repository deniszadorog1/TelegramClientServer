<UserControl x:Class="TelegramVisualPart.UserControls.DifferButs.ToggleTextBut"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls.DifferButs"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="500">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <TextBlock Name ="TextBlock" Grid.Column="0" Text="there gonna be a text" 
                   VerticalAlignment="Center" Foreground="LightGray" FontSize="14"
                   Margin="10" FontWeight="DemiBold"/>

        <ToggleButton Name ="Toggle" Grid.Column="1" Width="35"
                      HorizontalAlignment="Right"
              Style="{StaticResource MaterialDesignSwitchDarkToggleButton}"
              ToolTip="MaterialDesignSwitchDarkToggleButton"                      
              IsChecked="True" Background="{StaticResource DarkThemeProfileButForeGround}"/>

    </Grid>
</UserControl>
