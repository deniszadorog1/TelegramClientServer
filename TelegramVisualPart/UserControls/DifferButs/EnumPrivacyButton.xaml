<UserControl x:Class="TelegramVisualPart.UserControls.DifferButs.EnumPrivacyButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls.DifferButs"
             mc:Ignorable="d" 
             d:DesignHeight="37" d:DesignWidth="800"
             Height="37"
             Background="{StaticResource DarkThemeOne}"
             MouseEnter="UserControl_MouseEnter"
             MouseLeave="UserControl_MouseLeave">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0"
                   Name="NamePart" Text="Name is gonna be here" VerticalAlignment="Center"
                   HorizontalAlignment="Left" Margin="25 0 0 0" FontSize="16" 
                   Foreground="{StaticResource UsualTextColor}"/>

        <TextBlock Grid.Column="1"
                   Name="EnumPart" Text="chosen enum value is here" VerticalAlignment="Center"
                   HorizontalAlignment="Right" Margin="0 0 15 0" FontSize="16" 
                   Foreground="{StaticResource TempActiveTextColor}"/>
    </Grid>
</UserControl>
