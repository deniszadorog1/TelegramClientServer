<UserControl x:Class="TelegramVisualPart.UserControls.ChatControls.MediaActions.ActionMenuButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls.ChatControls.MediaActions"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="150"
             Height="40"
             MouseEnter="UserControl_MouseEnter"
             MouseLeave="UserControl_MouseLeave"
         
             Background="{StaticResource DarkThemeOne}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width ="45"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <materialDesign:PackIcon Kind="GuyFawkesMask" Name="Icon"
                                 Foreground="White" Width="30"
                                 Height="30" HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>

        <TextBlock Grid.Column="1" x:Name="ButText" Text="Button text"
                   VerticalAlignment="Center" HorizontalAlignment="Left"
                   Foreground="White"/>
    </Grid>
</UserControl>
