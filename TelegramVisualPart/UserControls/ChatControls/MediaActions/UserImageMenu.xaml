<UserControl x:Class="TelegramVisualPart.UserControls.ChatControls.MediaActions.UserImageMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls.ChatControls.MediaActions"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="150"
             Height="200" Width="150">
    <StackPanel Orientation="Vertical" Name="ChildrenPanel">
        <local:ActionMenuButton x:Name="Copy"/>
        <local:ActionMenuButton x:Name="Delete"/>
        <local:ActionMenuButton x:Name="SaveAs"/>
        <local:ActionMenuButton x:Name="WatchInFiles"/>
        <local:ActionMenuButton x:Name="Report"/>
    </StackPanel>
</UserControl>
