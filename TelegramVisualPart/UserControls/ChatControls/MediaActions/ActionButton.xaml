<UserControl x:Class="TelegramVisualPart.UserControls.ChatControls.MediaActions.ActionButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls.ChatControls.MediaActions"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Name="TestGrid"
              Background="Transparent"
              MouseEnter="TestGrid_MouseEnter"
              MouseLeave="TestGrid_MouseLeave">
        <Border Name="TestBorder" VerticalAlignment="Center"
                    HorizontalAlignment="Center" Background="Transparent" CornerRadius="50">
            <materialDesign:PackIcon Kind="GuyFawkesMask" Width="50" Height="50"
                                         Foreground="White" Name="TestIcon"/>
        </Border>
    </Grid>
</UserControl>
