<UserControl x:Class="TelegramVisualPart.UserControls.ChatControls.ChatButsControls.TextBoxMenuButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls.ChatControls.ChatButsControls"
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="250"
             Height="40"
             MouseEnter="UserControl_MouseEnter"
             MouseLeave="UserControl_MouseLeave"
             Background="{StaticResource DarkThemeOne}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <TextBlock Name="LeftTextBlock" Grid.Column="0" 
                   Text="Test Text"
                   Margin="30 0 0 0"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Left"
                   Foreground="{StaticResource UsualTextColor}"
                   FontSize="16"
                   FontFamily="{DynamicResource AppFont}"/>

        <TextBlock Name="RightTextBlock" Grid.Column="1"
                   Text="Test Text"
                   Margin="0 0 30 0"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right"
                   Foreground="{StaticResource TempActiveTextColor}"
                   FontSize="16"
                   FontFamily="{DynamicResource AppFont}"/>
    </Grid>
</UserControl>
