<UserControl x:Class="TelegramVisualPart.UserControls.ChatControls.ImageMessage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls.ChatControls"
             mc:Ignorable="d" 
             d:DesignHeight="65" d:DesignWidth="200" 
             MaxHeight="150">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50" Name="ImageColumnSize"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Ellipse Grid.Column="0" VerticalAlignment="Bottom"
                Name="UserEllipseImage" Width="40" Height="40">
            <Ellipse.Fill>
                <ImageBrush x:Name="BgBrush" ImageSource="/Visuals/Images/UserImages/Minato.jpg"/>
            </Ellipse.Fill>
        </Ellipse>

        
        <Border
        CornerRadius="15" Grid.Column="1"
        BorderThickness="1" Width="125" Height="125">
            <Border.Background>
                <ImageBrush x:Name="ImgMessage" 
                            ImageSource="/Visuals/Images/UserImages/fray.jpg"/>
            </Border.Background>
        </Border>
    </Grid>
</UserControl>
