<UserControl x:Class="TelegramVisualPart.UserControls.ChatControls.LittleMenusContols.AddSoundControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls.ChatControls.LittleMenusContols"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="300"
             Height="40"
             Background="Transparent"
             MouseEnter="UserControl_MouseEnter"
             MouseLeave="UserControl_MouseLeave">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="55"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        
        <Grid HorizontalAlignment="Left" Margin="28 0 0 0">
            <Ellipse Fill="{StaticResource TempActiveTextColor}" 
                 
                 Width="20" Height="20"/>

            <materialDesign:PackIcon Kind="Plus" 
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Center"
                                 Width="15" Height="15"
                                 Foreground="White"/>
        </Grid>
        
        <TextBlock Grid.Column="1" VerticalAlignment="Center"
                   Text="Upload Sound" FontSize="16" Margin="5 0 0 0"
                   Foreground="{StaticResource TempActiveTextColor}"/>
    </Grid>
</UserControl>
