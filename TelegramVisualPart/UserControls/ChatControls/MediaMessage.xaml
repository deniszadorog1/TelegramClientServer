<UserControl x:Class="TelegramVisualPart.UserControls.ChatControls.MediaMessage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls.ChatControls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="65" d:DesignWidth="200" 
             xmlns:Tick="clr-namespace:TelegramVisualPart.UserControls.ChatControls.ChatMessages"
             MouseEnter="UserControl_MouseEnter"
             MouseLeave="UserControl_MouseLeave">

    <UserControl.Resources>
        <Style x:Key="ImageBorderStyle" TargetType="Border">
            <Setter Property="Width" Value="75"/>
            <Setter Property="Height" Value="75"/>
            <Setter Property="Background" Value="Green"/>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50" Name="ImageColumnSize"/>
            <ColumnDefinition/>
            <ColumnDefinition Name="TickColumnDef" Width="0"/>
            <ColumnDefinition Name="GoToMessage" Width="0"/>
        </Grid.ColumnDefinitions>

        <Ellipse Grid.Column="0" VerticalAlignment="Bottom"
                 Name="UserEllipseImage" Width="40" Height="40"
                 MouseEnter="ImageBorder_MouseEnter"
                 MouseLeave="ImageBorder_MouseLeave"
                 PreviewMouseLeftButtonDown="ImageBorder_PreviewMouseLeftButtonDown">
            <Ellipse.Fill>
                <ImageBrush x:Name="BgBrush"/>
            </Ellipse.Fill>
        </Ellipse>

        <Grid Grid.Column="1" x:Name="BigGrid">

            <Grid.RowDefinitions>
                <RowDefinition Name="ForwardedRow" Height="0"/>
                <RowDefinition Name="MediaRow"/>
                <RowDefinition Name="AdditionalTextRow"/>
            </Grid.RowDefinitions>

            <Border Name="ImageBorder" Grid.Row="1"
                    Visibility="Hidden"
                    CornerRadius="15" BorderThickness="1" 
                    Width="125" Height="125">
                <Border.Background>
                    <ImageBrush x:Name="ImgMessage" 
                                ImageSource="/Visuals/Images/UserImages/fray.jpg"/>
                </Border.Background>
            </Border>

            <Border Name="ImgGroupBorder" 
                    Grid.Row="1" 
                    Visibility="Hidden">
                <Grid Name="ImgGroupGrid" 
                      Grid.Row="1" >
                    <Grid.RowDefinitions>
                        <RowDefinition Name = "TopBandRow"/>
                        <RowDefinition Name = "MiddleBandRow"/>
                        <RowDefinition Name = "BottomBandRow"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Name = "LeftBandColumn"/>
                        <ColumnDefinition Name = "MiddleBandColumn"/>
                        <ColumnDefinition Name = "RightBandColumn"/>
                    </Grid.ColumnDefinitions>

                    <Border Name="OneInGroupBorder" 
                            Grid.Row="0" Grid.Column="0"
                            Style="{StaticResource ResourceKey=ImageBorderStyle}">
                        <Border.Background>
                            <ImageBrush x:Name="OneImg"
                                ImageSource="/Visuals/Images/UserImages/fray.jpg"/>
                        </Border.Background>
                    </Border>

                    <Border Name="TwoInGroupBorder" 
                            Grid.Row="0" Grid.Column="1"
                            Style="{StaticResource ResourceKey=ImageBorderStyle}">
                        <Border.Background>
                            <ImageBrush x:Name="TwoImg" 
                                ImageSource="/Visuals/Images/UserImages/fray.jpg"/>
                        </Border.Background>
                    </Border>

                    <Border Name="ThreeInGroupBorder" 
                            Grid.Row="0" Grid.Column="2"
                            Style="{StaticResource ResourceKey=ImageBorderStyle}">
                        <Border.Background>
                            <ImageBrush x:Name="ThreeImg" 
                                ImageSource="/Visuals/Images/UserImages/fray.jpg"/>
                        </Border.Background>
                    </Border>

                    <Border Name="FourInGroupBorder" 
                            Grid.Row="1" Grid.Column="0"
                            Style="{StaticResource ResourceKey=ImageBorderStyle}">
                        <Border.Background>
                            <ImageBrush x:Name="FourImg" 
                                ImageSource="/Visuals/Images/UserImages/fray.jpg"/>
                        </Border.Background>
                    </Border>

                    <Border Name="FiveInGroupBorder" 
                            Grid.Row="1" Grid.Column="1"
                            Style="{StaticResource ResourceKey=ImageBorderStyle}">
                        <Border.Background>
                            <ImageBrush x:Name="FiveImg" 
                                ImageSource="/Visuals/Images/UserImages/fray.jpg"/>
                        </Border.Background>
                    </Border>

                    <Border Name="SixInGroupBorder" 
                            Grid.Row="1" Grid.Column="2"
                            Style="{StaticResource ResourceKey=ImageBorderStyle}">
                        <Border.Background>
                            <ImageBrush x:Name="SixImg" 
                                ImageSource="/Visuals/Images/UserImages/fray.jpg"/>
                        </Border.Background>
                    </Border>

                    <Border Name="SevenInGroupBorder" 
                            Grid.Row="2" Grid.Column="0"
                            Style="{StaticResource ResourceKey=ImageBorderStyle}">
                        <Border.Background>
                            <ImageBrush x:Name="SevenImg" 
                                ImageSource="/Visuals/Images/UserImages/fray.jpg"/>
                        </Border.Background>
                    </Border>

                    <Border Name="EightInGroupBorder" 
                            Grid.Row="2" Grid.Column="1"
                            Style="{StaticResource ResourceKey=ImageBorderStyle}">
                        <Border.Background>
                            <ImageBrush x:Name="EightImg" 
                                ImageSource="/Visuals/Images/UserImages/fray.jpg"/>
                        </Border.Background>
                    </Border>

                    <Border Name="NineInGroupBorder" 
                            Grid.Row="2" Grid.Column="2"
                            Style="{StaticResource ResourceKey=ImageBorderStyle}">
                        <Border.Background>
                            <ImageBrush x:Name="NineImg" 
                                ImageSource="/Visuals/Images/UserImages/fray.jpg"/>
                        </Border.Background>
                    </Border>
                </Grid>
            </Border>

            <Border Name="GifBorder" Grid.Row="1"
                     Visibility="Visible"
                     CornerRadius="20"
                     Background="Transparent"
                     Width="125" Height="125"
                     ClipToBounds="True"
                     SnapsToDevicePixels="True">
                <Image Name="GifImage"/>
            </Border>

            <Border Name="VideoBorder" Grid.Row="1"
                    Visibility="Hidden"
                    CornerRadius="20"
                    Background="Black"
                    Width="125" Height="125"
                    ClipToBounds="True"
                    SnapsToDevicePixels="True">
                <MediaElement Name="MyVideoPlayer"
                              LoadedBehavior="Manual"
                              UnloadedBehavior="Manual"
                              Stretch="UniformToFill"/>
            </Border>

            <Grid VerticalAlignment="Bottom" Grid.Row="1"
                  HorizontalAlignment="Right"
                  Height="20"
                  Margin="0 0 5 3" Background="Transparent"
                  Name="SendInfoGrid" Visibility="Hidden">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Name="PinIconColumn" Width="15"/>
                    <ColumnDefinition />
                    <ColumnDefinition Name="TickColumn" Width="0"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <materialDesign:PackIcon Name="PinnIcon" Visibility="Hidden"
                                                 HorizontalAlignment="Right"
                                                 Foreground="{StaticResource UsualTextColor}"
                                                 Kind="PinOutline"/>
                </Grid>

                <TextBlock Name="TimeBlock" Text="99:99" Visibility="Visible"
                           Grid.Column="1"
                           FontSize="14"
                           Foreground="{StaticResource UsualTextColor}"
                           HorizontalAlignment="Right" Margin="0 0 5 0"/>

                <materialDesign:PackIcon Name="TickIcon" Grid.Column="2"
                                         Foreground="{StaticResource TempActiveTextColor}"
                                         HorizontalAlignment="Right" Height="20" Width="20"
                                         Kind="Tick" Visibility="Hidden"/>
            </Grid>


            <Grid Grid.Row="0" Name="ForwardedGrid" 
                      Visibility="Visible" Margin=" 0">
                <TextBlock FontSize="12" TextWrapping="Wrap"
                        Foreground="{StaticResource TempActiveTextColor}">
                        <Run Name="FromRun" Text="Forwarded from"/>
                        <Run Name="LoginForwarded" Text="Login" Background="Transparent"
                             
                             MouseEnter="LoginForwarded_MouseEnter"
                             MouseLeave="LoginForwarded_MouseLeave"
                             PreviewMouseLeftButtonDown="LoginForwarded_PreviewMouseDown"
                             />
                </TextBlock>
            </Grid>
        </Grid>
        <Grid Grid.Column="2">
            <Tick:SelectionTick x:Name="SelectionTickObj"
                                Width="20" Height="20"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Right"/>
        </Grid>

        <Grid Grid.Column="3" Width="30" Height="30"
              Name="GoToForwardedGrid"
              MouseEnter="GoToForwardedGrid_MouseEnter"
              MouseLeave="GoToForwardedGrid_MouseLeave"
              PreviewMouseLeftButtonDown="GoToForwardedGrid_PreviewMouseLeftButtonDown">

            <Ellipse Height="25" Width="25"
                     Fill="Black" Opacity="0.2"/>

            <materialDesign:PackIcon Kind="MessageTextOutline"
                                     Height="15" Width="15"
                                     Name="Text"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Center"
                                     Foreground="White"/>

        </Grid>

    </Grid>
</UserControl>
