<UserControl x:Class="TelegramVisualPart.UserControls.ChatControls.MediaMessage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls.ChatControls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="65" d:DesignWidth="200" 
             MaxHeight="150"
             MouseEnter="UserControl_MouseEnter"
             MouseLeave="UserControl_MouseLeave">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50" Name="ImageColumnSize"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Ellipse Grid.Column="0" VerticalAlignment="Bottom"
                Name="UserEllipseImage" Width="40" Height="40">
            <Ellipse.Fill>
                <ImageBrush x:Name="BgBrush" ImageSource="/Visuals/Images/UserImages/Minato.jpg"/>
            </Ellipse.Fill>
        </Ellipse>


        <Border Name="ImageBorder" Visibility="Hidden"
            CornerRadius="15" Grid.Column="1"
            BorderThickness="1" Width="125" Height="125">
            <Border.Background>
                <ImageBrush x:Name="ImgMessage" 
                            ImageSource="/Visuals/Images/UserImages/fray.jpg"/>
            </Border.Background>
        </Border>

        <Border Name="GifBorder"
                 Visibility="Visible"
                 Grid.Column="1"
                 CornerRadius="20"
                 Background="Transparent"
                 Width="125" Height="125"
                 ClipToBounds="True"
                 SnapsToDevicePixels="True">
            <Image Name="GifImage"/>
        </Border>


        <Border Name="VideoBorder"
                Visibility="Hidden"
                Grid.Column="1"
                CornerRadius="20"
                Background="Black"
                Width="125" Height="125"
                ClipToBounds="True"
                SnapsToDevicePixels="True">
            <MediaElement Name="MyVideoPlayer"
                          LoadedBehavior="Manual"
                          UnloadedBehavior="Manual"
                          Stretch="UniformToFill"/>
        </Border>

        <Grid Grid.Column="1"   
              VerticalAlignment="Bottom"
              HorizontalAlignment="Right"
              Width="60" Height="20"
              Margin="0 0 5 3" Background="Transparent"
              Name="SendInfoGrid" Visibility="Hidden">

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Name="TickColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <TextBlock Name="TimeBlock" Text="99:99"
                       FontSize="14" 
                       Foreground="{StaticResource UsualTextColor}"
                       HorizontalAlignment="Right" Margin="0 0 5 0"/>

            <materialDesign:PackIcon Name="TickIcon" Grid.Column="1"
                                     Foreground="{StaticResource TempActiveTextColor}"
                                     HorizontalAlignment="Right" Height="20" Width="20"
                                     Kind="Tick" Visibility="Hidden"/>

        </Grid>
    </Grid>
</UserControl>
