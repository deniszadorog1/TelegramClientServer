<UserControl x:Class="TelegramVisualPart.UserControls.ChatControls.TextMessage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls.ChatControls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="200">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50" Name="ImageColumnSize"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Ellipse Grid.Column="0" VerticalAlignment="Bottom"
                Name="UserEllipseImage" Width="40" Height="40">
            <Ellipse.Fill>
                <ImageBrush x:Name="BgBrush" ImageSource="/Visuals/Images/UserImages/Minato.jpg"/>
            </Ellipse.Fill>
        </Ellipse>

        <Border Grid.Column="1" Name="MessageColor" CornerRadius="15"
                Background="{StaticResource DarkThemeDeviderField}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="20"/>
                </Grid.RowDefinitions>

                <TextBlock Name ="Message" Text="test" VerticalAlignment="Top"
                           Grid.Row="0"
                       Margin="10 -10 7 5" Foreground="{StaticResource UsualTextColor}" FontSize="14"/>

                <Grid Grid.Row="1" Margin="0 0 7 5"
                            Name="BottomPanel">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="0" x:Name="TickColumn"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Name ="SentTime"  Text="time"
                           HorizontalAlignment="Right"
                           Foreground="Gray" FontSize="13" VerticalAlignment="Bottom"/>

                    <materialDesign:PackIcon Grid.Column="1" 
                                             Name="ReadIconFlag"
                                             HorizontalAlignment="Right"
                                             Foreground="{StaticResource TempActiveTextColor}"
                                             Margin="0 0 5 0"
                                             Kind="TickAll"/>

                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
