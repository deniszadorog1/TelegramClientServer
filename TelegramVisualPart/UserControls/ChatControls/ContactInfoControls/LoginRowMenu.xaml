<UserControl x:Class="TelegramVisualPart.UserControls.ChatControls.ContactInfoControls.LoginRowMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls.ChatControls.ContactInfoControls"
             mc:Ignorable="d" 
             d:DesignHeight="250" d:DesignWidth="250"
             
             Width="200"
             >
    <Border CornerRadius="5" 
            Background="{StaticResource DarkThemeSecond}" 
            BorderBrush="Black"
            BorderThickness="1">
        <StackPanel Name="MenuPanel"
                    Orientation="Vertical">

            <Grid Name="CopyTextGrid" Height="35" 
                  Margin="0 5 0 5" 
                  Background="Transparent"
                  MouseEnter="CopyTextGrid_MouseEnter"
                  MouseLeave="CopyTextGrid_MouseLeave"
                  PreviewMouseLeftButtonDown="CopyTextGrid_PreviewMouseLeftButtonDown"
                  >
                <TextBlock Name="CopyTextButton"
                           Text="Copy Username"
                           VerticalAlignment="Center"
                           Margin="15 0 0 0"
                           Foreground="White"
                           FontFamily="{DynamicResource AppFont}"
                           FontSize="17"/>
            </Grid>

        </StackPanel>
    </Border>
</UserControl>
