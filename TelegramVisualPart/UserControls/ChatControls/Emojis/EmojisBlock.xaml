<UserControl x:Class="TelegramVisualPart.UserControls.ChatControls.Emojis.EmojisBlock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls.ChatControls.Emojis"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="350" d:DesignWidth="365"
             Height="350" Width="325">

    <UserControl.Resources>
        <Style x:Key="IconsStyle" TargetType="materialDesign:PackIcon">
            <Setter Property="Margin" Value="5 0 5 0"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="Width" Value="25"/>
            <Setter Property="Height" Value="25"/>
        </Style>
    </UserControl.Resources>
    
    
    <Border x:Name="BorderBg" Background="{StaticResource DarkThemeOne}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid>

                <Border Grid.Row="0" Margin="10 5 10 0" CornerRadius="20" Name="SearchBorder"
                        Background="{StaticResource DarkThemeDeviderField}">
                    <Grid>
                        
                        <materialDesign:PackIcon Kind="Magnify" Width="25" Height="25"
                                                 VerticalAlignment="Center"
                                                 HorizontalAlignment="Left"
                                                 Foreground="Gray"
                                                 Margin="5 0 0 0"/>

                        <TextBox Grid.Row="0"  Name="SarchBox" 
                          Foreground="White" Margin="35 0 10 0" FontSize="14"
                          materialDesign:TextFieldAssist.UnderlineBrush="{StaticResource DarkThemeMouseEnterBut}" 
                          materialDesign:HintAssist.Foreground="Gray"
                          CaretBrush="White" MaxLength="10"/>

                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="0 0 10 0">

                            <materialDesign:PackIcon Kind="Heart" Style="{StaticResource IconsStyle}"/>
                            <materialDesign:PackIcon Kind="Like" Style="{StaticResource IconsStyle}"/>
                            <materialDesign:PackIcon Kind="Dislike" Style="{StaticResource IconsStyle}"/>
                        </StackPanel>
                        
                    </Grid>
                </Border>
            </Grid>

            <WrapPanel Grid.Row="1" Name="EmojisPanel" Grid.RowSpan="2">
<!--            <local:Emoji/>
                <local:Emoji/>
                <local:Emoji/>
                <local:Emoji/>
                <local:Emoji/>
                <local:Emoji/>
                <local:Emoji/>
                <local:Emoji/>
                <local:Emoji/> -->
            </WrapPanel>
        </Grid>
    </Border>
</UserControl>
