<UserControl x:Class="TelegramVisualPart.UserControls.ChatControls.Emojis.Emoji"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls.ChatControls.Emojis"
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="40"
             Height="40" Width="40"
             MouseEnter="UserControl_MouseEnter"
             MouseLeave="UserControl_MouseLeave"
             PreviewMouseDown="UserControl_PreviewMouseDown"
             Margin="1">
    <Grid Background="{StaticResource DarkThemeOne}">
        <Border x:Name="BorderBg" Background="Transparent"
                CornerRadius="10">
            <TextBlock x:Name="EmojiBlock" Text="😀" 
                       FontFamily="Segoe UI Emoji"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontSize="26"/>
        </Border>
    </Grid>
</UserControl>
