<UserControl x:Class="TelegramVisualPart.UserControls.ChatControls.Emojis.FullVisualsBlock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls.ChatControls.Emojis"
             xmlns:wpfAnimatedGif="http://wpfanimatedgif.codeplex.com"
             mc:Ignorable="d" 
             d:DesignHeight="420" d:DesignWidth="350"
             Height="420" Width="350">

    <UserControl.Resources>
        <Style x:Key="Tabs" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="40 0 40 0"/>
            <EventSetter Event="PreviewMouseDown" Handler="TextBlock_PreviewMouseDown"/>
        </Style>
    </UserControl.Resources>

    <Border x:Name="BorderBg" Background="{StaticResource DarkThemeOne}" CornerRadius="15">
        <Grid Margin="0 10 0 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Name="TypesToSearchGrid">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="5"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Name="TabsPanel" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource Tabs}" Name="EmojiTab" Text="Emoji" 
                               Foreground="{StaticResource TempActiveTextColor}"
                               PreviewMouseDown="EmojiTab_PreviewMouseDown"/>

                    <TextBlock Style="{StaticResource Tabs}" Name="StickersTab" Text="Stickers"
                               PreviewMouseDown="StickersTab_PreviewMouseDown"/>

                    <TextBlock Style="{StaticResource Tabs}" Name="GIFsTab" Text="GIFs"
                               PreviewMouseDown="GIFsTab_PreviewMouseDown"/>
                </StackPanel>

                <Grid Grid.Row="1" Name="RectGrid">
                    <Rectangle Name="ActiveRect" Fill="{StaticResource TempActiveTextColor}" Width="35"
                   Height="4"
                   HorizontalAlignment="Left" Margin="40 0 0 0"
                   VerticalAlignment="Top">
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="ActiveRectTransform" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Grid>
            </Grid>

            <local:EmojisBlock Grid.Row="1" x:Name="EmojisPanel"
                               VerticalAlignment="Top" Margin="0 10 0 0" Visibility="Hidden"/>

            <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                          Name="GifScroll" 
                          VerticalScrollBarVisibility="Auto" Grid.Row="1">
                <WrapPanel Name="GIFsPanel" Margin="5">
                    <Image Width="100"
                           Height="100"
                           Margin="2"
                           Stretch="Uniform"
                           wpfAnimatedGif:ImageBehavior.AnimatedSource="/Visuals/Gifs/TestGif.gif"/>
                </WrapPanel>
            </ScrollViewer>

            <ScrollViewer HorizontalScrollBarVisibility="Hidden" Name="StickerScroll"
                          VerticalScrollBarVisibility="Auto" Visibility="Hidden"
                          Grid.Row="1">
                <WrapPanel Name="StickerPanel" Visibility="Visible">
                    <Image Name="TestGirlSticker" 
                           Tag="Girl.png"
                           Width="100" Height="100" Margin="5"
                           Source="/Visuals/Images/Stickers/Girl.png"
                           PreviewMouseDown="Sticker_PreviewMouseDown"/>

                    <Image Name="TestFigSticker"
                           Tag="Figure.png"
                           Width="100" Height="100" Margin="5"
                           Source="/Visuals/Images/Stickers/Figure.png" 
                           PreviewMouseDown="Sticker_PreviewMouseDown"/>
                </WrapPanel>
            </ScrollViewer>
            
        </Grid>
    </Border>
</UserControl>
