<UserControl x:Class="TelegramVisualPart.UserControls.ChatControls.ChatMessages.MessageMenu.MesMenuBut"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls.ChatControls.ChatMessages.MessageMenu"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="320"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             
             MouseEnter="UserControl_MouseEnter"
             MouseLeave="UserControl_MouseLeave"
             
             Margin="0 5 0 5">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <materialDesign:PackIcon Grid.Column="0"
                                 Kind="Reply"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Center"
                                 Width="30"
                                 Height="30"
                                 Name="Icon"
                                 Foreground="White"/>

        <TextBlock Grid.Column="1"
                   Name="ButText"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Left"
                   Margin="5 0 0 0"
                   FontSize="15"
                   Foreground="{StaticResource UsualTextColor}"
                   Text="There should be button text name"/>

    </Grid>
</UserControl>
