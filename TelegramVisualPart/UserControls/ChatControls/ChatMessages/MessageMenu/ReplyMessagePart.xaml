<UserControl x:Class="TelegramVisualPart.UserControls.ChatControls.ChatMessages.MessageMenu.ReplyMessagePart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls.ChatControls.ChatMessages.MessageMenu"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="200"
             
             MouseEnter="UserControl_MouseEnter" 
             MouseLeave="UserControl_MouseLeave">

    <Border BorderThickness="5 0.5 0.5 0.5" CornerRadius="6"
            BorderBrush="{StaticResource TempActiveTextColor}">
        <Grid Margin="5 0 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ImageColumn" Width="30"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Border Grid.ColumnSpan="2" Background="{StaticResource TempActiveTextColor}"
                  Opacity="0.3" Margin="-5 0 0 0" CornerRadius="5"/>
            <Grid Grid.Column="0" Margin="0">
                <Image Name="ReplyImage" Height="30"
                       Width="30"/>
            </Grid>
            
            <Grid Grid.Column="1" Margin="5 0 5 0"
                  Name="TextGrid" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Name="WhoSent" Grid.Row="0"
                       Text="FromSenderLogin" Foreground="{StaticResource TempActiveTextColor}"
                       VerticalAlignment="Center"/>
                <TextBlock Name="ReplyedMessage" Grid.Row="1"
                           Text="ReplyedText"
                           Foreground="{StaticResource UsualTextColor}"/>
            </Grid>

            <Grid Name="DeleteMessageGrid" Grid.ColumnSpan="2" Visibility="Hidden">
                <TextBlock Text="Message Deleted"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TempActiveTextColor}"/>
            </Grid>
            
        </Grid>
    </Border>
</UserControl>
