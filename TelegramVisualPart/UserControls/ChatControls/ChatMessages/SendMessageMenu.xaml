<UserControl x:Class="TelegramVisualPart.UserControls.ChatControls.ChatMessages.SendMessageMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls.ChatControls.ChatMessages"
             mc:Ignorable="d" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:menuBut="clr-namespace:TelegramVisualPart.UserControls.ChatControls.ChatMessages.MessageMenu"
             d:DesignHeight="150" d:DesignWidth="300"
             Width="200">
    <Border CornerRadius="5" 
            BorderBrush="Black"
            BorderThickness="1"
            Background="{StaticResource DarkThemeOne}">
        <StackPanel Orientation="Vertical">
            <menuBut:MesMenuBut x:Name="ScedSend"
                                MouseLeftButtonDown="ScedSend_MouseLeftButtonDown"/>
        </StackPanel>
    </Border>
</UserControl>
