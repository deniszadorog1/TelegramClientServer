<UserControl x:Class="TelegramVisualPart.UserControls.ChatControls.ItemsSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls.ChatControls"
             mc:Ignorable="d" HorizontalAlignment="Left"
             Margin="20 0 0 0"
             d:DesignHeight="50" d:DesignWidth="300">

    <UserControl.Resources>
        <Style x:Key="Tabs" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="40 0 40 0"/>
        </Style>
    </UserControl.Resources>

    <Grid Grid.Row="0" Name="TypesToSearchGrid" 
          HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="5"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Name="TabsPanel" HorizontalAlignment="Center">
            <TextBlock Style="{StaticResource Tabs}" Name="EmojiTab" Text="Emoji" 
                               Foreground="{StaticResource TempActiveTextColor}"/>

            <TextBlock Style="{StaticResource Tabs}" Name="StickersTab" Text="Stickers"/>

            <TextBlock Style="{StaticResource Tabs}" Name="GIFsTab" Text="GIFs"/>
        </StackPanel>

        <Grid Grid.Row="1" Name="RectGrid">
            <Rectangle Name="ActiveRect" 
                       Fill="{StaticResource TempActiveTextColor}" Width="35"
                   Height="4"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top">
                <Rectangle.RenderTransform>
                    <TranslateTransform x:Name="ActiveRectTransform" />
                </Rectangle.RenderTransform>
            </Rectangle>
        </Grid>
    </Grid>
</UserControl>
