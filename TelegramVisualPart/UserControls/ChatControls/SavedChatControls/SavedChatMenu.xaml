<UserControl x:Class="TelegramVisualPart.UserControls.ChatControls.SavedChatControls.SavedChatMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls.ChatControls.SavedChatControls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"    
             xmlns:mediaParam="clr-namespace:TelegramVisualPart.UserControls.ChatControls.SavedChatControls"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="450"
             Loaded="UserControl_Loaded">
    <Border Background="{StaticResource DarkThemeOne}"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Name="UpperRow" Height="50"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                
                <TextBlock Name="ControlName" Text="Saved message"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Foreground="White"
                           FontSize="18"
                           Margin="20 0 0 0"/>

                <Grid Name="CloseButtonGrid"
                      HorizontalAlignment="Right"
                      Background="Transparent"
                      Width="30" Height="30"
                      Margin="0 0 20 0"
                      MouseEnter="CloseButtonGrid_MouseEnter"
                      MouseLeave="CloseButtonGrid_MouseLeave"
                      PreviewMouseLeftButtonDown="CloseButtonGrid_PreviewMouseLeftButtonDown">

                    <materialDesign:PackIcon Name="CloseIcon"
                                             Kind="Close"
                                             Width="25" Height="25"
                                             Foreground="Gray"
                                             VerticalAlignment="Stretch"
                                             HorizontalAlignment="Stretch"/>
                </Grid>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="MediaTypesRow"/>
                    <RowDefinition x:Name="DividerRow" Height="15"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <StackPanel Name="SentParamsGrid" Grid.Row="0" 
                      VerticalAlignment="Top">
                    <mediaParam:MediaParam x:Name="PhotoMedia" PreviewMouseLeftButtonDown="SentMedia_PreviewMouseLeftButtonDown"/>
                    <mediaParam:MediaParam x:Name="VideoMedia" PreviewMouseLeftButtonDown="SentMedia_PreviewMouseLeftButtonDown"/>
                    <mediaParam:MediaParam x:Name="LinkMedia" PreviewMouseLeftButtonDown="SentMedia_PreviewMouseLeftButtonDown"/>
                    <mediaParam:MediaParam x:Name="GifMedia" PreviewMouseLeftButtonDown="SentMedia_PreviewMouseLeftButtonDown"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0 5 0 5" Background="{StaticResource DarkThemeSecond}"/>

                <ListBox Name="ChatsMessagesListBox"
                         Grid.Row="2">
                    
                </ListBox>
                
            </Grid>
            
            
        </Grid> 
    </Border>
</UserControl>
