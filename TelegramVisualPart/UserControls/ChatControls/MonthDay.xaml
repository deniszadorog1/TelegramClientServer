<UserControl x:Class="TelegramVisualPart.UserControls.ChatControls.MonthDay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls.ChatControls"
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="145">
    <Border Background="Gray" CornerRadius="20">
        <Grid Margin="5 0 5 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Name ="Day" Text="33"  VerticalAlignment="Center" HorizontalAlignment="Center"
                       FontSize="20" Foreground="White"/>
            <TextBlock Grid.Column="1" Name ="Month" Text="October"  VerticalAlignment="Center" HorizontalAlignment="Center"
                       FontSize="20" Foreground="White" Margin="5 0 0 0"/>
        </Grid>
    </Border>
</UserControl>
