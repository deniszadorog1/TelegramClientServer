<UserControl x:Class="TelegramVisualPart.UserControls.ChatControls.ContactInfo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls.ChatControls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:buts="clr-namespace:TelegramVisualPart.UserControls.DifferButs"
             xmlns:otherButs="clr-namespace:TelegramVisualPart.UserControls"
             xmlns:menu="clr-namespace:TelegramVisualPart.UserControls.ChatControls.UserContactControls"
             mc:Ignorable="d" 
             d:DesignHeight="855" d:DesignWidth="450"
             Width="450">
    <Border Name="BgBorder" CornerRadius="15" 
            Background="{StaticResource DarkThemeOne}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60" x:Name="UpperRow"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center"
                           FontSize="22" Text="User Info"
                           Foreground="{StaticResource UsualTextColor}"/>

                <StackPanel Orientation="Horizontal" Grid.Column="1"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Grid Name ="MenuButGrid" Background="Transparent"
                          MouseEnter="MenuButGrid_MouseEnter"
                          MouseLeave="MenuButGrid_MouseLeave"
                          PreviewMouseDown="MenuButGrid_MouseDown">
                        <materialDesign:PackIcon Kind="DotsVertical" Name="MoreInfoBut"
                                             Margin="0 0 10 0"
                                             Width="25" Height="25"
                                             Foreground="Gray"/>
                    </Grid>

                    <Grid Name="CloseButGrid" Background="Transparent"
                          MouseEnter="CloseButGrid_MouseEnter"
                          MouseLeave="CloseButGrid_MouseLeave"
                          MouseDown="CloseButGrid_MouseDown">
                        <materialDesign:PackIcon Kind="Close" Name="CloseBut"
                                             Margin="0 0 20 0"
                                             Width="25" Height="25"
                                             Foreground="Gray"/>
                    </Grid>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" Margin="0 10 0 10" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="115"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="275"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="155"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="200"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" VerticalAlignment="Top" Margin="10 5 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <Ellipse Grid.Row="0" Name ="UserIcon" 
                                 Width="90" Height="90" HorizontalAlignment="Center"
                                 PreviewMouseDown="UserIcon_PreviewMouseDown"
                                 MouseEnter="UserIcon_MouseEnter"
                                 MouseLeave="UserIcon_MouseLeave"
                                 IsHitTestVisible="False">
                            <Ellipse.Fill>
                                <ImageBrush x:Name="ContactImgBrush"  ImageSource="/Visuals/Images/UserImages/Minato.jpg"/>
                            </Ellipse.Fill>
                        </Ellipse>

                        <Grid Grid.Column="1" Margin="15 0 0 0">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Name="Username" Text="There gona be username"
                                       VerticalAlignment="Center" FontSize="18"
                                       Foreground="{StaticResource UsualTextColor}"/>

                            <TextBlock Grid.Row="1" Name="LastSeenOnline" 
                                       Text="There gona be last seen online" 
                                       Foreground="Gray" FontSize="14"/>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="1" Background="{StaticResource DarkThemeDeviderField}"/>

                    <Grid Grid.Row="2" Margin="0 5 0 5">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition Height="40"/>
                            </Grid.RowDefinitions>

                            <materialDesign:PackIcon Kind="InfoOutline" Grid.Row="0" Grid.Column="0"
                                                 VerticalAlignment="Center" HorizontalAlignment="Center"
                                                 Height="30" Width="30" Name="InfoIcon"
                                                 Foreground="{StaticResource UsualTextColor}"/>

                            <local:DoubleText Grid.Row="0" Grid.Column="1" x:Name="MobileNumber" VerticalAlignment="Center"/>
                            <local:DoubleText Grid.Row="1" Grid.Column="1" x:Name="UserName" VerticalAlignment="Center"/>
                            <local:DoubleText Grid.Row="2" Grid.Column="1" x:Name="Birthdate" VerticalAlignment="Center"/>


                            <materialDesign:PackIcon Kind="BellOutline" Grid.Row="3" Grid.Column="0"
                                                 VerticalAlignment="Center" HorizontalAlignment="Center"
                                                 Height="30" Width="30" Name="BellIcon"
                                                 Foreground="{StaticResource UsualTextColor}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Text="Notifications"
                                       Foreground="{StaticResource UsualTextColor}" FontSize="16"/>
                            <ToggleButton Name ="NotificationToggle" Width="35"
                                          Grid.Column="2" Grid.Row="3"
                                          Checked="NotificationToggle_Checked"
                                          Unchecked="NotificationToggle_Unchecked"
                                          HorizontalAlignment="Right"
                                          MouseEnter="UserIcon_MouseEnter"
                                          MouseLeave="UserIcon_MouseLeave"
                                          Margin="0 0 20 0"
                                          Style="{StaticResource MaterialDesignSwitchDarkToggleButton}"
                                          ToolTip="MaterialDesignSwitchDarkToggleButton"                      
                                          IsChecked="True" 
                                          Background="{StaticResource TempActiveTextColor}"/>

                            <Grid Grid.ColumnSpan="3" Grid.Row="4" Name ="SendMessageBut"
                                  MouseEnter="But_MouseEnter"
                                  MouseLeave="But_MouseLeave" Background="Transparent"
                                  PreviewMouseDown="SendMessageBut_PreviewMouseDown"/>

                            <TextBlock Grid.Column="1" Grid.Row="4" Text="SEND MESSAGE" 
                                       FontSize="16"
                                       VerticalAlignment="Center" HorizontalAlignment="Left"
                                       Foreground="{StaticResource TempActiveTextColor}"
                                       FontWeight="SemiBold" MouseEnter="But_MouseEnter" />
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="3" Background="{StaticResource DarkThemeDeviderField}"/>

                    <Grid Grid.Row="4" Margin="0 5 0 5">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <!--<RowDefinition/>
                            <RowDefinition/> -->
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.ColumnSpan="2" Grid.Row="0" Background="Transparent" Name="PhotosLine"
                              MouseEnter="But_MouseEnter" MouseLeave="But_MouseLeave"
                              PreviewMouseDown="Line_PreviewMouseDown"/>
                        <Grid Grid.ColumnSpan="2" Grid.Row="1" Background="Transparent" Name="VideosLine"
                              MouseEnter="But_MouseEnter" MouseLeave="But_MouseLeave"
                              PreviewMouseDown="Line_PreviewMouseDown"/>
                        <Grid Grid.ColumnSpan="2" Grid.Row="2" Background="Transparent" Name="FilesLine"
                              MouseEnter="But_MouseEnter" MouseLeave="But_MouseLeave"
                              PreviewMouseDown="Line_PreviewMouseDown"/>
                        <Grid Grid.ColumnSpan="2" Grid.Row="3" Background="Transparent" Name="LinksLine"
                              MouseEnter="But_MouseEnter" MouseLeave="But_MouseLeave"
                              PreviewMouseDown="Line_PreviewMouseDown"/>
                        <Grid Grid.ColumnSpan="2" Grid.Row="4" Background="Transparent" Name="GIFsLine"
                              MouseEnter="But_MouseEnter" MouseLeave="But_MouseLeave"
                              PreviewMouseDown="Line_PreviewMouseDown"/>

                        <materialDesign:PackIcon Kind="BrokenImage" Grid.Row="0" Grid.Column="0"
                                                 VerticalAlignment="Center" HorizontalAlignment="Center"
                                                 Height="30" Width="30" Name="ImageIcon"
                                                 Foreground="{StaticResource UsualTextColor}"/>

                        <materialDesign:PackIcon Kind="VideoOutline" Grid.Row="1" Grid.Column="0"
                                                 VerticalAlignment="Center" HorizontalAlignment="Center"
                                                 Height="30" Width="30" Name="VideoIcon"
                                                 Foreground="{StaticResource UsualTextColor}"/>

                        <!--  <materialDesign:PackIcon Kind="FileOutline" Grid.Row="2" Grid.Column="0"
                                                 VerticalAlignment="Center" HorizontalAlignment="Center"
                                                 Height="30" Width="30" Foreground="White" Name="FileIcon"/>

                        <materialDesign:PackIcon Kind="Link" Grid.Row="3" Grid.Column="0"
                                                 VerticalAlignment="Center" HorizontalAlignment="Center"
                                                 Height="30" Width="30" Foreground="White" Name="LinkIcon"/>
-->
                        <materialDesign:PackIcon Kind="FileGifBox" Grid.Row="4" Grid.Column="0"
                                                 VerticalAlignment="Center" HorizontalAlignment="Center"
                                                 Height="30" Width="30" Name="GifIcon"
                                                 Foreground="{StaticResource UsualTextColor}"/>

                        <TextBlock Grid.Column="1" Grid.Row="0" Text="Amount of photos" 
                                   Name="AmountOfPhotosTextBlock" FontSize="16"
                                   VerticalAlignment="Center" HorizontalAlignment="Left"
                                   Foreground="{StaticResource UsualTextColor}" MouseEnter="But_MouseEnter"/>

                        <TextBlock Grid.Column="1" Grid.Row="1" Text="Amount of videos" 
                                   Name="AmountOfVideosTextBlock" FontSize="16"
                                   VerticalAlignment="Center" HorizontalAlignment="Left"
                                   Foreground="{StaticResource UsualTextColor}" MouseEnter="But_MouseEnter"/>

                        <!--   <TextBlock Grid.Column="1" Grid.Row="2" Text="Amount of fiels" 
                                   Name="AmountOfFilesTextBlock" FontSize="16" 
                                   VerticalAlignment="Center" HorizontalAlignment="Left"
                                   Foreground="White" MouseEnter="But_MouseEnter"/>
                       
                        <TextBlock Grid.Column="1" Grid.Row="3" Text="Amount of shared links" 
                                   Name="AmountOfLinksTextBlock" FontSize="16"
                                   VerticalAlignment="Center" HorizontalAlignment="Left"
                                   Foreground="White" MouseEnter="But_MouseEnter"/> -->

                        <TextBlock Grid.Column="1" Grid.Row="4" Text="Amount of GIFs" 
                                   Name="AmountOfGifsTextBlock" FontSize="16"
                                   VerticalAlignment="Center" HorizontalAlignment="Left"
                                   Foreground="{StaticResource UsualTextColor}" MouseEnter="But_MouseEnter"/>
                    </Grid>
                    <Grid Grid.Row="5" Background="{StaticResource DarkThemeDeviderField}"/>

                    <Grid Grid.Row="6" Margin="0 5 0 5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <Grid Grid.ColumnSpan="2" Grid.Row="0" Background="Transparent" Name="ShareLine"
                              MouseEnter="But_MouseEnter" MouseLeave="But_MouseLeave" 
                              PreviewMouseDown="ShareLine_PreviewMouseDown"/>
                        <Grid Grid.ColumnSpan="2" Grid.Row="1" Background="Transparent" Name="EditContactLine"
                              MouseEnter="But_MouseEnter" MouseLeave="But_MouseLeave" 
                              PreviewMouseDown="EditContactLine_PreviewMouseDown"/>
                        <Grid Grid.ColumnSpan="3" Grid.Row="2" Background="Transparent" Name="DeleteLine" 
                              MouseEnter="But_MouseEnter" MouseLeave="But_MouseLeave" 
                                  PreviewMouseDown="DeleteLine_PreviewMouseDown"/>
                        <Grid Grid.ColumnSpan="3" Grid.Row="3" Background="Transparent" Name="BlockLine" 
                              MouseEnter="But_MouseEnter" MouseLeave="But_MouseLeave" 
                                  PreviewMouseDown="BlockLine_PreviewMouseDown"/>


                        <materialDesign:PackIcon Kind="ShareOutline" Grid.Row="0" Grid.Column="0"
                                                 VerticalAlignment="Center" HorizontalAlignment="Center"
                                                 Height="30" Width="30" Foreground="{StaticResource UsualTextColor}" Name="SendIcon"/>
                        <materialDesign:PackIcon Kind="PencilOutline" Grid.Row="1" Grid.Column="0"
                                                 VerticalAlignment="Center" HorizontalAlignment="Center"
                                                 Height="30" Width="30" Foreground="{StaticResource UsualTextColor}" Name="PenIcon"/>
                        <materialDesign:PackIcon Kind="TrashCan" Grid.Row="2" Grid.Column="0"
                                                 VerticalAlignment="Center" HorizontalAlignment="Center"
                                                 Height="30" Width="30" Foreground="{StaticResource UsualTextColor}" Name ="CanIcon"/>
                        <materialDesign:PackIcon Kind="Hand" Grid.Row="3" Grid.Column="0" Name="HandIcon"
                                                 VerticalAlignment="Center" HorizontalAlignment="Center"
                                                 Height="30" Width="30" Foreground="{StaticResource ToBlockContact}"/>

                        <TextBlock Grid.Column="1" Grid.Row="0" Text="Share this contact" 
                                       FontSize="16"
                                       VerticalAlignment="Center" HorizontalAlignment="Left"
                                       Foreground="{StaticResource UsualTextColor}" MouseEnter="But_MouseEnter" />
                        <TextBlock Grid.Column="1" Grid.Row="1" Text="Edit contact" FontSize="16"
                                       VerticalAlignment="Center" HorizontalAlignment="Left"
                                       Foreground="{StaticResource UsualTextColor}" MouseEnter="But_MouseEnter" />
                        <TextBlock Grid.Column="1" Grid.Row="2" Text="Delete contact" FontSize="16"
                                       VerticalAlignment="Center" HorizontalAlignment="Left"
                                       Foreground="{StaticResource UsualTextColor}" MouseEnter="But_MouseEnter" />
                        <TextBlock Grid.Column="1" Grid.Row="3" Text="Block user" FontSize="16"
                                   FontWeight="SemiBold"
                                       VerticalAlignment="Center" HorizontalAlignment="Left"
                                       Foreground="{StaticResource ToBlockContact}" MouseEnter="But_MouseEnter" />
                    </Grid>

                </Grid>
            </ScrollViewer>

            <menu:UserContactMenu x:Name="ContactMenu" 
                                    Grid.Column="1" Grid.RowSpan="3"  
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Panel.ZIndex="100"
                                    Visibility="Hidden"/>
        </Grid>
    </Border>
</UserControl>
