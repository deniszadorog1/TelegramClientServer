<UserControl x:Class="TelegramVisualPart.UserControls.ChatsSearch.SearchMediaMenuFolder.SearchMediaMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls.ChatsSearch.SearchMediaMenuFolder"
             xmlns:MenuItem="clr-namespace:TelegramVisualPart.UserControls.ChatsSearch.SearchMediaMenuFolder"
             mc:Ignorable="d" 
             d:DesignHeight="150" d:DesignWidth="200">
    <Border  Background="{StaticResource DarkThemeOne}" CornerRadius="10">
        <StackPanel Name ="MenuStack"  
                    Margin="0 10 0 10"
                    Orientation="Vertical">
            <MenuItem:SearchMediaMenuItem x:Name="GoToMessage"
                                          PreviewMouseLeftButtonDown="GoToMessage_PreviewMouseLeftButtonDown"/>
            <MenuItem:SearchMediaMenuItem x:Name="ForwardMessage"
                                          PreviewMouseLeftButtonDown="ForwardMessage_PreviewMouseLeftButtonDown"/>
        </StackPanel>   
    </Border>
</UserControl>
