<UserControl x:Class="TelegramVisualPart.UserControls.ChatsSearch.SearchMessage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls.ChatsSearch"
             xmlns:closeBut="clr-namespace:TelegramVisualPart.UserControls.DifferButs"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="130" d:DesignWidth="200"
             Height="130"> 
    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="70"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource DarkThemeDeviderField}">
            <TextBlock Name="SearchMessBlock" 
                       Text="Search messages in" 
                       VerticalAlignment="Center" Margin="10 0 0 0" 
                       Foreground="Gray" FontSize="18"/>
        </Grid>

        <Grid Grid.Row="1"
            Background="{StaticResource DarkThemeOne}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>

            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center"
                        Margin="10 10 0 10" Orientation="Horizontal">
                <Ellipse Name="UserEllipseImage" Grid.Column="0" Width="45" Height="45">
                    <Ellipse.Fill>
                        <ImageBrush x:Name="ImgBrush" ImageSource="/Visuals/Images/UserImages/Minato.jpg"/>
                    </Ellipse.Fill>
                </Ellipse>

                <TextBlock Name="ThisChatBlock" Foreground="Gray" VerticalAlignment="Center" 
                           Text="This chat" FontSize="16" Margin="10 0 0 0"/>
            </StackPanel>

            <Grid Grid.Column="1">
                <closeBut:IconButton HorizontalAlignment="Right" VerticalAlignment="Center"
                                     Width="30" Height="30" x:Name="CloseBut" Margin="0 10 10 0"
                                     PreviewMouseDown="CloseBut_PreviewMouseDown"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="2">

            <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Orientation="Vertical" 
                            Name="MessagesPanel">
                    
                </StackPanel>
            </ScrollViewer>
            
            <materialDesign:PackIcon Kind="Magnify" Width="100" Height="100"
                                     Name="MagnIcon" Visibility="Hidden"
                                     Foreground="Gray"
                                     VerticalAlignment="Center" 
                                     HorizontalAlignment="Center"/>
        </Grid>

    </Grid>
</UserControl>
