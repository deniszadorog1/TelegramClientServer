<UserControl x:Class="TelegramVisualPart.UserControls.UserChat"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls"
             mc:Ignorable="d" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:buts="clr-namespace:TelegramVisualPart.UserControls.ChatControls"
             xmlns:Emojis="clr-namespace:TelegramVisualPart.UserControls.ChatControls.Emojis"
             xmlns:iconBut="clr-namespace:TelegramVisualPart.UserControls.DifferButs"   
             d:DesignHeight="450" d:DesignWidth="800" 
             
             KeyDown="UserControl_KeyDown"
             >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" Name="UpperRow"/>
            <RowDefinition/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="0" Name="UserInfoColumn"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource DarkThemeOne}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="170"/>
            </Grid.ColumnDefinitions>
            <Grid Name="UserInforGrid" Grid.Column="0" HorizontalAlignment="Stretch" Margin="10 0 0 0"
                  MouseEnter="UserInforGrid_MouseEnter" MouseLeave="UserInforGrid_MouseLeave"
                  MouseDown="UserInforGrid_MouseDown" Background="Transparent" >
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" x:Name="ChatFriendLogin" Text="FriendLogin" 
                           FontSize="18"
                           HorizontalAlignment="Left" VerticalAlignment="Center" 
                           Foreground="{StaticResource UsualTextColor}"/>
                <TextBlock Grid.Row="1" x:Name="ChatFriendLastSeen" 
                           Text="Last seen time" FontSize="16"
                           HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="Gray"/>

            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="1"
                        MouseEnter="StackPanel_MouseEnter">
                <Grid Margin="5" Name="FindMessageBut" Background="Transparent"
                      PreviewMouseDown="FindMessage_PreviewMouseDown"
                      MouseEnter="FindMessageBut_MouseEnter"
                      MouseLeave="FindMessageBut_MouseLeave">
                    <materialDesign:PackIcon Kind="Magnify" Foreground="Gray"
                                         HorizontalAlignment="Center" Width="30" Height="30" 
                                         VerticalAlignment="Center" 
                                         Name="FindMessageIcon"/>
                </Grid>

                <Grid Margin="5" Name="UserInfoBut" Background="Transparent"
                      PreviewMouseDown="UserInfoBut_PreviewMouseDown"
                      MouseEnter="UserInfoBut_MouseEnter"
                      MouseLeave="UserInfoBut_MouseLeave">
                    <materialDesign:PackIcon Kind="PageLayoutSidebarRight" Foreground="Gray"
                                         HorizontalAlignment="Center" Width="30" Height="30" 
                                         VerticalAlignment="Center" Margin="5"
                                         Name="UserInfoIcon"/>
                </Grid>
                <Grid Margin="5 0 10 0" Name="UserChatMenuBut" Background="Transparent"
                      MouseDown="UserChatMenuBut_PreviewMouseDown"
                      MouseEnter="UserChatMenuBut_MouseEnter"
                      MouseLeave="UserChatMenuBut_MouseLeave">
                    <materialDesign:PackIcon Kind="DotsVerticalCircleOutline" Foreground="Gray"
                                         HorizontalAlignment="Center" Width="30" Height="30" 
                                         VerticalAlignment="Center" Margin="5 0 15 0"
                                         Name="UserChatMenuIcon"/>

                </Grid>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Name="ChatGrid" Background="{StaticResource DarkThemeSecond}" Margin="0 1 0 0">
            <Grid Name="CustomBg" Background="Transparent"/>
            <ListBox Background="Transparent" BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" Name="ChatBox"
                     VerticalAlignment="Bottom">
            </ListBox>
        </Grid>

        <Grid Grid.Row="2" Background="{StaticResource DarkThemeOne}" Margin="0 0 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="Transparent"
                    MouseEnter="AddFile_MouseEnter" MouseLeave="AddFile_MouseLeave"
                    PreviewMouseDown="AddFile_PreviewMouseDown">
                <materialDesign:PackIcon Kind="Paperclip" Margin="10 0 0 0" Name ="AddFile"
                                     Width="35" Height="35" VerticalAlignment="Center" Foreground="Gray"/>
            </Grid>


            <TextBox Grid.Column="1" x:Name="CommentTextBox" 
                     Background="{StaticResource DarkThemeOne}" Foreground="White" 
                     VerticalContentAlignment="Center" CaretBrush="White"
                     materialDesign:TextFieldAssist.UnderlineBrush="{StaticResource DarkThemeMouseEnterBut}" 
                     materialDesign:HintAssist.Hint="Enter message here..."  
                     BorderThickness="0" FontSize="16" />

            <Grid Grid.Column="2" Name="EmojisGrid" 
                  Background="Transparent"
                  MouseEnter="EmojisGrid_MouseEnter"
                  MouseLeave="EmojisGrid_MouseLeave">
                <materialDesign:PackIcon Kind="SmileyOutline" Name="Emojis" 
                                      Width="40" Height="40"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Center"
                                     Foreground="Gray"/>
            </Grid>

            <Emojis:FullVisualsBlock Grid.Column="2" x:Name="EmojisBoard"
                                     Panel.ZIndex="100" 
                                     Margin="-385 -370 0 0" Visibility="Hidden"
                                     MouseLeave="EmojisBoard_MouseLeave"/>
        </Grid>

        <buts:UserChatInfoMenu x:Name="UserChatMenu"
                Grid.Row="0" Grid.RowSpan="3"  
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Panel.ZIndex="100"
                Visibility="Hidden"/>

        <Grid Grid.Column="1" Grid.RowSpan="3" Name="ContactInfoGrid"/>
    </Grid>
</UserControl>
