<UserControl x:Class="TelegramVisualPart.UserControls.UserChat"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls"
             mc:Ignorable="d" 
         
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:buts="clr-namespace:TelegramVisualPart.UserControls.ChatControls"
             xmlns:Emojis="clr-namespace:TelegramVisualPart.UserControls.ChatControls.Emojis"
             xmlns:iconBut="clr-namespace:TelegramVisualPart.UserControls.DifferButs"   
             xmlns:sendMenu="clr-namespace:TelegramVisualPart.UserControls.ChatControls.ChatMessages"
             
             d:DesignHeight="450" d:DesignWidth="800" 
             
             PreviewKeyDown="UserControl_KeyDown"
             MouseLeave="UserControl_MouseLeave"
             PreviewMouseDown="UserControl_PreviewMouseDown"
             >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" Name="UpperRow"/>
            <RowDefinition Name="PinRow" Height="50"/>
            <RowDefinition/>
            <RowDefinition Name="ReplyMessageRow"  Height="50"/>
            <RowDefinition Height="50" Name="CommentRow"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="0" Name="UserInfoColumn"/>
        </Grid.ColumnDefinitions>

        <Grid Name="ChatterInfoGrid" Grid.Row="0" Visibility="Visible"
              Background="{StaticResource DarkThemeOne}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="UpperChatterImage" Width="75"/>
                <ColumnDefinition x:Name="BackButColumn" Width="0"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="170"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0"
                  MouseEnter="Grid_MouseEnter"
                  MouseLeave="Grid_MouseLeave">
                <Ellipse  Width="45"
                     Height="45" Margin="7 0 0 0 ">
                    <Ellipse.Fill>
                        <ImageBrush x:Name="UserImage" ImageSource="/Visuals/Images/UserImages/Minato.jpg"/>
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>

            <Grid Grid.Column="1" 
                  Background="Transparent"
                  Name="BackButGrid"
                  MouseEnter="Grid_MouseEnter"
                  MouseLeave="Grid_MouseLeave"
                  PreviewMouseDown="BackButGrid_PreviewMouseDown">
                <materialDesign:PackIcon Kind="ArrowLeft"
                                     Name="BackButIcon"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Center"
                                     Foreground="DarkGray"
                                     Width="25" Height="25"/>
            </Grid>

            <Grid Name="UserInforGrid" Grid.Column="2" HorizontalAlignment="Stretch" Margin="10 0 0 0"
                  MouseEnter="UserInforGrid_MouseEnter" MouseLeave="UserInforGrid_MouseLeave"
                  MouseDown="UserInforGrid_MouseDown" Background="Transparent" >
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"  
                           FontSize="18"
                           HorizontalAlignment="Left" VerticalAlignment="Center" 
                           Foreground="{StaticResource UsualTextColor}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap"
                           >
                    <Run x:Name="ChatFriendLogin" Text="Name"/>
                    <Run x:Name="ChatFriendSurname" Text="Surname"/>

                </TextBlock>

                <TextBlock Grid.Row="1" x:Name="ChatFriendLastSeen" 
                           Text="Last seen time" FontSize="16"
                           HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="Gray"/>

            </Grid>

            <Grid Grid.ColumnSpan="3" Name="SavedMessagesGrid"
                  Visibility="Hidden"
                  Background="{StaticResource DarkThemeOne}"
                  MouseEnter="SavedMessagesGrid_MouseEnter"
                  MouseLeave="SavedMessagesGrid_MouseLeave"
                  PreviewMouseLeftButtonDown="SavedMessagesGrid_PreviewMouseLeftButtonDown">
                <TextBlock Name="SavedMessagesBlock"
                           Foreground="White"
                           Text="Saved Messages"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="30 0 0 0">

                </TextBlock>
            </Grid>


            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Right" 
                        Grid.Column="3"
                        MouseEnter="StackPanel_MouseEnter">
                <Grid Margin="5" Name="FindMessageBut" 
                      Background="Transparent"
                      PreviewMouseDown="FindMessage_PreviewMouseDown"
                      MouseEnter="FindMessageBut_MouseEnter"
                      MouseLeave="FindMessageBut_MouseLeave">
                    <materialDesign:PackIcon Kind="Magnify" Foreground="Gray"
                                         HorizontalAlignment="Center" Width="30" Height="30" 
                                         VerticalAlignment="Center" 
                                         Name="FindMessageIcon"/>
                </Grid>

                <Grid Margin="5" Name="UserInfoBut" 
                      Background="Transparent"
                      PreviewMouseDown="UserInfoBut_PreviewMouseDown"
                      MouseEnter="UserInfoBut_MouseEnter"
                      MouseLeave="UserInfoBut_MouseLeave">
                    <materialDesign:PackIcon Kind="PageLayoutSidebarRight" Foreground="Gray"
                                         HorizontalAlignment="Center" Width="30" Height="30" 
                                         VerticalAlignment="Center" Margin="5"
                                         Name="UserInfoIcon"/>
                </Grid>
                <Grid Margin="5 0 10 0" 
                      Name="UserChatMenuBut" 
                      Background="Transparent"
                      MouseDown="UserChatMenuBut_PreviewMouseDown"
                      MouseEnter="UserChatMenuBut_MouseEnter"
                      MouseLeave="UserChatMenuBut_MouseLeave">
                    <materialDesign:PackIcon Kind="DotsVerticalCircleOutline" Foreground="Gray"
                                         HorizontalAlignment="Center" Width="30" Height="30" 
                                         VerticalAlignment="Center" Margin="5 0 15 0"
                                         Name="UserChatMenuIcon"/>
                </Grid>
            </StackPanel>

            <Grid Grid.Column="0" Grid.ColumnSpan="4" Name="SchedueleMessagesGrid"
                  Visibility="Hidden"
                  Background="{StaticResource DarkThemeOne}"
                  MouseEnter="SavedMessagesGrid_MouseEnter"
                  MouseLeave="SavedMessagesGrid_MouseLeave">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="75"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                
                <Grid Name="ArrowLeftSchedGrid"
                      Grid.Column="0" 
                      Background="Transparent"
                      MouseEnter="ArrowLeftSchedGrid_MouseEnter"
                      MouseLeave="ArrowLeftSchedGrid_MouseLeave"
                      PreviewMouseDown="ArrowLeftSchedGrid_PreviewMouseDown">
                    <materialDesign:PackIcon Name="ArrowLeftSchedIcon"
                                         Kind="ArrowLeft"
                                         VerticalAlignment="Center"
                                         HorizontalAlignment="Center"
                                         Width="35"
                                         Height="35"
                                         Foreground="Gray"/>
                </Grid>

                <TextBlock Name="ScheduleMessagesBlock" 
                           Grid.Column="1"
                           Foreground="White"
                           Text="Scheduled Messages"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0 0 0 0">

                </TextBlock>
            </Grid>

        </Grid>

        <Grid Name="OnlyPinnedHeaderGrid" Grid.Row="0" Visibility="Hidden"
              Background="{StaticResource DarkThemeOne}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="75"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Grid Name="BackToChatGrid" Grid.Column="0" 
                  Background="Transparent"
                  MouseEnter="BackToChatGrid_MouseEnter"
                  MouseLeave="BackToChatGrid_MouseLeave"
                  PreviewMouseDown="BackToChatGrid_PreviewMouseDown">
                <materialDesign:PackIcon Name="BackToChatIcon"
                                         Kind="ArrowLeft"
                                         VerticalAlignment="Center"
                                         HorizontalAlignment="Center"
                                         Width="35"
                                         Height="35"
                                         Foreground="Gray"/>
            </Grid>

            <TextBlock Name="AmountOfPinnedMessagesBlock" Grid.Column="1"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Foreground="{StaticResource UsualTextColor}"
                       Margin="10 0 0 0"
                       FontSize="20"
                       FontWeight="SemiBold">
                
                <Run Name="PinnedAmountRun" Text="9"/>
                <Run Name="PinnedSecRun" Text="pinned message"/>
            </TextBlock>
        </Grid>

        <Grid Name="SelectedMessesGrid" Grid.Row="0" Visibility="Hidden"
              Background="{StaticResource DarkThemeOne}">

            <StackPanel Name="SelectedMenu" 
                        Margin="10 0 0 0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">

                <Button Name="ForwardSelectedBut"
                        Padding="5 0 5 0"
                        Background="{StaticResource TempActiveTextColor}"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Click="ForwardSelectedBut_Click">
                    <TextBlock>
                        <Run Name="ForwardSelectedButText" Text="Forward"/>
                        <Run Name="ForwardSelectedAmount" Text="Amount"/>
                    </TextBlock>
                </Button>

                <Button Name="DeleteSelectedBut"
                        Padding="5 0 5 0"
                        Margin="10 0 0 0"
                        Background="{StaticResource TempActiveTextColor}"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Click="DeleteSelectedBut_Click">
                    <TextBlock>
                        <Run Name="DeleteSelectedButText" Text="Delete"/>
                        <Run Name="DeleteSelectedAmount" Text="Amount"/>
                    </TextBlock>
                </Button>
            </StackPanel>

            <Button Style="{StaticResource MaterialDesignRaisedButton}" Name="CancelBut"
                            Content="Cancel" Background="Transparent" BorderThickness="0"
                            HorizontalAlignment="Right" Margin="0 0 5 0" FontSize="16"
                            MouseEnter="CancelBut_MouseEnter"  MouseLeave="CancelBut_MouseLeave"
                            Foreground="{StaticResource TempActiveTextColor}"
                            Click="CancelBut_Click"/>
        </Grid>

        <Border Name="PinRowBorder" Grid.Row="1" 
                BorderThickness="0 1 0 1"
                BorderBrush="Black"
                Background="{StaticResource DarkThemeSecond}"
                MouseEnter="PinRowBorder_MouseEnter"
                MouseLeave="PinRowBorder_MouseLeave"
                PreviewMouseDown="PinRowBorder_PreviewMouseDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Image Name="PinnedImage"/>
                </Grid>

                <Border Background="{StaticResource TempActiveTextColor}" 
                        Grid.ColumnSpan="3" Opacity="0.1"/>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Name="PinMesNumber"
                               Grid.Row="0"
                               Text="Pinned message number"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Margin="5 0 0 0"
                               Foreground="{StaticResource TempActiveTextColor}"/>

                    <TextBlock Name="PinnedMessage"
                               Grid.Row="1"
                               Text="Pinned message"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Margin="5 0 0 0 "
                               Foreground="{StaticResource UsualTextColor}"/>
                </Grid>

                <Grid Grid.Column="2" Name="PinnedChatBut"
                      MouseEnter="PinnedChatBut_MouseEnter"
                      MouseLeave="PinnedChatBut_MouseLeave"
                      PreviewMouseDown="PinnedChatBut_PreviewMouseDown">
                    <materialDesign:PackIcon Kind="Pin"
                                             Foreground="White"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Center"
                                             Width="30" Height="30"/>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Name="ChatGrid" 
              Background="{StaticResource DarkThemeSecond}"
              MouseLeave="ClearStickerPanel_MouseLeave">
            <Grid Name="CustomBg" Background="Transparent"/>

            <Grid Margin="0 0 0 5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ChatColumn" />
                    <ColumnDefinition x:Name="SelectColumn" Width="0"/>
                </Grid.ColumnDefinitions>

                <ListBox Background="Transparent" 
                         BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" 
                         Name="ChatBox"
                         VerticalAlignment="Bottom"
                     
                         ScrollViewer.ScrollChanged="ChatBox_ScrollChanged"                  

                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         
                         ScrollViewer.PanningRatio="0.3" />

            </Grid>
        </Grid>
        <!--  VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Standard"
                     ScrollViewer.CanContentScroll="True"-->

        <Border Grid.Row="3" Name="ReplyBorder" Visibility="Visible"
                Background="{StaticResource DarkThemeSecond}"
                BorderThickness="1 1 0 0"
                BorderBrush="Black"
                MouseEnter="ReplyBorder_MouseEnter"
                MouseLeave="ReplyBorder_MouseLeave">
            <!--Reply message grid-->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Name="ReplyedImageColumn" Width="50"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="75"/>
                </Grid.ColumnDefinitions>

                <materialDesign:PackIcon Name="ReplyIcon"
                                         VerticalAlignment="Center"
                                         HorizontalAlignment="Center"
                                         Height="35" Width="35"
                                         Foreground="Gray"
                                         Kind="Reply"/>

                <!--Reply message image-->
                <Grid Grid.Column="1" Name="ReplyedImageGrid">
                    <Image Name="ReplyedImage" Margin="5 "/>
                </Grid>

                <!--Reply message params-->
                <Grid Grid.Column="2"
                      PreviewMouseLeftButtonDown="ReplyBorder_PreviewMouseLeftButtonDown">
                    
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Name="ReplySenderText" 
                               Text="ReplyedSender"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               VerticalAlignment="Center" Margin="5 5 0 0"
                               Foreground="{StaticResource TempActiveTextColor}"
                               FontWeight="SemiBold"/>

                    <TextBlock Grid.Row="1" Name="ReplyedMessageText" 
                               Text="ReplyedSender"
                               VerticalAlignment="Center" Margin="5 0 0 5"
                               Foreground="{StaticResource UsualTextColor}"/>
                </Grid>

                <Grid Grid.Column="3" Name="CloseReplyGrid"
                      Background="Transparent"
                      MouseEnter="CloseReplyGrid_MouseEnter"
                      MouseLeave="CloseReplyGrid_MouseLeave"
                      PreviewMouseDown="CloseReplyGrid_PreviewMouseDown">

                    <materialDesign:PackIcon Kind="Close"
                                             Name="CloseBut"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Center"
                                             Foreground="Gray"
                                             Width="30"
                                             Height="30"/>
                </Grid>
            </Grid>

        </Border>

        <Grid Grid.Row="4" Background="{StaticResource DarkThemeOne}" Margin="0 0 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="Transparent"
                  MouseEnter="AddFile_MouseEnter" 
                  MouseLeave="AddFile_MouseLeave"
                  PreviewMouseDown="AddFile_PreviewMouseDown">
                <materialDesign:PackIcon Kind="Paperclip" 
                                         Name ="AddFile"
                                         Margin="10 0 0 0" 
                                         Width="35" Height="35" 
                                         VerticalAlignment="Center" 
                                         Foreground="Gray"/>
            </Grid>

            <TextBox Grid.Column="1" x:Name="CommentTextBox" 
                     Background="{StaticResource DarkThemeOne}" 
                     Foreground="White" 
                     VerticalContentAlignment="Center" 
                     CaretBrush="White"
                     materialDesign:TextFieldAssist.UnderlineBrush="{StaticResource DarkThemeMouseEnterBut}" 
                     BorderThickness="0" 
                     FontSize="16" 
                     ContextMenuService.IsEnabled="False" 
                     TextChanged="CommentTextBox_TextChanged"
                     PreviewMouseRightButtonDown="CommentTextBox_PreviewMouseRightButtonDown"
                     LostFocus="CommentTextBox_LostFocus"
                     MaxLength="100"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal"
                        Margin="0 0 10 0"
                        HorizontalAlignment="Right">
                <Grid Name="AutoDelGrid"  
                      Margin="0 0 10 0"
                      HorizontalAlignment="Right"
                      Background="Transparent"
                      MouseEnter="AutoDelGrid_MouseEnter"
                      MouseLeave="AutoDelGrid_MouseLeave"
                      PreviewMouseDown="AutoDelGrid_PreviewMouseDown">
                    <materialDesign:PackIcon Kind="Fire" Name="AutoDelIcon" 
                                      Width="40" Height="40"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Center"
                                     Foreground="Gray"/>
                </Grid>

                <Grid Name="ScheduleMessageGrid"
                      Visibility="Visible"
                      HorizontalAlignment="Right"
                      Margin="0 0 10 0"
                      Background="Transparent"
                      MouseEnter="ScheduleMessageGrid_MouseEnter"
                      MouseLeave="ScheduleMessageGrid_MouseLeave"
                      PreviewMouseLeftButtonDown="ScheduleMessageGrid_PreviewMouseLeftButtonDown">
                    <materialDesign:PackIcon Kind="CalendarBlank" Name="ScheduleMessagesIcon" 
                                             Width="40" Height="40"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Center"
                                             Foreground="Gray"/>
                </Grid>
                
                <Grid Name="EmojisGrid" 
                      HorizontalAlignment="Right"
                      Margin="0 0 10 0"
                      Background="Transparent"
                      MouseEnter="EmojisGrid_MouseEnter"
                      MouseLeave="EmojisGrid_MouseLeave">
                    <materialDesign:PackIcon Kind="SmileyOutline" Name="Emojis" 
                                      Width="40" Height="40"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Center"
                                     Foreground="Gray"/>
                </Grid>

                <Grid Name="SendMessageGrid"
                      HorizontalAlignment="Right"
                      Background="Transparent"
                      MouseEnter="SendMessageGrid_MouseEnter"
                      MouseLeave="SendMessageGrid_MouseLeave"
                      PreviewMouseLeftButtonDown="SendMessageGrid_PreviewMouseDown"
                      PreviewMouseRightButtonDown="SendMessageGrid_PreviewMouseRightButtonDown">
                    <materialDesign:PackIcon Kind="Send" Name="SendIcon"
                                             Width="35"
                                             Height="35"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Center"
                                             Foreground="{StaticResource TempActiveTextColor}"/>
                </Grid>
                
            </StackPanel>

            <Emojis:FullVisualsBlock Grid.Column="2" x:Name="EmojisBoard"
                                     Panel.ZIndex="100" 
                                     Margin="-385 -370 0 0" Visibility="Hidden"
                                     MouseLeave="EmojisBoard_MouseLeave"/>
        </Grid>

        <Border Grid.Row="4" BorderThickness="0 1 0 0" BorderBrush="Black"
                Name="UnBlockBorder" Visibility="Hidden">
            <Grid  Background="{StaticResource DarkThemeSecond}"
              Name="UnblockGrid"
              MouseEnter="BottomGrid_MouseEnter"
              MouseLeave="BottomGrid_MouseLeave"
              PreviewMouseDown="UnblockGrid_PreviewMouseDown">
                <TextBlock VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Name="UnblockBlock"
                       Text="Unblock"
                       FontSize="22"
                       Foreground="Red"
                       FontWeight="SemiBold"/>
            </Grid>
        </Border>

        <Border Grid.Row="4" BorderThickness="0 2 0 0" BorderBrush="Black"
                Name="UnPinAllBorder" Visibility="Hidden">
            <Grid Grid.Row="4" Name="UnPinAlGrid"
                  Background="{StaticResource DarkThemeOne}"
                  MouseEnter="BottomGrid_MouseEnter"
                  MouseLeave="BottomGrid_MouseLeave"
                  PreviewMouseDown="UnPinAlGrid_PreviewMouseDown">

                <TextBlock Text="Unpin all messages"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource TempActiveTextColor}"
                       FontSize="18"
                       FontWeight="SemiBold"/>

            </Grid>
        </Border>

        <buts:UserChatInfoMenu x:Name="UserChatMenu"
                Grid.Row="0" Grid.RowSpan="4"  
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Panel.ZIndex="100"
                Visibility="Hidden"/>

        <sendMenu:SendMessageMenu x:Name="SendMesMenu"
                                  Grid.Row="0" Grid.RowSpan="5" 
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Bottom"
                                  Panel.ZIndex="100"
                                  Margin="40"
                                  Visibility="Hidden"/>

        <Canvas Name="MessageMenu"
              Grid.RowSpan="4" 
              Grid.ColumnSpan="2" Margin="10,0,-10,0">

        </Canvas>

        <Grid Grid.Column="1" Grid.RowSpan="5" Name="ContactInfoGrid"/>
    </Grid>
</UserControl>
