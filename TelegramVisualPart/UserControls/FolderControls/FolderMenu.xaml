<UserControl x:Class="TelegramVisualPart.UserControls.FolderControls.FolderMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls.FolderControls"
             xmlns:But="clr-namespace:TelegramVisualPart.UserControls.ChatControls.MediaActions"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="200" 
             Width="200">
    <Border Name="MenuBorder" CornerRadius="5" 
            BorderThickness="1" BorderBrush="Black">
        <StackPanel Name="MenuStack" Orientation="Vertical">
            <But:ActionMenuButton x:Name="EditFolderBut" PreviewMouseDown="But_PreviewMouseDown"/>
            <But:ActionMenuButton x:Name="RemoveBut" PreviewMouseDown="But_PreviewMouseDown"/>
            
            <But:ActionMenuButton x:Name="EditAllFolders" 
                                  PreviewMouseDown="But_PreviewMouseDown" Height="0"/>
        </StackPanel>
    </Border>
</UserControl>
