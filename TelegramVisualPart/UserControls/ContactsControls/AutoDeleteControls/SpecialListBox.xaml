<UserControl x:Class="TelegramVisualPart.UserControls.ContactsControls.AutoDeleteControls.SpecialListBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls.ContactsControls.AutoDeleteControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <ScrollViewer PreviewMouseWheel="ScrollViewer_PreviewMouseWheel"
                      Loaded="ScrollViewer_Loaded" x:Name="ScrollView"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center"
                      Width="150"
                      Height="200"
                      VerticalScrollBarVisibility="Hidden">
            <StackPanel x:Name="CheckPanel">

            </StackPanel>
        </ScrollViewer>
        
        <Grid VerticalAlignment="Center" Height="40" IsHitTestVisible="False">
            <Rectangle Fill="{StaticResource TempActiveTextColor}" Height="2" VerticalAlignment="Top" Margin="10,0"/>
            <Rectangle Fill="{StaticResource TempActiveTextColor}" Height="2" VerticalAlignment="Bottom" Margin="10,0"/>
        </Grid>
    </Grid>
</UserControl>
