<UserControl x:Class="TelegramVisualPart.UserControls.ContactsControls.AutoDeleteControls.RadioBut"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls.ContactsControls.AutoDeleteControls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"    
             mc:Ignorable="d" 
             d:DesignHeight="150" d:DesignWidth="800"
             
             MouseEnter="UserControl_MouseEnter"
             MouseLeave="UserControl_MouseLeave"
             MouseDown="UserControl_PreviewMouseDown">
    <Grid>
        <TextBlock Name="ButName" Text="There gona be text name" VerticalAlignment="Center"
                   HorizontalAlignment="Left" Foreground="White" FontSize="15"/>

        <RadioButton Name="RadioButton" 
                     HorizontalAlignment="Right" VerticalAlignment="Center" 
                     Background="{StaticResource TempActiveTextColor}" 
                     IsChecked="False" 
                     materialDesign:RadioButtonAssist.RadioButtonSize="25"/>
    </Grid>
</UserControl>
