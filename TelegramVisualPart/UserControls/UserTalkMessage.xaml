<UserControl x:Class="TelegramVisualPart.UserControls.UserTalkMessage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="60" d:DesignWidth="700">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Ellipse Name="UserEllipseImage" Grid.Column="0" Width="55" Height="55">
            <Ellipse.Fill>
                <ImageBrush x:Name="ImageIcon" ImageSource="/Visuals/Images/UserImages/Minato.jpg"/>
            </Ellipse.Fill>
        </Ellipse>

        <Grid Grid.Column="1" Name="InfoGrid">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock x:Name="FriendLogin" HorizontalAlignment="Left" VerticalAlignment="Center" 
                           Text="UserLogin" Margin="10 0 0 0" Foreground="{StaticResource UsualTextColor}" 
                           FontSize="16"/>
                <TextBlock x:Name="LastMessageTime" HorizontalAlignment="Right" VerticalAlignment="Center" 
                           Text="mestime" Margin="10 5 25 5" Foreground="Gray" FontSize="16"/>
            </Grid>

            <TextBlock Grid.Row="1" Name="LastMessage" Foreground="Gray" 
                       HorizontalAlignment="Left" VerticalAlignment="Center"
                       Margin="10 0 0 0" FontSize="16"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap"
                       Text="osgibdfkvcmwosfgttgdkgmcvwpeorlsgfkdpwersdsdfvftgtg"/>

            <Grid Grid.Row="1" HorizontalAlignment="Right"
                  Margin="0 0 25 5">

                <materialDesign:PackIcon Kind="PinOutline" Name="PinBlock"
                                         Visibility="Hidden"
                                         Width="20" Height="20"
                                         Foreground="Gray"/>

                <Ellipse Name="UnreadEllipse" Visibility="Hidden"
                         Width="20" Height="20"
                    Fill="{StaticResource TempActiveTextColor}">

                </Ellipse>

                <Border Background="Gray" CornerRadius="10"
                        Name="UnredCountBorder" Visibility="Hidden">
                    <TextBlock Name="MesCounter" Text="0"
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                </Border>
                
            </Grid>
            
        </Grid>

    </Grid>
</UserControl>
