<UserControl x:Class="TelegramVisualPart.UserControls.ChatsControls.UserChatMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls.ChatsControls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="300"
             
             Background="{StaticResource DarkThemeOne}">

    <Border CornerRadius="5"  BorderBrush="Black"
             BorderThickness="2">
        <Grid>

            <StackPanel Name ="MainPanel">
                <local:UserChatsMenuElement x:Name="OpenNewWindow"/>
                <local:UserChatsMenuElement x:Name="Archive"/>
                <local:UserChatsMenuElement x:Name="Unpin"/>

                <local:UserChatsMenuElement x:Name="MuteNotifs" 
                                    MouseEnter="AddSubMenu_MouseEnter"/>

                <local:UserChatsMenuElement x:Name="MarkRead"/>


                <local:UserChatsMenuElement x:Name="AddToFolder"
                                    MouseEnter="AddSubMenu_MouseEnter"/>


                <local:UserChatsMenuElement x:Name="LeaveChannel"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
