<UserControl x:Class="TelegramVisualPart.UserControls.ChatsControls.UserChatsMenuElement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls.ChatsControls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="250"
             Height="40" Width="250"
             Background="Transparent"
             MouseEnter="UserControl_MouseEnter" 
             MouseLeave="UserControl_MouseLeave">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="45"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="35"/>
        </Grid.ColumnDefinitions>

        <materialDesign:PackIcon Width="25" Height="25"
                                 Grid.Column="0"
                                 Name="IconElement"
                                 Kind="GuyFawkesMask"
                                 Foreground="White"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Center"/>

        <TextBlock Name="TextElement"
                   Grid.Column="1"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Left"
                   Foreground="White"
                   FontSize="17"/>

        <materialDesign:PackIcon Width="25" Height="25"
                                 Grid.Column="2"
                                 Name="ArrowRightIcon"
                                 Kind="KeyboardArrowRight"
                                 Foreground="White"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Center"/>

    </Grid>
</UserControl>
