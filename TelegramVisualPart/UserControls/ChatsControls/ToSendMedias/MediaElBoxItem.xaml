<UserControl x:Class="TelegramVisualPart.UserControls.ChatsControls.ToSendMedias.MediaElBoxItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TelegramVisualPart.UserControls.ChatsControls.ToSendMedias"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="170" d:DesignWidth="285">

    <Border Background="{StaticResource DarkThemeSecond}"
            CornerRadius="10">
        <Grid>
            <Image Name="Img" Stretch="Uniform"/>

            <StackPanel Name="ButsPanel" 
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Margin="10">

                <Grid x:Name="ChangeMediaGrid"
                  Background="Transparent"
                  MouseEnter="GridBut_MouseEnter"
                  MouseLeave="GridBut_MouseLeave"
                      PreviewMouseDown="ChangeImage_PreviewMouseDown">
                    <materialDesign:PackIcon Name="Change"
                                     Kind="Rotate360"
                                     Width="25" Height="25" Margin="5 0 5 0"
                                     Foreground="{StaticResource UsualTextColor}"/>
                </Grid>

                <Grid x:Name="DeleteMediaGrid"
                  Background="Transparent"
                  MouseEnter="GridBut_MouseEnter"
                  MouseLeave="GridBut_MouseLeave"
                      PreviewMouseDown="DeleteMedia_PreviewMouseDown">
                    <materialDesign:PackIcon Name="BucketBut" Kind="GarbageCan"
                                     Width="25" Height="25"
                                     Foreground="{StaticResource UsualTextColor}"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
